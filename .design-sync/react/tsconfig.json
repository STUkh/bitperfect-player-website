{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmitOnError": false,
    "outDir": "dist/types",
    "rootDir": "../..",
    "baseUrl": ".",
    "types": [
      "react"
    ],
    "paths": {
      "@site/*": [
        "../../src/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "src/env.d.ts",
    "../../src/types/**/*.d.ts"
  ]
}
