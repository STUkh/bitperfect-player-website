{
  "projectId": "f66ddeb0-9078-4f89-b40d-798889761fff",
  "shape": "package",
  "pkg": "@bitperfect/website-ds",
  "globalName": "BitperfectPlayer",
  "buildCmd": "node .design-sync/sync.mjs",
  "cssEntry": "dist/site.css",
  "guidelinesGlob": [
    "../../DESIGN.md"
