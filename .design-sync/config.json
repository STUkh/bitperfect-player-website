      "viewport": "1280x900"
    },
    "ClosingBanner": {
      "cardMode": "column",
      "viewport": "1280x900"
    },
    "LegalDocument": {
      "cardMode": "column",
      "viewport": "1280x900"
    },
    "StatementBand": {
      "cardMode": "column",
      "viewport": "1280x900"
    },
    "FeaturesTeaser": {
      "cardMode": "column",
      "viewport": "1280x1200"
