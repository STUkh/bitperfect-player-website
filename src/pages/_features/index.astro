---
/**
 * The features index: the technical home of the site.
 *
 * Six hairline separated editorial rows on a 5:7 split, not a tiled grid of
 * cards. Each row carries its mark, one paragraph, three facts and its route
 * path in mono. Colour tells nothing apart here: the mark
 * number and the mark do, and the only accent on the page is gold.
 *
 * The row copy is transcribed from design/FeaturesIndex.dc.html, which is the
 * approved short form for this page. The long form lives on each route, in
 * `src/components/feature/content.ts`.
 */
import ContentLayout from '../../layouts/ContentLayout.astro';
import Container from '../../components/common/Container';
import PlayCta from '../../components/common/PlayCta';
import FeatureArt from '../../components/feature/FeatureArt';
import { indexOrder } from '../../components/feature/content';
import { site, compatibility } from '../../data/site';
import { faqItems } from '../../data/faq';
import { withBase } from '../../utils/nav';
import { featureName } from '../../data/navigation';

/* Taglines only. The row's NAME comes from `featureName()`, so this page cannot
   call a route something the nav that points at it does not. */
const ROWS: Record<(typeof indexOrder)[number], { tagline: string }> = {
  'usb-dac': { tagline: 'The file reaches your DAC exactly as recorded' },
  eq: { tagline: 'Precise tone control, off again in one tap' },
  library: { tagline: 'Every album found instantly, without leaving the phone' },
  casting: { tagline: 'Cast to any speaker, or receive from another device' },
  dsp: { tagline: 'Crossfeed, loudness matching and clip protection, all switchable' },
  'ai-enhancer': { tagline: 'Recovers detail compression removed, right on the phone' },
};

const order = [...indexOrder];
---

<ContentLayout
  title="Features"
  description="Six things shipping today: bit-perfect USB DAC output, a 32-band EQ, hi-res and DSD support, UPnP casting, DSP tools and on-device AI restoration."
>
  {/* ── Page header ──
      One directional gradient on the section itself. No orbs, no halos. */}
  <section
    class="relative bg-[radial-gradient(ellipse_120%_78%_at_50%_-10%,rgba(255,255,255,0.035)_0%,rgba(255,255,255,0.012)_42%,transparent_72%)] pt-7 pb-12 lg:pt-11 lg:pb-20"
  >
    <Container className="lg:px-20">
      <div class="grid grid-cols-1 items-end gap-9 lg:grid-cols-12 lg:gap-12">
        {/*
          No eyebrow. `Features` above `Six features that put you in control of
          your sound`, on the page whose route is `/features` and whose nav item is
          lit, is the fourth time the visitor is told where they are. That left this
          page at three eyebrows over four sections against a budget of two; `What
          is not here` and `Questions` both name something the heading below them
          does not, so this is the one that goes. DESIGN.md, "The Eyebrow Budget
          Rule".
        */}
        <div class="lg:col-span-8">
          <h1 class="text-headline-xl-m text-balance text-text-primary lg:text-headline-xl">
            Six features that put you in control of your sound
          </h1>
          <p class="mt-5 max-w-[56ch] text-body text-pretty text-text-secondary lg:mt-[26px] lg:text-body-lg">
            All six are shipping today. Each has its own page with the numbers behind it.
          </p>
        </div>

        {/*
          This card read "Prompt-driven playlists and semantic search stay off the
          site until they ship", which is a note to whoever writes the next section
          and does two things wrong on a public page: it spends the best real
          estate above the fold on internal process, and it NAMES the two
          unreleased features that PRODUCT.md says must never be mentioned here.
          The claim underneath was worth keeping. The audience was wrong.
        */}
        {/*
          NOT a card any more. This was `glass rounded-card` — the exact chassis
          of the six feature cards forty pixels below it — so the page opened with
          a seventh card that had wandered up into the header and carried no art,
          no number and no link. A hairline and space say the same thing without
          claiming to be one of the six. It is also the site's own idiom: the
          statement, privacy and specification bands all separate on hairlines.
        */}
        <aside class="flex flex-col gap-3.5 border-t border-border-subtle pt-6 lg:col-span-4 lg:pt-7">
          <span class="text-eyebrow text-text-tertiary">Nothing to wait for</span>
          <p class="m-0 text-small text-pretty text-text-secondary">
            Every feature on this page is already in the app on Google Play. None of it is a roadmap item, a
            beta or a preview, and no number on any of these pages is a projection.
          </p>
        </aside>
      </div>
    </Container>
  </section>

  {/* ── The six cards: two columns, three rows, art over every one ──
      Six full-width rows of body copy is a table of contents, not a page. It is
      now a 2x3 grid where the top of every card is a drawn plate, and the plate
      carries the one number the feature is actually about: 768 kHz, 32 bands, 12
      formats, 4 protocols, 64-bit, 16 kHz and up. Once the number is in the art
      the card needs a name and one line under it, so the body paragraph and the
      three mono facts are gone. That is the trade: the art talks, the type stops
      repeating it.

      The grid recalculates rather than reflows. `minmax(0, 1fr)` twice from `md`
      and one column below it, and the plate is an `aspect-ratio` box holding an
      SVG on `preserveAspectRatio="xMidYMid slice"`, so the drawing re-fits the
      frame at any width instead of scaling a fixed picture. The subject is inside
      the middle 78% of the stage, which is what lets it crop safely from 21:9 down
      to 4:3.

      The plate goes WIDER as the grid gets narrower: one column at 4:3 would waste
      half the plate on empty ground, so the single-column layout takes 21:9. */}
  <section class="relative pb-14 lg:pb-[110px]" aria-labelledby="features-heading">
    <h2 id="features-heading" class="sr-only">All features</h2>
    <Container className="lg:px-20">
      {/*
        Two columns only from `lg`. At `md` the two columns are 342px each, the
        title wraps to two lines, and the plate falls to 52% of the card — under
        the floor of every reference. One wide column at that width puts it back
        near 78%.

        Gaps are ANISOTROPIC. With two wide columns and three rows, equal gaps
        make the rows read tighter than the columns; Apple runs 20/40 and Modal
        32/48 for the same reason.

        The plate's aspect follows the CARD's width, not the viewport's. A narrow
        card (one column on a phone) needs a TALLER plate or the art is a letterbox
        strip over two lines of wrapped title: 4/3. A wide card — one column on a
        tablet, or either column at `lg` — needs 16/9, because 4/3 on a 704px card
        is a 528px plate and the numeral inside it renders at 152px.
      */}
      <div class="grid grid-cols-1 gap-x-7 gap-y-6 [--art-ratio:4/3] sm:[--art-ratio:16/9] lg:grid-cols-2 lg:gap-y-10">
        {
          order.map((slug, i) => {
            const row = ROWS[slug];
            return (
              <a
                href={withBase(`features/${slug}`)}
                class="feature-card r-rise focus-visible:focus-ring group relative flex cursor-pointer flex-col rounded-card-inner bg-glass-surface lg:rounded-card"
                style={`--i: ${i % 2}`}
              >
                {/* The plate keeps the 16:9 its drawings are composed for. A wider
                    frame crops a stage built at 640x360 top and bottom, which takes
                    the horizon every plate stands on with it.

                    The dissolve belongs to the PLATE, not to the card: anchored to
                    the plate's own bottom edge and only a third of its height, so
                    the drawing meets the type without a seam. Hung on the card it
                    covered the upper 62% of the whole thing and washed the art out. */}
                <div class="art-clip relative">
                  <FeatureArt slug={slug} className="art w-full" compactBelowSm />
                  {/* Two axes, not one. A bottom-only fade leaves the left and
                      right edges hard, and hard edges are exactly where six
                      different drawings fail to agree with each other. Linear
                      runs the same pair and takes the bottom one to 70% of the
                      art height, not a third; it also strengthens the fade on a
                      phone, where the plate is smaller and the type sits closer. */}
                  <span class="art-scrim pointer-events-none absolute inset-0" aria-hidden="true" />
                </div>

                <div class="relative flex flex-1 flex-col px-6 pt-5 pb-6 lg:px-9 lg:pt-6 lg:pb-8">
                  <h3 class="text-title-lg text-balance text-text-primary lg:text-section-sm">
                    {featureName(slug)}
                  </h3>
                  <p class="mt-2.5 text-body-sm text-pretty text-text-tertiary transition-colors duration-[var(--d-ui)] ease-ui group-hover:text-text-secondary lg:mt-3 lg:text-body-lg">
                    {row.tagline}
                  </p>
                </div>

                {/* The hairline rides on its own layer over the plate, so it is a
                    continuous edge rather than a border the art paints over. */}
                <span
                  class="pointer-events-none absolute inset-0 rounded-card-inner border border-border-subtle transition-colors duration-[var(--d-ui)] ease-ui group-hover:border-glass-border-hover lg:rounded-card"
                  aria-hidden="true"
                />
              </a>
            );
          })
        }
      </div>
    </Container>
  </section>

  {/* ── Will it run on your phone ──
      This data has existed in `src/data/site.ts` since the rewrite and rendered
      on NO page: three rows naming exactly which phones get the engine and which
      get the AI Enhancer. It is the question a buyer asks before a $35 purchase
      of a LOCAL FILE PLAYER, and the site could not answer it.

      No eyebrow: this page is at its budget of two already, and the heading is a
      question, which needs no label above it telling you it is one.
      DESIGN.md, "The Eyebrow Budget Rule".

      Hairlines and space, no cards. The six cards above are the card moment on
      this page; a second grid of boxes underneath would flatten both. */}
  {/* IVORY, and the questions below it graphite: the two were the other way
      round, which put the page header, the six cards and this band together as
      THREE consecutive graphite sections. DESIGN.md: never run three graphite
      sections together. The swap also lands the right content on the loud band —
      "will it run on my phone" is the question that gates the purchase, and it
      was set on the quiet ground while the FAQ had the white. */}
  <section id="compatibility" class="scroll-mt-24 bg-band-ivory pt-12 pb-14 lg:pt-24 lg:pb-26">
    <Container className="lg:px-20">
      <div class="grid grid-cols-1 items-start gap-9 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <h2 class="text-section-sm text-balance text-band-ink lg:text-section-lg">
            Will it run on your phone?
          </h2>
          <p class="mt-4 max-w-[34ch] text-body text-pretty text-band-ink-muted lg:mt-5">
            Playback runs on every phone the app installs on. One feature needs hardware some
            phones don't have, and the app checks before it turns it on.
          </p>
        </div>

        <div class="flex flex-col lg:col-span-8">
          {
            compatibility.map((row, i, all) => (
              <div
                class:list={[
                  'grid grid-cols-1 gap-2 border-t border-band-rule py-6 lg:grid-cols-[1fr_1fr] lg:gap-10 lg:py-7',
                  i === all.length - 1 && 'border-b',
                ]}
              >
                <div>
                  <h3 class="text-body-lg font-semibold tracking-[-0.01em] text-band-ink lg:text-title-sm">
                    {row.what}
                  </h3>
                  <p class="mt-1.5 text-caption text-pretty text-band-ink-muted lg:text-small">
                    {row.scope}
                  </p>
                </div>
                <div>
                  {/* The answer, set as the answer. Everything else on the row
                      qualifies it. */}
                  <p class="text-body-sm font-semibold text-pretty text-band-ink lg:text-body">
                    {row.devices}
                  </p>
                  <p class="mt-2 max-w-[52ch] text-caption leading-[1.62] text-pretty text-band-ink-muted lg:text-small">
                    {row.note}
                  </p>
                </div>
              </div>
            ))
          }
          <p class="mt-6 text-caption text-band-ink-muted">
            Android {site.minAndroid} or newer.
          </p>
        </div>
      </div>
    </Container>
  </section>

  {/* ── The questions, on graphite ──
      Hairlines and space, the same as the band above it. See the note on the
      compatibility band for why these two swapped grounds. */}
  <section class="bg-surface-base py-14 lg:pt-26 lg:pb-[110px]">
    <Container className="lg:px-20">
      <div class="grid grid-cols-1 items-start gap-9 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <span class="text-eyebrow block text-text-tertiary">Questions</span>
          <h2 class="mt-4 text-section-sm text-balance text-text-primary lg:mt-5 lg:text-section-lg">
            The ones people actually ask
          </h2>
        </div>

        <div class="flex flex-col lg:col-span-8">
          {
            faqItems.map((item, i, all) => (
              <div
                class:list={[
                  'border-t border-border-subtle py-6 lg:py-7',
                  i === all.length - 1 && 'border-b',
                ]}
              >
                {/* Ink, not gold. Nine 21px gold headings stacked in one column
                    is gold setting body copy, and every one of them looked like a
                    link. DESIGN.md, "The Gold Hierarchy Rule". */}
                <h3 class="text-body-lg font-semibold text-text-primary lg:text-title-sm">{item.q}</h3>
                <p class="mt-3 max-w-[72ch] text-body-sm text-pretty text-text-secondary">{item.a}</p>
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  {/* ── Closing action ── */}
  <section
    class="relative bg-[linear-gradient(to_top,rgba(255,179,71,0.13)_0%,rgba(232,184,75,0.05)_22%,transparent_46%)] pt-14 pb-16 lg:pt-25 lg:pb-26"
  >
    <Container className="lg:px-20">
      <div class="flex flex-col items-center text-center">
        <h2 class="r-rise max-w-[20ch] text-headline-sm-m text-balance text-text-primary lg:text-headline-sm">
          Six features, and none of them costs extra.
        </h2>
        <p class="r-rise mt-4 max-w-[51ch] text-body text-pretty text-text-secondary lg:mt-[22px] lg:text-body-lg" style="--i: 1">
          There is no higher tier to buy and nothing on this page is withheld for one.
        </p>
        <PlayCta
          label="Get it on Google Play"
          size="lg"
          className="r-rise mt-6 w-full lg:mt-8 lg:w-auto"
          style="--i: 2"
        />
      </div>
    </Container>
  </section>
</ContentLayout>

<style>
  /*
    The plate is clipped 1px INSIDE the card's radius rather than by
    `overflow: hidden`. Apple does the same thing on its product tiles
    (`isolation: isolate; clip-path: inset(1px round var(--sk-tile-border-radius))`)
    and the reason is visible on exactly this palette: gold art meeting a dark card
    corner under plain `overflow: hidden` leaves an aliased seam on the arc.
  */
  .art-clip {
    isolation: isolate;
    clip-path: inset(0 round 18px 18px 0 0);
  }
  @media (min-width: 1024px) {
    .art-clip {
      clip-path: inset(1px 1px 0 1px round 23px 23px 0 0);
    }
  }

  /*
    Two axes. A bottom-only fade leaves the left and right edges hard, which is
    where six different drawings visibly fail to agree with each other. The bottom
    ramp runs to 68% of the plate height, not a third: a shallow fade reads as a
    band across the art rather than as the art settling into the card.

    Stronger on a phone, where the plate is smaller and the title sits closer to it.
  */
  .art-scrim {
    background:
      linear-gradient(-90deg, var(--color-glass-surface) 6%, transparent 46%),
      linear-gradient(0deg, var(--color-glass-surface) 14%, transparent 62%);
  }
  @media (min-width: 1024px) {
    .art-scrim {
      background:
        linear-gradient(-90deg, var(--color-glass-surface) 4%, transparent 38%),
        linear-gradient(0deg, var(--color-glass-surface) 12%, transparent 68%);
    }
  }

  /* Interaction feedback runs on the UI curve, never the reveal curve. */
  .row-link {
    transition: color var(--d-ui) var(--ease-ui);
  }
  .row-link :global(.row-link-arrow) {
    transition: transform var(--d-ui) var(--ease-ui);
  }
  .row-link:hover :global(.row-link-arrow) {
    transform: translateX(2px);
  }
  .row-link:active :global(.row-link-arrow) {
    transform: translateX(0);
  }

  /* The Reduced Motion Rule: the colour change carries the hover on its own. */
  @media (prefers-reduced-motion: reduce) {
    .row-link:hover :global(.row-link-arrow),
    .row-link:active :global(.row-link-arrow) {
      transform: none;
    }
  }
</style>
