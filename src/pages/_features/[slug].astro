---
/**
 * The six feature routes, built on alternating bands.
 *
 * Structure, matching design/Feature*.dc.html and DESIGN.md's Layout section:
 * a header carrying the headline, the lede and a four row summary; the signal
 * path ledger on the one route that argues about the path; the four beats, each
 * its own full-width band; the white specification band; the prev and next pair;
 * and the closing action.
 *
 * The beats used to be a sticky phone rail: one device pinned beside four blocks
 * of prose that crossfaded its screen. It gave the page a single visual event and
 * then asked the reader to work through four blocks of text beside something that
 * had stopped moving. Each beat is now its own band, dark with the screen left
 * then white with the screen right, so the ground colour changes as often as the
 * argument does. DESIGN.md, "The alternating band (feature routes)", carries the
 * three rules that keep it from reading as stripes.
 *
 * One accent, gold. The routes are told apart by their content, never by hue. The
 * only other colours on the page are the five signal telemetry states, and only
 * where the page is reporting a real runtime state of the app.
 *
 * Nothing on a feature route pins. The one pinned moment on the site is the home
 * page's phone showcase.
 */
import ContentLayout from '../../layouts/ContentLayout.astro';
import Container from '../../components/common/Container';
import ImageSlot from '../../components/common/ImageSlot.astro';
import FeatureMark from '../../components/feature/FeatureMark.astro';
import FeatureScreens from '../../components/feature/FeatureScreens';
import { featurePages, indexOrder } from '../../components/feature/content';
import { getFeatureBySlug } from '../../data/features';
import { signalStateColors, signalStateKeys } from '../../data/colors';
import { site } from '../../data/site';
import { withBase } from '../../utils/nav';
import { featureName } from '../../data/navigation';

export function getStaticPaths() {
  const order = [...indexOrder];
  return order.map((slug, index) => ({
    params: { slug },
    props: {
      slug,
      index,
      prevSlug: order[(index - 1 + order.length) % order.length],
      nextSlug: order[(index + 1) % order.length],
    },
  }));
}

interface Props {
  slug: string;
  index: number;
  prevSlug: string;
  nextSlug: string;
}

const { slug, prevSlug, nextSlug } = Astro.props;

const page = featurePages[slug];
const feature = getFeatureBySlug(slug);
/* The name on the trail, the h1 and both pagers is the same string the visitor
   clicked to get here. See `featureRoutes` in src/data/navigation.ts. */
const name = featureName(slug);

/**
 * The signal path, drawn to scale.
 *
 * Three versions of this block have now failed for the same underlying reason:
 * they described the loss in words and left the reader to picture it. Two rails
 * with dots read as a wireframe. The spec ledger that replaced it was honest but
 * it was ELEVEN ROWS OF 13px MONO, and small dense type is what cheap technical
 * pages look like however accurate it is.
 *
 * What none of them ever did was SHOW the loss, so this one draws it. Every stage
 * is a bar whose height is the data rate actually surviving at that point, as a
 * fraction of what came in:
 *
 *     192 kHz x 24 bit = 4608 units   1.000   the file
 *      48 kHz x 24 bit = 1152 units   0.250   after the mixer
 *      48 kHz x 16 bit =  768 units   0.167   after the HAL
 *
 * So Android's row collapses to a quarter of its height at the mixer and to a
 * sixth at the HAL, in view, to scale, with nothing to read. The heights are
 * computed from `khz` and `bits` below rather than typed, so they cannot drift
 * from the numbers the page states.
 *
 * Both rows sit on the SAME seven-column grid and our row fills four of them. The
 * empty three columns are the argument, and they need no label now that the bars
 * make the row's end obvious.
 *
 * Android's 48 kHz / 16-bit ceiling is the claim the page lede already makes.
 */
const SIGNAL_PATH = {
  android: [
    { name: 'Source', khz: 192, bits: 24 },
    { name: 'Handoff', khz: 192, bits: 24 },
    { name: 'Capped', khz: 48, bits: 24, changed: true },
    { name: 'Held', khz: 48, bits: 24 },
    { name: 'Levelled', khz: 48, bits: 24 },
    { name: 'Cut', khz: 48, bits: 16, changed: true },
    { name: 'DAC', khz: 48, bits: 16 },
  ],
  ours: [
    { name: 'Source file', khz: 192, bits: 24 },
    { name: 'Direct engine', khz: 192, bits: 24 },
    { name: 'Exclusive USB', khz: 192, bits: 24 },
    { name: 'Hardware DAC', khz: 192, bits: 24 },
  ],
  note: 'That reading is for a connection the app actually owns. Where an exclusive lock is not achievable, the badge says what is really happening instead of claiming one it does not have.',
};

/**
 * TWO bars a stage, not one.
 *
 * The first cut drew a single bar per stage whose height was the whole data rate,
 * `khz * bits` as a fraction of the incoming 4608 units. The arithmetic was right
 * and the drawing was wrong, for two reasons.
 *
 * It collapsed two DIFFERENT losses into one scalar. The Mixer throws away
 * everything above 24 kHz; the HAL throws away 8 bits of amplitude resolution and
 * lifts the noise floor. Those are unrelated crimes and one height cannot tell
 * them apart. And on a 148px rail the second loss was a 12px delta from the first
 * (37px against 25px), which nobody reads as a step at all.
 *
 * Split, each stage shows the rate at 192 or 48 and the depth at 24 or 16, so the
 * Mixer visibly cuts one bar and the HAL visibly cuts the other, and the reader
 * sees two separate things being taken rather than one thing shrinking twice.
 */
const RATE_MAX = 192;
const DEPTH_MAX = 24;
const RAIL = 148;
const ratePct = (st: { khz: number }) => (st.khz / RATE_MAX) * 100;
const depthPct = (st: { bits: number }) => (st.bits / DEPTH_MAX) * 100;

const ROWS = [
  {
    key: 'android',
    label: 'Android',
    stages: SIGNAL_PATH.android,
    outcome: ['48 kHz', '16 bit'],
    tone: 'lost',
  },
  {
    key: 'ours',
    label: 'Bitperfect Player',
    stages: SIGNAL_PATH.ours,
    outcome: ['192 kHz', '24 bit'],
    tone: 'kept',
  },
] as const;

const showSignalPath = slug === 'usb-dac';

---

<ContentLayout title={name} description={page.lede}>
  {/*
    The hidden states of the reveal system are gated on html.js so a JS
    failure, a blocked bundle or a crawler still gets a complete page. It has
    to be set before first paint, so it is blocking and inline rather than part
    of the page module.
  */}
  {/* ── Feature header ──
      One directional gradient, painted on the section itself. No orbs. */}
  <section
    class="relative bg-[radial-gradient(ellipse_120%_78%_at_50%_-10%,rgba(255,255,255,0.035)_0%,rgba(255,255,255,0.012)_42%,transparent_72%)] pt-[26px] pb-10 lg:pt-11 lg:pb-18"
  >
    <Container className="lg:px-20">
      <nav class="mb-7 flex items-center gap-2 lg:mb-10" aria-label="Breadcrumb">
        <a
          href={withBase('features')}
          class="focus-visible:focus-ring inline-flex min-h-6 cursor-pointer items-center text-caption text-text-tertiary transition-colors duration-[var(--d-ui)] ease-ui hover:text-text-primary active:text-gold"
        >
          Features
        </a>
        <FeatureMark name="chevron-right" size={16} class="text-white/35" />
        <span class="text-caption text-text-primary" aria-current="page">{name}</span>
      </nav>

      <div class="grid grid-cols-1 items-end gap-8 lg:grid-cols-12 lg:gap-12">
        <div class="flex flex-col gap-5 lg:col-span-8 lg:gap-[22px]">
          {/*
            No mark here, deliberately.

            This header went through three versions: an icon in a tinted rounded
            square beside a `Fig. 06` label, then the bare mark at 64px. Both were
            the weakest thing on the page. An icon-per-feature is the defining
            component of a generated product page, and a line drawing of an
            equaliser is a SUBSTITUTE for showing one.

            This site does not need the substitute. Forty pixels below this heading
            is a phone displaying the real 32-band curve, and further down is the
            spec table. The type and the product carry the page; a glyph competing
            with them only announced that something decorative was expected here.
          */}

          <h1
            class="text-headline-m text-balance text-text-primary lg:text-headline"
          >
            {name}
          </h1>

          <p class="max-w-[56ch] text-lede-m text-pretty text-text-secondary lg:text-lede">
            {page.lede}
          </p>
        </div>

        <div class="grid grid-cols-2 gap-x-5 lg:col-span-4 lg:grid-cols-1 lg:gap-0 lg:py-1">
          {
            page.summary.map((row) => (
              <div class="flex items-baseline justify-between gap-4 border-t border-border-subtle py-[11px] [&:nth-child(3)]:border-b [&:nth-child(4)]:border-b lg:py-[13px] lg:[&:nth-child(3)]:border-b-0">
                <span class="text-caption text-text-tertiary">{row.label}</span>
                <span class="text-small font-semibold tabular-nums text-text-primary">{row.value}</span>
              </div>
            ))
          }
        </div>
      </div>
    </Container>

    {/* ── The signal path, drawn to scale (usb-dac only) ──
        INSIDE the header section, not a band of its own.

        Not a card: the card was there to give eleven rows of small mono type a
        surface to sit on, and with the rows gone the drawing is the object.

        And not a section either. As a sibling it made usb-dac the one route that
        ran THREE graphite bands in a row — header, drawing, first beat, 2,779px of
        unbroken dark — which is exactly what DESIGN.md's alternation rule exists to
        prevent. Flipping the beat parity fixed the count and cost a fourth ivory
        band plus 1,500px of continuous white, which is the same defect in the other
        direction.

        The honest fix is the structure. This drawing is the lede's EVIDENCE: it
        proves the sentence directly above it, shares its ground, and has never had
        a divider between them, so a reader already sees one band. Making it one
        band is a statement about what the header of this route is, and the run
        drops to two without touching the alternation. */}
    {
      showSignalPath && (
        <Container className="pt-12 pb-14 lg:px-20 lg:pt-[72px] lg:pb-[104px]">
          {/* The `pt` is the space the header section's own `pb-18` used to
              provide. Now that both live in one section, the gap between the lede
              and this eyebrow has to be stated here or the drawing crowds the
              sentence it exists to prove. */}
          <div class="max-w-[46ch]">
            <span class="r-fade mono-spec text-micro font-medium tracking-[1.2px] text-text-tertiary uppercase lg:tracking-[1.5px]">
              The path a sample takes
            </span>
            <h2 class="r-rise mt-4 text-section-m text-balance text-text-primary lg:mt-6 lg:text-headline" style="--i: 1">
              Seven stages, or four.
            </h2>
            <p class="r-rise mt-4 text-body text-pretty text-text-secondary lg:mt-5 lg:text-lede" style="--i: 2">
              One 24-bit, 192 kHz file. Two bars a stage: sample rate, then bit depth.
            </p>
          </div>

          <div class="ledger mt-12 flex flex-col gap-14 lg:mt-20 lg:gap-[72px]" data-ledger>
            {ROWS.map((row) => (
              <div class="r-rise grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-end lg:gap-12">
                {/* 9/3, not 8/4. The readout is ~150px of type in a 341px track,
                    right-aligned, so every spare pixel pooled into one ~290px hole
                    between the last bar and the number it produces, the two things
                    in the row that most need to read as one sentence. Nine columns
                    also buys the bars 98px, which is the legibility this drawing
                    lives on. Same correction as the alternating beats: the column
                    count follows the art. */}
                <div class="lg:col-span-9">
                  <div class="flex items-baseline justify-between gap-5 border-b border-white/8 pb-3.5">
                    <span
                      class:list={[
                        'text-label uppercase',
                        row.tone === 'kept' ? 'text-gold' : 'text-text-tertiary',
                      ]}
                    >
                      {row.label}
                    </span>
                    <span class="mono-spec text-micro tabular-nums text-text-tertiary">
                      {row.stages.length} stages
                    </span>
                  </div>

                  {/* Seven columns for both rows. Ours fills four and stops, and the
                      three empty columns are the whole point of the drawing.

                      Every bar sits in a FULL-HEIGHT GHOST TRACK. Without it a
                      collapsed bar just looks small; with it, the missing 111px is
                      a visible object and the bar looks robbed. That is the whole
                      difference between "shorter" and "took something from you".

                      Hidden below `md`, where the same data runs as rows instead. */}
                  <div
                    class="mt-7 hidden grid-cols-7 items-end gap-1.5 md:grid lg:mt-9 lg:gap-2.5"
                    style={`height: ${RAIL}px`}
                  >
                    {row.stages.map((stage, i) => (
                      <div class="grid h-full grid-cols-2 gap-1 lg:gap-1.5">
                        {[ratePct(stage), depthPct(stage)].map((pct, d) => (
                          <div class="relative h-full">
                            <span class="absolute inset-0 rounded-thumb bg-white/[0.045]" aria-hidden="true" />
                            <span
                              class:list={[
                                'ledger-bar absolute inset-x-0 bottom-0 rounded-thumb',
                                row.tone === 'kept'
                                  ? 'bg-gradient-to-t from-gold-deep to-gold'
                                  : 'bg-white/22',
                              ]}
                              style={`height: ${pct}%; --b: ${i}`}
                            />
                          </div>
                        ))}
                      </div>
                    ))}
                  </div>

                  {/* Seven columns of 12px mono needs about 90px a column, which
                      arrives at `md`. Tracked out: untracked mono at this size is a
                      primary "cheap" tell, and every reference tracks it. */}
                  <div class="mt-4 hidden grid-cols-7 gap-1.5 md:grid lg:gap-2.5">
                    {row.stages.map((stage) => (
                      <span class="mono-spec text-micro leading-tight tracking-[0.04em] text-text-tertiary">
                        {stage.name}
                      </span>
                    ))}
                  </div>

                  {/* Below `md` the chain ROTATES rather than dropping its labels.
                      Stages run top to bottom and magnitude becomes width, which is
                      the layout that lets a seven-stage chain read at 390px at all.
                      Apple forces its bar captions to WRAP rather than hide and
                      shrinks the graphic instead; nothing in the reference set drops
                      the labels, because the label is what makes a bar a datum. */}
                  <div class="mt-7 flex flex-col gap-3 md:hidden">
                    {row.stages.map((stage, i) => (
                      <div class="flex items-center gap-3">
                        <span class="mono-spec w-[104px] shrink-0 truncate text-micro tracking-[0.04em] text-text-tertiary">
                          {stage.name}
                        </span>
                        <span class="flex flex-1 flex-col gap-1.5">
                          {[ratePct(stage), depthPct(stage)].map((pct, d) => (
                            <span class="relative block h-2 rounded-full bg-white/[0.045]">
                              <span
                                class:list={[
                                  'ledger-barh absolute inset-y-0 left-0 rounded-full',
                                  row.tone === 'kept'
                                    ? 'bg-gradient-to-r from-gold-deep to-gold'
                                    : 'bg-white/22',
                                ]}
                                style={`width: ${pct}%; --b: ${i}`}
                              />
                            </span>
                          ))}
                        </span>
                      </div>
                    ))}
                  </div>
                </div>

                {/* The arrival, as the biggest thing in the row. */}
                <div class="lg:col-span-3 lg:pb-1 lg:text-right">
                  <span class="mono-spec block text-micro tracking-[1.2px] text-text-tertiary uppercase">
                    Reaches the DAC at
                  </span>
                  <span
                    class:list={[
                      'mt-3 block tabular-nums lg:mt-4',
                      row.tone === 'kept'
                        ? 'text-section-m text-gold-light lg:text-section-lg'
                        : 'text-title-lg text-text-tertiary lg:text-section-sm',
                    ]}
                  >
                    {row.outcome[0]}
                    <span class="block">{row.outcome[1]}</span>
                  </span>
                </div>
              </div>
            ))}
          </div>

          {/* Three counts that are all zero. The zero is the product, so it is set
              at the size of a product claim rather than buried in a mono strip. */}
          <div class="mt-14 grid grid-cols-3 gap-6 border-t border-white/8 pt-9 lg:mt-[72px] lg:gap-12 lg:pt-11">
            {['Resamples', 'Mixers', 'Conversions'].map((label) => (
              <div>
                <span class="block text-section-m tabular-nums text-gold lg:text-section">0</span>
                <span class="mono-spec mt-2 block text-micro tracking-[1.2px] text-text-tertiary uppercase lg:mt-3">
                  {label}
                </span>
              </div>
            ))}
          </div>

          <p class="mt-8 max-w-[62ch] text-small text-pretty text-text-secondary lg:mt-10">{SIGNAL_PATH.note}</p>
        </Container>
      )
    }
  </section>

  {/* ── The beats, as alternating bands ──
      One beat per section, the art side and the ground colour flipping together:
      dark with the art left, then white with the art right, and on down.

      Three things keep that from reading as stripes, all of them lifted from sites
      that ship this pattern well. The split is never 50/50 (Linear runs 8/4 of
      twelve, Stripe 2fr/1fr) because equal columns leave a dead gutter down the
      middle. The vertical padding differs per band, the white ones running taller.
      And the LAST beat breaks the alternation entirely and goes full width, because
      four identical flips is a zigzag and a zigzag is a template.

      The art is the app's own screen for that beat. Every route already has four,
      and they already map one to one onto the four beats, so the page argues with
      the product rather than with a placeholder.

      Mobile order is authored, not inherited: the order utilities are scoped to
      `lg:`, so at 390 the DOM order rules and the screen comes first in EVERY
      section. `flex-direction: row-reverse` would flip half of them. */}
  {
    page.beats.map((beat, i) => {
      const artLeft = i % 2 === 0;
      const isLast = i === page.beats.length - 1;
      /* The closing beat returns to graphite, always.

         It already breaks the alternation by going full width, and on every route
         with an even number of beats it landed LIGHT immediately before the light
         specification band: two ivory bands touching, ~1,900px of unbroken white,
         which is the alternation rule's own failure in the other direction. Ending
         the run on the page's own ground gives the specification band an edge to
         arrive on, which is the whole reason that band is white. */
      const onWhite = isLast ? false : !artLeft;
      return (
        <section
          class:list={[
            'relative',
            onWhite ? 'bg-band-ivory' : 'bg-surface-base',
            onWhite ? 'py-16 lg:py-40' : 'py-14 lg:py-30',
          ]}
        >
          <Container className="lg:px-20">
            <div
              class:list={[
                'grid grid-cols-1 gap-10 lg:gap-12',
                !isLast && 'lg:grid-cols-12 lg:items-center',
              ]}
            >
              {/* The screen. First in the DOM, so it leads on a phone regardless
                  of which side it takes on a desktop.

                  SIX COLUMNS, CENTRED — it was seven, pinned to the outer edge.
                  The 7/5 split is written for art that FILLS seven columns; this
                  column holds one 344px device inside 633px of track, and pinning
                  it outward pooled every spare pixel into a single ~360px hole
                  between the paragraph and the phone. DESIGN.md names that dead
                  gutter as the exact failure the split exists to prevent, so the
                  split, not the rule, was wrong here. Even columns with the device
                  centred spread the surplus to both sides of it, where it reads as
                  air around an object rather than as a gap between two. */}
              <div
                class:list={[
                  'flex justify-center',
                  isLast
                    ? 'lg:mx-auto'
                    : artLeft
                      ? 'lg:col-span-6 lg:order-1'
                      : 'lg:col-span-6 lg:order-2',
                ]}
              >
                <FeatureScreens slug={slug} state={i} />
              </div>

              <div
                class:list={[
                  'flex flex-col gap-3.5 lg:gap-4',
                  isLast
                    ? 'lg:mx-auto lg:max-w-[640px] lg:items-center lg:text-center'
                    : artLeft
                      ? 'lg:col-span-6 lg:order-2 lg:justify-self-end'
                      : 'lg:col-span-6 lg:order-1',
                ]}
              >
                <span
                  class:list={[
                    'r-fade mono-spec text-micro font-medium tracking-[1.2px] uppercase lg:tracking-[1.5px]',
                    onWhite ? 'text-band-gold-ink' : 'text-text-tertiary',
                  ]}
                >
                  {beat.eyebrow}
                </span>

                <h2
                  class:list={[
                    'r-rise text-section-m text-balance lg:text-section',
                    onWhite ? 'text-band-ink' : 'text-text-primary',
                  ]}
                  style="--i: 1"
                >
                  {beat.title}
                </h2>

                <p
                  class:list={[
                    'r-rise max-w-[52ch] text-body text-pretty lg:text-body-lg',
                    onWhite ? 'text-band-ink-muted' : 'text-text-secondary',
                  ]}
                  style="--i: 2"
                >
                  {beat.body}
                </p>

                {beat.stats && (
                  <div
                    class:list={[
                      'r-rise mt-1 grid w-full grid-cols-1 gap-2.5 sm:grid-cols-2',
                      isLast && 'lg:max-w-[520px]',
                    ]}
                    style="--i: 3"
                  >
                    {beat.stats.map((stat) => (
                      <div
                        class:list={[
                          'flex flex-col gap-1 rounded-tile border px-[18px] py-4',
                          /*
                            No fill on the white side. `band-gold-ink` is the lightest
                            step that clears 4.5:1 on #ffffff and it clears it by 0.01,
                            so the 5% ink wash that used to sit under this tile took the
                            value to 4.06:1 and out of AA. The hairline was already doing
                            the separating, which is what an ivory band is supposed to
                            use anyway. DESIGN.md, "The Gold Ink Sits On Paper".
                          */
                          onWhite ? 'border-band-rule' : 'border-border-subtle bg-white/[0.045]',
                        ]}
                      >
                        <span
                          class:list={[
                            'text-label tracking-[1.5px] uppercase',
                            onWhite ? 'text-band-ink-muted' : 'text-text-tertiary',
                          ]}
                        >
                          {stat.label}
                        </span>
                        <span
                          class:list={[
                            /* Ink, not gold. The graphite side of this exact
                               component already sets its value in neutral ink; the
                               white side turned it gold, which on these bands is
                               the link colour AND the focus-ring colour. A column
                               of gold values reads as a list of links that do
                               nothing. DESIGN.md, "The Gold Hierarchy Rule". */
                            'text-body-lg font-semibold tabular-nums',
                            onWhite ? 'text-band-ink' : 'text-text-primary',
                          ]}
                        >
                          {stat.value}
                        </span>
                      </div>
                    ))}
                  </div>
                )}

                {beat.chips && (
                  <div class="r-rise mt-0.5 flex flex-wrap gap-2" style="--i: 3">
                    {beat.chips.map((chip) => (
                      <span
                        class:list={[
                          'rounded-note border px-3.5 py-2 text-small',
                          /*
                            On white both states run unfilled, for the same reason as the
                            stat tile above: an 8% gold wash under gold ink measured
                            4.07:1. Dropping it from the active chip alone would have put
                            the fill on the quiet state and the emphasis backwards, so
                            both lose it and the active chip is told apart by its gold
                            rule, its gold ink and its weight, against a neutral hairline
                            and muted ink. The graphite side is unchanged: it has room.
                            DESIGN.md, "The Gold Ink Sits On Paper".
                          */
                          chip.active
                            ? onWhite
                              ? 'border-band-gold-ink/40 font-semibold text-band-gold-ink'
                              : 'border-gold/30 bg-gold/[0.09] font-semibold text-gold'
                            : onWhite
                              ? 'border-band-rule text-band-ink-muted'
                              : 'border-border-subtle bg-white/[0.05] text-text-secondary',
                        ]}
                      >
                        {chip.label}
                      </span>
                    ))}
                  </div>
                )}

                {/*
                  The five signal states, quarantined onto `plot-surface`: a second
                  colour system on the darkest ground reads as an instrument display,
                  where the same five on the page ground read as site chrome. They
                  never appear on a white band at all.
                */}
                {beat.signalStates && !onWhite && (
                  <div
                    class="r-rise mt-1 flex flex-wrap gap-2 rounded-tile border border-border-subtle bg-plot-surface p-3.5"
                    style="--i: 3"
                  >
                    {signalStateKeys.map((key) => {
                      const state = signalStateColors[key];
                      return (
                        <span
                          class="inline-flex items-center gap-2 rounded-note px-3 py-1.5 text-caption font-medium"
                          style={`color: ${state.hex};`}
                        >
                          <span aria-hidden="true">{state.glyph}</span>
                          <span>{state.label}</span>
                        </span>
                      );
                    })}
                  </div>
                )}

                {beat.note && (
                  <p
                    class:list={[
                      'r-rise mt-1 rounded-xl border px-[18px] py-4 text-small text-pretty',
                      onWhite
                        ? 'border-band-rule bg-band-well text-band-ink-muted'
                        : 'border-border-subtle bg-white/[0.045] text-text-secondary',
                    ]}
                    style="--i: 3"
                  >
                    {beat.note}
                  </p>
                )}
              </div>
            </div>
          </Container>
        </section>
      );
    })
  }

  {/*
    The seam between the rail and the white band. Full-bleed, so it is a sibling of
    the sections and never lives inside one, and it runs dark to light: the plate is
    itself a dark object, so it performs the transition. Prompt: SECTION-IMAGES.md.
  */}
  <ImageSlot name={`feature-${slug}-interstitial`} variant="band" ratio="5 / 1" ships="2560x512" />

  {/* ── The white band: the specification in full ──
      The one light band on a feature route. No cards, no glass, no glows
      inside it: separation is hairlines and space. */}
  <section class="bg-band-ivory pt-13 pb-14 lg:pt-24 lg:pb-26">
    <Container className="lg:px-20">
      <div class="grid grid-cols-1 items-start gap-9 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <span class="text-eyebrow block text-band-gold-ink">Specification</span>
          <h2 class="mt-4 text-section-sm text-balance text-band-ink lg:mt-5 lg:text-section-lg">
            The numbers, in full
          </h2>
          <p class="mt-4 max-w-[34ch] text-body text-band-ink-muted lg:mt-5">
            Everything here is what the shipping build does today.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-x-12 lg:col-span-8 lg:grid-cols-2">
          {
            (feature?.specs ?? []).map((spec, i, all) => (
              <div
                class:list={[
                  'flex flex-col gap-1.5 border-t border-band-rule py-4 lg:py-5',
                  i >= all.length - 2 && 'lg:border-b',
                  i === all.length - 1 && 'border-b',
                ]}
              >
                <span class="text-small text-band-ink-muted">{spec.label}</span>
                <span class="text-body-lg font-semibold tabular-nums text-band-ink">{spec.value}</span>
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  {/* ── Prev and next ──
      Walks indexOrder and wraps at both ends, so the six routes form one ring
      rather than six pairs that happen to resolve. */}
  <nav class="bg-surface-base pt-8 pb-10 lg:pt-14 lg:pb-18" aria-label="More features">
    <Container className="lg:px-20">
      <div class="grid grid-cols-1 gap-3 lg:grid-cols-2 lg:gap-6">
        <a
          href={withBase(`features/${prevSlug}`)}
          class="focus-visible:focus-ring pager pager-prev group flex cursor-pointer flex-col gap-2 rounded-card-sm border border-border-subtle bg-glass-surface px-[22px] py-5 shadow-[inset_0_1px_0_rgba(255,255,255,0.09)] hover:border-glass-border-hover hover:bg-white/[0.025] lg:gap-2.5 lg:rounded-card lg:px-[30px] lg:py-[26px]"
        >
          <span class="inline-flex items-center gap-2 text-label tracking-[1.5px] text-text-tertiary uppercase lg:text-micro lg:tracking-[2px]">
            <FeatureMark name="arrow-left" size={15} />
            <span>Previous</span>
          </span>
          <span class="text-body-lg font-semibold tracking-[-0.02em] text-text-primary lg:text-title">
            {featureName(prevSlug)}
          </span>
        </a>

        <a
          href={withBase(`features/${nextSlug}`)}
          class="focus-visible:focus-ring pager pager-next group flex cursor-pointer flex-col gap-2 rounded-card-sm border border-border-subtle bg-glass-surface px-[22px] py-5 shadow-[inset_0_1px_0_rgba(255,255,255,0.09)] hover:border-glass-border-hover hover:bg-white/[0.025] lg:items-end lg:gap-2.5 lg:rounded-card lg:px-[30px] lg:py-[26px]"
        >
          <span class="inline-flex items-center gap-2 text-label tracking-[1.5px] text-text-tertiary uppercase lg:text-micro lg:tracking-[2px]">
            <span>Next</span>
            <FeatureMark name="arrow-right" size={15} />
          </span>
          <span class="text-body-lg font-semibold tracking-[-0.02em] text-text-primary lg:text-title lg:text-right">
            {featureName(nextSlug)}
          </span>
        </a>
      </div>
    </Container>
  </nav>

  {/* ── Closing action ──
      The one warm horizon on the page, rising from the bottom edge. */}
  <section
    class="relative border-t border-border-subtle bg-[linear-gradient(to_top,rgba(255,179,71,0.13)_0%,rgba(232,184,75,0.05)_22%,transparent_46%)] pt-14 pb-16 lg:pt-24 lg:pb-26"
  >
    <Container className="lg:px-20">
      <div class="flex flex-col items-center text-center">
        <h2 class="r-rise max-w-[22ch] text-headline-sm-m text-balance text-text-primary lg:text-headline-sm">
          {page.cta.title}
        </h2>
        <p class="r-rise mt-4 max-w-[52ch] text-body text-pretty text-text-secondary lg:mt-[22px] lg:text-body-lg" style="--i: 1">
          {page.cta.body}
        </p>
        <a
          href={site.playUrl}
          rel="noopener noreferrer"
          class="btn-primary-gradient focus-visible:focus-ring r-rise mt-6 inline-flex h-[54px] w-full cursor-pointer items-center justify-center gap-2.5 rounded-full px-8 text-body font-semibold lg:mt-8 lg:w-auto"
          style="--i: 2"
        >
          <FeatureMark name="play" size={20} />
          <span>Get it on Google Play</span>
        </a>
      </div>
    </Container>
  </section>
</ContentLayout>

<style>
  /* The prev and next pair are card-links, so they answer like cards: the
     border lifts to the hover value, the ground comes up a hair, and the whole
     block rises one pixel over a NEUTRAL shadow. Pressed puts it back down and
     drops the shadow, so the card reads as taken rather than recoloured. */
  .pager {
    transition:
      background-color var(--d-ui) var(--ease-ui),
      border-color var(--d-ui) var(--ease-ui),
      box-shadow var(--d-ui) var(--ease-ui),
      transform var(--d-ui) var(--ease-ui);
  }
  .pager:hover {
    transform: translateY(-1px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.09),
      0 8px 32px rgba(0, 0, 0, 0.5);
  }
  .pager:active {
    transform: translateY(0);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      0 2px 10px rgba(0, 0, 0, 0.4);
  }

  /* Each arrow leads in the direction its card goes. */
  .pager :global(.pager-arrow) {
    transition: transform var(--d-ui) var(--ease-ui);
  }
  .pager-prev:hover :global(.pager-arrow) {
    transform: translateX(-2px);
  }
  .pager-next:hover :global(.pager-arrow) {
    transform: translateX(2px);
  }

  /* The Reduced Motion Rule: the border and the ground carry the hover alone. */
  @media (prefers-reduced-motion: reduce) {
    .pager:hover,
    .pager:active,
    .pager-prev:hover :global(.pager-arrow),
    .pager-next:hover :global(.pager-arrow) {
      transform: none;
    }
  }
</style>

<style>
  /*
    One pass, on scroll in, never a loop. Each bar grows off its baseline in the
    order the signal travels, so the reader watches Android's row fall away at the
    mixer rather than being told it did. No count-up: the numbers beside the bars
    never animate (DESIGN.md, "The Still Numbers Rule").
  */
  .ledger-bar,
  .ledger-barh {
    transition:
      transform 620ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 300ms linear;
  }
  .ledger-bar {
    transform-origin: bottom;
  }
  .ledger-barh {
    transform-origin: left;
  }
  /* Opacity as well as scale. `scaleY(0.04)` of a 148px rail leaves a 5.9px stub
     sitting there before the trigger fires, which reads as a rendering fault. */
  .ledger.is-armed .ledger-bar {
    transform: scaleY(0.04);
    opacity: 0;
  }
  .ledger.is-armed .ledger-barh {
    transform: scaleX(0.04);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .ledger-bar,
    .ledger-barh {
      transition: none;
    }
  }
</style>

<script>
  /*
    Arm the start state only if the observer is going to run. If the script never
    loads the ledger paints finished, which is the state that carries the argument
    anyway.
  */
  const ledger = document.querySelector<HTMLElement>('[data-ledger]');
  if (ledger && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    ledger.classList.add('is-armed');
    ledger.querySelectorAll<HTMLElement>('.ledger-bar, .ledger-barh').forEach((el) => {
      /* `--b` is the STAGE index, written by the template. Both of a stage's bars
         carry the same one, so rate and depth arrive together and the longest row
         finishes in about a second rather than one and a half. */
      const beat = Number(el.style.getPropertyValue('--b')) || 0;
      el.style.transitionDelay = `${beat * 55}ms`;
    });
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          ledger.classList.remove('is-armed');
          io.disconnect();
        }
      },
      { threshold: 0.35 },
    );
    io.observe(ledger);
  }
</script>
