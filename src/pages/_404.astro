---
import ContentLayout from '../layouts/ContentLayout.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/common/Button.astro';
import { withBase } from '../utils/nav';
---

{/*
  The title is BARE. `SEOHead` appends ` | ${site.name}` to anything that is not
  exactly the site name, so passing the suffix here shipped
  `Page not found | Bitperfect Player | Bitperfect Player` into <title>, og:title
  and twitter:title alike.
*/}
<ContentLayout
  title="Page not found"
  description="This page does not exist. The player, the privacy policy and everything else are one tap away."
>
  <section class="lost">
    <div class="inner">
      <p class="text-xs text-text-tertiary uppercase tracking-widest font-mono">404</p>
      <h1 class="heading-section">Nothing on this path.</h1>
      {/* The colon before `but` was doing a job no colon can do: it introduces
          what follows, and `but` contradicts it. Two sentences. */}
      <p class="text-text-secondary max-w-96">
        Fitting, for a player that keeps the signal path empty. This one is an
        actual dead end.
      </p>
      <div class="actions">
        <Button href={withBase('/')} variant="primary" class="gap-2 btn-back">
          <Icon name="arrow" size={20} />
          <span>Back to the start</span>
        </Button>
        {/* Was `Privacy policy`, which answers a question nobody arrives at a
            404 asking. A dead link is usually a moved or renamed feature page,
            so the second exit is the place those live. */}
        <a class="btn-link focus-visible:focus-ring" href={withBase('features')}>
          All features
        </a>
      </div>
    </div>
  </section>
</ContentLayout>

<style>
  .lost {
    min-height: 70vh;
    display: grid;
    place-items: center;
    text-align: center;
    padding-block: 6rem;
  }

  .inner {
    display: grid;
    justify-items: center;
    gap: 1rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 1rem;
  }

  /* The Icon component's arrow points right by default; rotate it to read
     as "back" without touching Icon.astro (read-only this pass).
     Fully :global(): `btn-back` is a class forwarded through the Button
     component, not a raw element in this file, so Astro's scope hash
     cannot be relied on to reach it. */
  :global(.btn-back .icon) {
    transform: rotate(180deg);
  }

  /* Interaction feedback runs on the UI curve, never the reveal curve. */
  /* The second exit stands at the primary's own height rather than sitting in
     the middle of it as a 14px caption. A pill and a bare word on one baseline
     read as a button with a stray label beside it; matched heights read as two
     choices, and the pair then centres on the page instead of hanging left of
     centre because the light half weighed nothing. */
  .btn-link {
    display: inline-flex;
    align-items: center;
    min-height: 54px;
    padding-inline: 0.25rem;
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    cursor: pointer;
    border-bottom: 1px solid transparent;
    transition:
      color var(--d-ui) var(--ease-ui),
      border-color var(--d-ui) var(--ease-ui);
  }
  .btn-link:hover {
    color: var(--color-gold);
    box-shadow: inset 0 -1px 0 var(--color-gold);
  }
  .btn-link:active {
    color: var(--color-gold-deep);
    box-shadow: inset 0 -1px 0 var(--color-gold-deep);
  }

</style>
