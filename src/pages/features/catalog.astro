---
import ContentLayout from '../../layouts/ContentLayout.astro';
import PageHeader from '../../components/common/PageHeader';
import ClosingBanner from '../../components/common/ClosingBanner';
import TechnicalCatalog from '../../components/feature/TechnicalCatalog.astro';
import { site } from '../../data/site';
import { withBase } from '../../utils/nav';

const title = 'All 27 features | Bitperfect Player';
const description =
  'All 27 features of Bitperfect Player: USB DAC output, UAC1 and UAC2, DSD, EQ, dyadic volume and on-device AI.';
---

<ContentLayout title={title} description={description}>
  <PageHeader
    backHref={withBase('/features')}
    backLabel="Back to Features"
    eyebrow="Full specifications"
    title="27 Audiophile Capabilities"
    description="On many phones, Android converts every track to one sample rate. Bitperfect Player sends your file to a USB DAC unchanged, bit for bit. It tells you when it cannot."
  />

  {/* Full Catalog */}
  <TechnicalCatalog id="all-capabilities" />

  <ClosingBanner
    eyebrow="Get the app"
    title="Ready to hear your music bit-for-bit?"
    description="Install the app from Google Play and connect your DAC."
    primaryHref={site.playUrl}
    primaryLabel="Get it on Google Play"
    primaryExternal={true}
    secondaryHref={withBase('/faq')}
    secondaryLabel="Read the FAQ"
  />
</ContentLayout>
