---
import ContentLayout from '../../layouts/ContentLayout.astro';
import PageHeader from '../../components/common/PageHeader.astro';
import ClosingBanner from '../../components/common/ClosingBanner.astro';
import TechnicalCatalog from '../../components/feature/TechnicalCatalog.astro';
import { site } from '../../data/site';
import { withBase } from '../../utils/nav';

const title = 'Audiophile Architecture & 27 Technical Features | Bitperfect Player';
const description =
  'Full engineering documentation of all 27 capabilities of Bitperfect Player: Rust audio engine, custom UAC1/UAC2 drivers, dyadic volume, on-device AI, and hardware bypass.';
---

<ContentLayout title={title} description={description}>
  <PageHeader
    backHref={withBase('/features')}
    backLabel="Back to Features Overview"
    eyebrow="Full Specification Manual"
    title="27 Audiophile Capabilities"
    description="Android's default audio mixer resamples and compresses audio streams. Bitperfect Player bypasses the OS using custom user-space USB drivers, a Rust playback engine, and hardware isolation."
  />

  {/* Full Catalog */}
  <TechnicalCatalog id="all-capabilities" />

  <ClosingBanner
    eyebrow="Experience Pure Signal Delivery"
    title="Ready to hear your music bit-for-bit?"
    description="Download Bitperfect Player on Google Play and bypass Android OS limitations today."
    primaryHref={site.playUrl}
    primaryLabel="Get it on Google Play"
    primaryExternal={true}
    secondaryHref={withBase('/faq')}
    secondaryLabel="Read the FAQ"
  />
</ContentLayout>
