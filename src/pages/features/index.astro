---
import ContentLayout from '../../layouts/ContentLayout.astro';
import Container from '../../components/common/Container.astro';
import SectionHeader from '../../components/common/SectionHeader.astro';
import StoreBadges from '../../components/common/StoreBadges.astro';
import Icon from '../../components/Icon.astro';
import { features } from '../../data/features';
import { accentColors } from '../../data/colors';
import { withBase } from '../../utils/nav';
---

<ContentLayout
  title="All Features & Technical Capabilities"
  description="Explore the complete architecture of Bitperfect Player: 32-band parametric EQ, lossless local library, bi-directional network streaming, studio DSP, and USB DAC bit-perfect output."
>
  <div class="relative overflow-hidden pt-28 sm:pt-36 pb-20 lg:pb-28">
    {/* Background ambient wash */}
    <div
      class="pointer-events-none absolute top-12 left-1/2 -translate-x-1/2 h-[36rem] w-[36rem] rounded-full bg-gold/10 opacity-30 blur-orb-xl"
      aria-hidden="true"
    >
    </div>

    <Container class="relative z-10 space-y-16 sm:space-y-20">
      {/* Page Header */}
      <header class="max-w-3xl space-y-4" data-animate="fade-up">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-gold/30 bg-gold/10 px-3 py-1 text-xs font-semibold text-gold uppercase tracking-wider">
            <Icon name="node-engine" size={13} />
            <span>Architecture & Capabilities</span>
          </span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white text-balance">
          Every feature, built for bit-true accuracy
        </h1>

        <p class="text-base sm:text-lg text-text-secondary leading-relaxed">
          Deep-dive into Bitperfect’s modular audio stack: from surgical 32-band parametric acoustics to on-device neural signal restoration.
        </p>
      </header>

      {/* Features Grid */}
      <section aria-labelledby="features-grid-heading" class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        <h2 id="features-grid-heading" class="sr-only">Features List</h2>

        {
          features.map((f) => {
            const token = accentColors[f.accent]?.token ?? 'var(--color-gold)';
            const hex = accentColors[f.accent]?.hex ?? '#e8b84b';
            return (
              <article
                class="glass accent-glow accent-glow-hover flex flex-col justify-between rounded-3xl p-6 sm:p-8 relative overflow-hidden transition-all duration-300 hover:scale-[1.01]"
                style={`--card-accent: ${token}`}
                data-animate="fade-up"
              >
                <div class="space-y-5">
                  <div class="flex items-center justify-between gap-3">
                    <span
                      class="flex-center h-12 w-12 shrink-0 rounded-2xl border"
                      style={`border-color: ${hex}40; background: ${hex}15; color: ${hex};`}
                    >
                      <Icon name={f.icon} size={24} />
                    </span>
                    <span
                      class="rounded-full border px-3 py-1 text-xs font-semibold uppercase tracking-wider"
                      style={`border-color: ${hex}30; background: ${hex}10; color: ${hex};`}
                    >
                      {f.badge}
                    </span>
                  </div>

                  <div>
                    <h3 class="text-xl sm:text-2xl font-bold text-white">
                      {f.title}
                    </h3>
                    <p class="mt-1 text-xs sm:text-sm font-medium text-gold">
                      {f.tagline}
                    </p>
                    <p class="mt-3 text-sm leading-relaxed text-text-secondary">
                      {f.description}
                    </p>
                  </div>

                  <ul class="space-y-2 pt-2 border-t border-border-subtle text-xs text-text-secondary">
                    {f.facts.slice(0, 3).map((fact) => (
                      <li class="flex items-center gap-2">
                        <span class="h-1.5 w-1.5 shrink-0 rounded-full" style={`background: ${hex};`}></span>
                        <span>{fact}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="mt-8 pt-4 border-t border-border-subtle flex items-center justify-between">
                  <span class="text-xs font-mono text-text-tertiary">
                    {f.specs.length} specifications
                  </span>
                  <a
                    href={withBase(`features/${f.slug}`)}
                    class="inline-flex items-center gap-1.5 text-sm font-semibold transition-colors hover:text-white focus-visible:focus-ring"
                    style={`color: ${hex};`}
                  >
                    <span>Explore feature & specs</span>
                    <Icon name="arrow" size={14} />
                  </a>
                </div>
              </article>
            );
          })
        }
      </section>

      {/* Bottom CTA */}
      <aside aria-label="Get the app" class="glass accent-glow rounded-3xl p-8 sm:p-12 text-center space-y-6 relative overflow-hidden" style="--card-accent: var(--color-gold)" data-animate="fade-up">
        <div class="max-w-xl mx-auto space-y-3">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Start listening bit for bit</h2>
          <p class="text-sm sm:text-base text-text-secondary">
            Install Bitperfect on Android 8.0+ and enjoy direct USB DAC output, parametric EQ, and network streaming for free.
          </p>
        </div>
        <div class="flex justify-center">
          <StoreBadges variant="light" size="lg" />
        </div>
      </aside>
    </Container>
  </div>
</ContentLayout>
