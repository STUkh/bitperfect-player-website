---
/**
 * The features index: the technical home of the site.
 *
 * Six cards in a balanced 3-column audiophile dashboard grid (2x3).
 * Each card features a precision-drawn technical plate, clear feature title,
 * and concise tagline. The cards use tactile double-bezel chassis styling
 * with specular light sheen and micro-interactions.
 *
 * The row copy is transcribed from design/FeaturesIndex.dc.html, which is the
 * approved short form for this page. The long form lives on each route, in
 * `src/components/feature/content.ts`.
 */
import ContentLayout from '../../layouts/ContentLayout.astro';
import Container from '../../components/common/Container';
import Button from '../../components/common/Button';
import FeatureArt from '../../components/feature/FeatureArt.astro';
import PhoneTrio from '../../components/feature/PhoneTrio.astro';
import { indexOrder } from '../../components/feature/content';
import { site, getLocalizedCompatibility } from '../../data/site';
import { withBase } from '../../utils/nav';
import { getLocalizedFeatureName } from '../../data/navigation';
import { useTranslations, type UIKey } from '../../i18n/utils';

const lang = Astro.currentLocale;
const t = useTranslations(lang);
const compatRows = getLocalizedCompatibility(lang);

/* Taglines only. The row's NAME comes from `getLocalizedFeatureName()`, so this page cannot
   call a route something the nav that points at it does not. */
const ROWS: Record<(typeof indexOrder)[number], { tagline: string }> = {
  'usb-dac': { tagline: 'The file reaches your DAC exactly as recorded' },
  eq: { tagline: 'Precise tone control, off again in one tap' },
  library: { tagline: 'Every album found instantly, without leaving the phone' },
  casting: { tagline: 'Send to a network streamer or TV, or receive from another device' },
  dsp: { tagline: 'Crossfeed, loudness matching and clip protection, all switchable' },
  'ai-enhancer': { tagline: 'Recovers detail compression removed, right on the phone' },
};

const getRowTagline = (slug: (typeof indexOrder)[number]) => {
  const key = `feature.${slug}.tagline` as UIKey;
  const translated = t(key);
  return translated && translated !== key ? translated : ROWS[slug].tagline;
};

const order = [...indexOrder];
---
<ContentLayout
  title={t('features_index.meta_title')}
  description={t('features_index.meta_description')}
>
  {/* ── Page header ──
      One directional gradient on the section itself. No orbs, no halos. */}
  <section
    class="relative bg-[radial-gradient(ellipse_120%_80%_at_50%_-15%,rgba(232,184,75,0.06)_0%,rgba(255,255,255,0.015)_45%,transparent_75%)] pt-10 pb-14 lg:pt-16 lg:pb-[110px]"
    aria-labelledby="features-page-heading"
  >
    <Container>
      <div class="mx-auto max-w-3xl text-center">
        <span class="mono-spec mb-3 block text-micro font-medium tracking-[2px] text-gold uppercase">
          {t('features_index.header_eyebrow')}
        </span>
        <h1 id="features-page-heading" class="text-headline-xl-m text-balance text-text-primary lg:text-headline-xl">
          {t('features_index.header_title')}
        </h1>
        <p class="mx-auto mt-4 max-w-[54ch] text-body text-pretty text-text-secondary lg:mt-6 lg:text-body-lg">
          {t('features_index.header_subtitle')}
        </p>
      </div>

      {/* ── Flagship Multi-Phone Composition (Image #6 Trio: Library + Now Playing + EQ) ──
          Pure, tactile, high-end hardware showcase: center phone elevated in front,
          left & right angled slightly behind. Zero clutter, authentic Android screens. */}
      <div class="mt-10 sm:mt-14 lg:mt-20">
        <PhoneTrio
          leftScreen="library"
          centerScreen="now-playing"
          rightScreen="eq"
          priority={true}
        />
      </div>
    </Container>
    <Container className="mt-14 lg:mt-24">

      <h2 id="features-heading" class="sr-only">{t('features_index.cards_sr_heading')}</h2>
      {/*
        Balanced 3-column layout on desktop (grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6).
        Proportioned as a precision-engineered audiophile dashboard with 8/5 aspect ratio,
        compact padding and concise typography.
      */}
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
        {
          order.map((slug, i) => {
            return (
              <a
                href={withBase(`features/${slug}`)}
                class="feature-card r-rise focus-visible:focus-ring group relative flex cursor-pointer flex-col overflow-hidden lacquer-card rounded-card-inner lg:rounded-card"
                style={`--i: ${i % 3}`}
              >
                <div class="art-clip relative overflow-hidden">
                  <FeatureArt slug={slug} class="art w-full" />
                </div>

                <div class="relative flex flex-1 flex-col px-6 pt-3 pb-6 lg:px-7 lg:pt-4 lg:pb-7">
                  <h3 class="text-title-sm font-semibold tracking-[-0.01em] text-text-primary transition-colors duration-[var(--d-ui)] ease-ui group-hover:text-gold-light lg:text-title">
                    {getLocalizedFeatureName(slug, lang)}
                  </h3>
                  <p class="mt-2 text-body-sm text-pretty text-text-secondary transition-colors duration-[var(--d-ui)] ease-ui group-hover:text-text-primary">
                    {getRowTagline(slug)}
                  </p>
                </div>
              </a>
            );
          })
        }
      </div>

      {/* Hairline-separated reference row to full technical catalog (zero nested boxes, canonical Button) */}
      <div class="mt-12 flex flex-col items-start justify-between gap-6 border-t border-border-subtle pt-8 md:flex-row md:items-center lg:mt-16 lg:pt-12">
        <div class="max-w-2xl">
          <div class="flex items-center gap-2">
            <span class="mono-spec text-micro font-semibold tracking-wider text-gold uppercase">{t('features_index.catalog_eyebrow')}</span>
            <span class="mono-spec text-micro tabular-nums text-text-tertiary uppercase">· {t('features_index.catalog_badge')}</span>
          </div>
          <h3 class="mt-2 text-title-sm font-bold text-text-primary sm:text-title-lg">
            {t('features_index.catalog_title')}
          </h3>
          <p class="mt-2 text-small text-pretty text-text-secondary">
            {t('features_index.catalog_body')}
          </p>
        </div>
        <Button
          href={withBase('features/catalog')}
          variant="secondary"
          size="md"
          className="shrink-0 tabular-nums"
        >
          <span>{t('features_index.catalog_cta')}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </Button>
      </div>
    </Container>
  </section>

  {/* ── Will it run on your phone ──
      This data has existed in `src/data/site.ts` since the rewrite: three rows
      naming exactly which phones get the engine and which get the AI Enhancer.

      Hairlines and space, no cards. Set on warm ivory to break the dark ground
      per DESIGN.md Strict Alternation Rule (Dark -> Light -> Dark). */}
  <section id="compatibility" class="ground ground-halftone scroll-mt-24 bg-band-ivory pt-12 pb-14 lg:pt-24 lg:pb-26">
    <Container>
      <div class="grid grid-cols-1 items-start gap-9 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <h2 class="text-section-sm text-balance text-band-ink lg:text-section-lg">
            {t('features_index.compat_title')}
          </h2>
          <p class="mt-4 max-w-[34ch] text-body text-pretty text-band-ink-muted lg:mt-5">
            {t('features_index.compat_subtitle')}
          </p>
        </div>

        <div class="flex flex-col lg:col-span-8">
          {
            compatRows.map((row, i, all) => (
              <div
                class:list={[
                  'grid grid-cols-1 gap-2 border-t border-band-rule py-6 lg:grid-cols-[1fr_1fr] lg:gap-10 lg:py-7',
                  i === all.length - 1 && 'border-b',
                ]}
              >
                <div>
                  <h3 class="text-body-lg font-semibold tracking-[-0.01em] text-band-ink lg:text-title-sm">
                    {row.what}
                  </h3>
                  <p class="mt-1.5 text-caption text-pretty text-band-ink-muted lg:text-small">
                    {row.scope}
                  </p>
                </div>
                <div>
                  <p class="text-body-sm font-semibold text-pretty text-band-ink lg:text-body">
                    {row.devices}
                  </p>
                  <p class="mt-2 max-w-[52ch] text-caption leading-[1.62] tabular-nums text-pretty text-band-ink-muted lg:text-small">
                    {row.note}
                  </p>
                </div>
              </div>
            ))
          }
          <p class="mt-6 text-caption text-band-ink-muted">
            {t('features_index.compat_min_android', { minAndroid: site.minAndroid })}
          </p>
        </div>
      </div>
    </Container>
  </section>

  {/* ── Closing action, on graphite to strictly alternate after the ivory compatibility band ── */}
  <section
    class="ground ground-interference relative overflow-hidden border-t border-border-subtle bg-surface-base pt-16 pb-18 lg:pt-28 lg:pb-30"
  >
    <Container>
      <div class="flex flex-col items-center text-center">
        <span class="mono-spec r-fade block text-micro font-medium tracking-[1.5px] text-gold uppercase lg:tracking-[1.9px]">
          {t('features_index.cta_eyebrow')}
        </span>
        <h2 class="r-rise mt-4 max-w-[20ch] text-headline-sm-m text-balance text-text-primary lg:mt-5 lg:text-headline-sm" style="--i: 0">
          {t('features_index.cta_title_prefix')}<span class="text-gold">{t('features_index.cta_title_highlight')}</span>
        </h2>
        <p class="r-rise mt-4 max-w-[51ch] text-body text-pretty text-text-secondary lg:mt-5 lg:text-body-lg" style="--i: 1">
          {t('features_index.cta_subtitle')}
        </p>
        <Button
          href={site.playUrl}
          rel="noopener noreferrer"
          variant="primary"
          size="lg"
          className="r-rise mt-8 lg:mt-10"
          style="--i: 2"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M5 3.5v17a1 1 0 0 0 1.52.86l14-8.5a1 1 0 0 0 0-1.72l-14-8.5A1 1 0 0 0 5 3.5Z"></path>
          </svg>
          <span>{t('features_index.cta_button')}</span>
        </Button>
      </div>
    </Container>
  </section>
</ContentLayout>

<style>
  /*
    The plate is clipped 1px INSIDE the card's radius rather than by
    `overflow: hidden`. Apple does the same thing on its product tiles
    (`isolation: isolate; clip-path: inset(1px round var(--sk-tile-border-radius))`)
    and the reason is visible on exactly this palette: gold art meeting a dark card
    corner under plain `overflow: hidden` leaves an aliased seam on the arc.
  */
  .art-clip {
    isolation: isolate;
    clip-path: inset(0 round 18px 18px 0 0);
  }
  @media (min-width: 1024px) {
    .art-clip {
      clip-path: inset(1px 1px 0 1px round 23px 23px 0 0);
    }
  }


  /* Audiophile chassis: tactile elevation and diagonal light sheen */
  .feature-card,
  :global(html.js) .feature-card.r-rise.is-visible {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 8px 24px -10px rgba(0, 0, 0, 0.45);
    transition:
      transform 220ms var(--ease-ui),
      box-shadow 220ms var(--ease-ui),
      border-color var(--d-ui) var(--ease-ui);
  }
  .feature-card:hover,
  :global(html.js) .feature-card.r-rise.is-visible:hover {
    transform: translateY(-3px);
    box-shadow:
      inset 0 1px 0 rgba(232, 184, 75, 0.35),
      0 20px 42px -12px rgba(0, 0, 0, 0.7);
  }
  .feature-card:active,
  :global(html.js) .feature-card.r-rise.is-visible:active {
    transform: translateY(-1px);
  }

  /* Specular light sweep on hover */
  .feature-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(
      115deg,
      transparent 22%,
      rgba(232, 184, 75, 0.08) 42%,
      rgba(255, 255, 255, 0.06) 48%,
      transparent 65%
    );
    background-size: 240% 240%;
    background-position: 0% 0%;
    opacity: 0;
    transition:
      opacity 260ms ease,
      background-position 550ms var(--ease-reveal);
    z-index: 5;
  }
  .feature-card:hover::before {
    opacity: 1;
    background-position: 100% 100%;
  }

  .art {
    transition: transform 380ms var(--ease-reveal);
  }
  .feature-card:hover .art {
    transform: scale(1.02);
  }
</style>
