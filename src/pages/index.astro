---
/**
 * The home page is six sections plus the held phone moment, and nothing else.
 * Depth belongs on the features routes; this page states what the app is, shows
 * it, and asks for the install.
 *
 * The three ivory bands need no divider: the colour change is the divider. A
 * hairline only sits between two adjacent graphite sections.
 *
 * The opening and features sections meet the ivory bands directly. Their former
 * decorative image strips added height without explaining the product. The final
 * quiet graphite-to-paper hinge remains before the closing action.
 */
import LandingLayout from '../layouts/LandingLayout.astro';
import HomeOpening from '../components/landing/HomeOpening.astro';
import StatementBand from '../components/landing/StatementBand';
import FeaturesTeaser from '../components/landing/FeaturesTeaser';
import PrivacyBand from '../components/landing/PrivacyBand';
import PricingSection from '../components/landing/PricingSection';
import CTASection from '../components/landing/CTASection';
import TextureStrip from '../components/primitives/TextureStrip';
import { chooseFlowSequence } from '../utils/flow-background';

const backgrounds = chooseFlowSequence('home', ['statement', 'features', 'privacy', 'pricing', 'cta']);
---

<LandingLayout
  title="Bit-perfect audio player"
  description="Bypass the system mixer. Send bit-perfect audio up to 768 kHz and DSD512 straight to your USB DAC. No account needed. No tracking, no ads."
>
  <HomeOpening />
  <StatementBand backgroundVariant={backgrounds[0]} />
  <FeaturesTeaser backgroundVariant={backgrounds[1]} />
  <TextureStrip material="copper" />
  <PrivacyBand backgroundVariant={backgrounds[2]} />
  <PricingSection backgroundVariant={backgrounds[3]} />
  <CTASection backgroundVariant={backgrounds[4]} />
</LandingLayout>
