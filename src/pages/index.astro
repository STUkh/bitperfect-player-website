---
/**
 * The home page is six sections plus the held phone moment, and nothing else.
 * Depth belongs on the features routes; this page states what the app is, shows
 * it, and asks for the install.
 *
 * Blocks and page metadata are driven by Keystatic CMS via `src/content/pages/home.json`.
 *
 * While `site.holding` is on, `/` shows the holding page instead (maintenance mode);
 * /preview/home passes `landing` to render the landing regardless.
 */
import { getEntry } from 'astro:content';
import LandingLayout from '../layouts/LandingLayout.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import HoldingPage from '../components/chrome/HoldingPage';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import { chooseFlowSequence } from '../utils/flow-background';
import { site } from '../data/site';

interface Props {
  /** Render the landing even in maintenance mode (the dev preview). */
  landing?: boolean;
}

const parked = site.holding && !Astro.props.landing;

const homeEntry = await getEntry('pages', 'home');
const homeData = homeEntry?.data;

const title = homeData?.title ?? 'Bit-perfect audio player';
const description =
  homeData?.description ??
  'Bypass the system mixer. Send bit-perfect audio up to 768 kHz and DSD512 straight to your USB DAC. No tracking, no ads.';
const blocks = homeData?.blocks ?? [];

// Background flow sequence for landing bands
const flowSequence = chooseFlowSequence('home', [
  'ai-player',
  'audio-engine',
  'statement',
  'features',
  'privacy',
  'pricing',
  'cta',
]);

const bandBlockTypes = new Set([
  'aiplayer',
  'aiplayerband',
  'audioengine',
  'audioengineband',
  'statement',
  'statementband',
  'featuresteaser',
  'features',
  'privacy',
  'privacyband',
  'pricing',
  'pricingsection',
  'cta',
  'ctasection',
]);

let bandIndex = 0;
---

{
  parked ? (
    /* The title is bare: SEOHead appends the site name. No noindex: this is the front
     door while it is up, it names the product and links to the store. */
    <BaseLayout
      title="Under construction"
      description="The Bitperfect Player site is being rebuilt. The player is on Google Play, and the privacy policy and terms of use are still here."
    >
      <HoldingPage
        eyebrow="Under construction"
        headline="The needle is still up."
        lede="We are rebuilding this site. The player is unchanged and still on Google Play."
      />
    </BaseLayout>
  ) : (
    <LandingLayout title={title} description={description}>
      {blocks.map((block) => {
        const rawType = (block as any).discriminant || (block as any).type || '';
        const normType = rawType.toLowerCase().replace(/[^a-z0-9]/g, '');
        const isBand = bandBlockTypes.has(normType);
        const bgVariant = isBand ? flowSequence[bandIndex++ % flowSequence.length] : undefined;
        return <BlockRenderer block={block} backgroundVariant={bgVariant} />;
      })}
    </LandingLayout>
  )
}
