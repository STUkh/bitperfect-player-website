---
import ContentLayout from '../../layouts/ContentLayout.astro';
import Container from '../../components/primitives/Container';
import PageHeader from '../../components/common/PageHeader';
import ClosingBanner from '../../components/sections/ClosingBanner';
import CrossLinkRow from '../../components/sections/CrossLinkRow';
import Button from '../../components/primitives/Button';
import { allFaqItems } from '../../data/faq';
import { site } from '../../data/site';
import { withBase } from '../../utils/nav';
import { DISCLOSURE_CHEVRON_POINTS, SEARCH } from '../../components/primitives/glyphs';

const title = 'Frequently asked questions';
const description =
  'Answers on USB DAC setup, bit-perfect playback, AI Enhancer, battery settings and audio formats.';

const categories = [
  { id: 'all', label: 'All questions' },
  { id: 'engine', label: 'Bit-perfect playback' },
  { id: 'hardware', label: 'Hardware and USB DACs' },
  { id: 'ai', label: 'On-device AI' },
  { id: 'dsp', label: 'EQ and formats' },
  { id: 'battery', label: 'Battery and background play' },
  { id: 'license', label: 'Subscription and privacy' },
].map((cat) => ({
  ...cat,
  // Counted from the data, not typed: a question added to faq.ts updates the index.
  count:
    cat.id === 'all'
      ? allFaqItems.length
      : allFaqItems.filter((item) => item.category === cat.id).length,
}));
---

<ContentLayout title={title} description={description}>
  <PageHeader
    maxWidth="wide"
    eyebrow="Help"
    title="Frequently asked questions"
    description="Answers on USB DACs, bit-perfect playback, AI Enhancer and battery settings."
  >
    {/* Live Search Input */}
    <div class="mt-8 relative max-w-xl">
      <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-text-tertiary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          {SEARCH.map(({ el: El, ...attrs }) => <El {...attrs}></El>)}
        </svg>
      </div>
      <input
        type="search"
        id="faq-search"
        placeholder="Search: USB DAC, AI Enhancer, battery, DSD..."
        class="w-full rounded-lg border border-border-subtle bg-surface-raised pl-10 pr-4 py-3 text-small text-text-primary placeholder:text-text-tertiary focus:border-gold focus:outline-none focus:ring-1 focus:ring-gold transition-colors"
      />
    </div>
  </PageHeader>

  {/* Dedicated Guide Spotlight Banner */}
  <section class="border-b border-border-subtle/50 bg-surface-raised/40 py-6">
    <Container>
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-body font-bold text-text-primary">
            Why is AI Enhancer not working on your phone?
          </h2>
          <p class="mt-0.5 max-w-[68ch] text-caption text-text-secondary">
            See which phones run AI Enhancer on the neural chip, and why it may switch off on yours.
          </p>
        </div>
        <Button href={withBase('/faq/why-npu-ai-enhancer-not-working')} variant="secondary" size="md" className="shrink-0">
          <span>Check your phone</span>
        </Button>
      </div>
    </Container>
  </section>

  {/* Category Filter & FAQ List */}
  <section class="py-12 lg:py-20">
    <Container>
      <div class="faq-grid">
        {/* Category index: the Privacy page's sticky sidebar on desktop, a
            single scrolling strip on phones. Toggle buttons, not links: they
            filter in place and change no URL. */}
        <aside class="faq-nav-wrapper">
          <p class="faq-nav-title" id="faq-cat-label">Categories</p>
          <div class="faq-nav" id="faq-category-nav" role="group" aria-labelledby="faq-cat-label">
            {
              categories.map((cat, i) => (
                <button
                  type="button"
                  data-category-filter={cat.id}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                  class="faq-cat-btn focus-visible:focus-ring"
                >
                  <span class="faq-cat-label">{cat.label}</span>
                  <span class="faq-cat-count">
                    {cat.count}
                    <span class="sr-only">questions</span>
                  </span>
                </button>
              ))
            }
          </div>
        </aside>

        <div class="faq-main">
          {/* Questions list: hairline rows, zero nested boxes */}
          <div class="divide-y divide-border-subtle border-b border-border-subtle" id="faq-items-container">
            {
              allFaqItems.map((item) => (
                <details
                  id={item.id}
                  data-faq-category={item.category}
                  data-faq-keywords={`${item.q.toLowerCase()} ${item.a.toLowerCase()}`}
                  class="faq-accordion-item group py-6 transition-colors duration-[var(--d-ui)]"
                >
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded font-semibold text-text-primary focus:outline-none focus-visible:focus-ring">
                    <span class="text-body-lg font-bold text-text-primary transition-colors group-hover:text-gold-light group-open:text-gold-light">
                      {item.q}
                    </span>
                    <div class="flex h-7 w-7 shrink-0 items-center justify-center text-text-tertiary transition-transform duration-200 group-hover:text-gold group-open:rotate-180 group-open:text-gold">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points={DISCLOSURE_CHEVRON_POINTS}></polyline>
                      </svg>
                    </div>
                  </summary>

                  <div class="mt-4 text-body-sm text-pretty text-text-secondary leading-relaxed">
                    <p>{item.a}</p>

                    {item.guideUrl && (
                      <div class="mt-4">
                        <a
                          href={withBase(item.guideUrl)}
                          class="inline-flex items-center gap-1.5 rounded text-small font-semibold text-gold transition-colors hover:text-gold-light hover:underline focus-visible:focus-ring"
                        >
                          <span>Read the full guide</span>
                        </a>
                      </div>
                    )}
                  </div>
                </details>
              ))
            }
          </div>

          {/* Empty State when Search yields no results */}
          <div id="faq-empty-state" class="hidden py-16 text-center">
            <p class="text-body text-text-tertiary">No questions match your search.</p>
            <button
              type="button"
              id="faq-reset-search"
              class="mt-3 cursor-pointer rounded text-small font-semibold text-gold hover:underline focus-visible:focus-ring"
            >
              Clear search
            </button>
          </div>

          {/* Technical Manual Cross-link Section */}
          <CrossLinkRow
            className="mt-14 pt-10"
            eyebrow="Technical catalog"
            title="Want more technical detail?"
            body="Browse all 27 features, with exact sample rates, bit depths and filters."
            href={withBase('/features/catalog')}
            cta="See all 27 features"
          />
        </div>
      </div>
    </Container>
  </section>

  <ClosingBanner
    eyebrow="Support"
    title="Have a question about your DAC or phone?"
    description="Send us your DAC or phone model and what the signal badge shows. We will help you check the setup."
    primaryHref="mailto:support@bit-perfect.com"
    primaryLabel="Ask about your setup"
    secondaryHref={site.playUrl}
    secondaryLabel="Get it on Google Play"
    secondaryExternal={true}
  />
</ContentLayout>

<script>
  function setupFaqInteractions() {
    const nav = document.getElementById('faq-category-nav');
    // The immediate call and `astro:page-load` both land on a first visit;
    // the flag keeps one set of listeners per rendered page.
    if (!nav || nav.dataset.bound === 'true') return;
    nav.dataset.bound = 'true';

    const searchInput = document.getElementById('faq-search') as HTMLInputElement | null;
    const catButtons = nav.querySelectorAll<HTMLButtonElement>('.faq-cat-btn');
    const items = document.querySelectorAll<HTMLDetailsElement>('.faq-accordion-item');
    const emptyState = document.getElementById('faq-empty-state');
    const resetBtn = document.getElementById('faq-reset-search');
    const desktop = window.matchMedia('(min-width: 1024px)');

    let currentCategory = 'all';
    let currentQuery = '';

    function filterFaqs() {
      let visibleCount = 0;

      items.forEach((item) => {
        const itemCategory = item.getAttribute('data-faq-category') || '';
        const itemKeywords = item.getAttribute('data-faq-keywords') || '';

        const matchesCat = currentCategory === 'all' || itemCategory === currentCategory;
        const matchesQuery = !currentQuery || itemKeywords.includes(currentQuery);

        item.hidden = !(matchesCat && matchesQuery);
        if (!item.hidden) visibleCount++;
      });

      emptyState?.classList.toggle('hidden', visibleCount > 0);
    }

    catButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentCategory = btn.getAttribute('data-category-filter') || 'all';
        catButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        filterFaqs();

        // Phones: bring a half-hidden chip fully into the strip. Desktop: the
        // sidebar is sticky and already in view, so nothing should move.
        if (!desktop.matches) {
          btn.scrollIntoView({ inline: 'nearest', block: 'nearest' });
        }
      });
    });

    // Open target FAQ item if hash is present in URL
    if (window.location.hash) {
      const targetId = window.location.hash.slice(1);
      const targetDetails = document.getElementById(targetId) as HTMLDetailsElement | null;
      if (targetDetails && targetDetails.classList.contains('faq-accordion-item')) {
        targetDetails.open = true;
        targetDetails.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    searchInput?.addEventListener('input', () => {
      currentQuery = searchInput.value.trim().toLowerCase();
      filterFaqs();
    });

    if (resetBtn && searchInput) {
      resetBtn.addEventListener('click', () => {
        searchInput.value = '';
        currentQuery = '';
        filterFaqs();
      });
    }
  }

  setupFaqInteractions();
  document.addEventListener('astro:page-load', setupFaqInteractions);
</script>

<style>
  /* Phones and tablets: one column, the categories a single scrolling strip. */
  .faq-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .faq-main {
    min-width: 0;
  }

  /* The label is for the desktop sidebar; on phones the strip explains itself.
     It stays in the DOM because the group is labelled by it. */
  .faq-nav-title {
    display: none;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .faq-nav {
    /* Positioned so the `sr-only` count suffixes (absolute) are clipped by
       the strip; unpositioned, they escaped it and widened the phone viewport. */
    position: relative;
    display: flex;
    gap: 0.25rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    /* Bleed to the screen edge so a cut-off chip reads as "more this way",
       then pad back so the first chip sits on the page gutter. */
    margin-inline: -1.25rem;
    padding-inline: 1.25rem;
    scroll-padding-inline: 1.25rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .faq-nav::-webkit-scrollbar {
    display: none;
  }

  .faq-cat-btn {
    flex: none;
    display: inline-flex;
    /* Baseline, not centre: the smaller count digits otherwise ride high.
       The vertical padding does the centring inside the 44px target. */
    align-items: baseline;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.75rem 0.75rem;
    /* Sits on the strip's hairline so the gold underline replaces it. */
    margin-bottom: -1px;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
    scroll-snap-align: start;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition:
      color var(--d-ui) var(--ease-ui),
      border-color var(--d-ui) var(--ease-ui),
      background-color var(--d-ui) var(--ease-ui);
  }
  /* A mouse click leaves focus on the button; only the keyboard gets a ring. */
  .faq-cat-btn:focus:not(:focus-visible) {
    outline: none;
  }
  .faq-cat-btn:hover {
    color: var(--color-text-primary);
  }
  .faq-cat-btn[aria-pressed='true'] {
    color: var(--color-gold);
    border-bottom-color: var(--color-gold);
  }

  .faq-cat-count {
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-tertiary);
  }

  @media (min-width: 640px) {
    .faq-nav {
      margin-inline: -2rem;
      padding-inline: 2rem;
      scroll-padding-inline: 2rem;
    }
  }

  /* Desktop: sidebar with same grid, rail and link states. */
  @media (min-width: 1024px) {
    .faq-grid {
      display: grid;
      grid-template-columns: 280px minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }

    .faq-main {
      max-width: 760px;
    }

    .faq-nav-wrapper {
      position: sticky;
      top: 6.5rem;
      max-height: calc(100vh - 8rem);
      overflow-y: auto;
      /* Top pad lines the label up with the first question row (py-6). */
      padding: 1rem 0.5rem 0 0;
    }

    .faq-nav-title {
      display: flex;
      align-items: center;
      min-height: 2.75rem;
      margin-bottom: 0.5rem;
    }

    .faq-nav {
      flex-direction: column;
      overflow: visible;
      scroll-snap-type: none;
      margin: 0.5rem 0 0;
      padding: 0;
      border-bottom: none;
      border-left: 2px solid var(--color-border-subtle);
    }

    .faq-cat-btn {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.75rem 1rem;
      margin: 0 0 0 -2px;
      border-bottom: none;
      border-left: 2px solid transparent;
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
      white-space: normal;
      text-align: left;
      line-height: 1.4;
      font-weight: 400;
      color: var(--color-text-tertiary);
    }
    .faq-cat-btn:hover {
      color: var(--color-text-primary);
      background: rgba(255, 255, 255, 0.04);
      border-left-color: rgba(232, 184, 75, 0.6);
    }
    .faq-cat-btn[aria-pressed='true'] {
      color: var(--color-gold);
      border-left-color: var(--color-gold);
      background: rgba(232, 184, 75, 0.08);
      font-weight: 500;
    }
  }
</style>
