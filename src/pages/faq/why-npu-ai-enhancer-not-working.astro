---
import ContentLayout from '../../layouts/ContentLayout.astro';
import Container from '../../components/common/Container';
import PageHeader from '../../components/common/PageHeader.astro';
import ClosingBanner from '../../components/common/ClosingBanner.astro';
import { withBase } from '../../utils/nav';

const title = 'Why AI Enhancer Requires an NPU & Troubleshooting Guide | Bitperfect Player';
const description =
  'Detailed technical explanation of why Bitperfect Player AI Enhancer requires a hardware NPU, manufacturer firmware restrictions (e.g. Motorola), and USB DAC setup guide.';
---

<ContentLayout title={title} description={description}>
  <PageHeader
    maxWidth="760px"
    backHref={withBase('/faq')}
    backLabel="Back to Knowledge Base & FAQ"
    eyebrow="Hardware & Driver Guide"
    title="Why AI Enhancer Requires a Dedicated Hardware NPU"
    description="How on-device neural audio restoration works, why mobile CPUs cannot run it in real time, and why the toggle may be disabled on your phone."
  />

  {/* Main Centered Editorial Column */}
  <section class="py-12 lg:py-20">
    <Container>
      <article class="mx-auto max-w-[760px] space-y-14">
        {/* Section 1: The Core NPU Requirement */}
        <div id="the-real-time-neural-challenge">
          <h2 class="text-title-lg font-bold text-text-primary text-balance">
            The Real-Time Neural Challenge
          </h2>
          <div class="mt-4 space-y-4 text-body text-pretty text-text-secondary leading-relaxed">
            <p>
              AI Enhancer is a deep neural network, not an EQ curve or exciter. It analyzes compressed frames to reconstruct harmonic overtones and phase coherence lost in MP3 and AAC files.
            </p>
            <p>
              Processing 44.1 kHz or 48 kHz stereo audio in real time requires billions of tensor operations per second. Running this workload on a mobile CPU drains the battery and causes immediate buffer dropouts.
            </p>
            <p>
              To guarantee drop-free playback, AI Enhancer runs exclusively on a dedicated <strong>Neural Processing Unit (NPU)</strong> or Hexagon DSP.
            </p>
          </div>
        </div>

        {/* Section 2: Three Reasons AI Enhancer May Be Disabled — Clean Editorial Hairlines, Zero Nested Boxes */}
        <div id="three-reasons" class="border-t border-border-subtle pt-12">
          <h2 class="text-title-lg font-bold text-text-primary text-balance">
            Three Reasons AI Enhancer May Be Disabled on Your Phone
          </h2>
          <p class="mt-3 text-body text-pretty text-text-secondary leading-relaxed">
            If the AI Enhancer toggle is greyed out in Bitperfect Player, your device matches one of three hardware or firmware conditions:
          </p>

          <div class="mt-8 border-b border-border-subtle">
            {/* Reason 01 */}
            <div class="border-t border-border-subtle py-7">
              <div>
                <h3 class="text-body-lg font-bold text-text-primary">
                  Device Lacks a Dedicated NPU Hardware Processor
                </h3>
                <p class="mt-2 text-body-sm text-pretty text-text-secondary leading-relaxed">
                  Entry-level System-on-Chips (SoCs) lack a dedicated neural processor. Without INT8/FP16 matrix acceleration hardware, the engine disables AI Enhancer to protect battery life and playback stability.
                </p>
              </div>
            </div>

            {/* Reason 02 */}
            <div class="border-t border-border-subtle py-7">
              <div>
                <h3 class="text-body-lg font-bold text-text-primary">
                  Device Is Too New & Neural Models Are Still Being Optimized
                </h3>
                <p class="mt-2 text-body-sm text-pretty text-text-secondary leading-relaxed">
                  New flagship processors (such as recent Qualcomm Snapdragon or MediaTek Dimensity chips) introduce updated NPU instruction sets and NNAPI/QNN drivers. Our team profiles and quantizes custom model weights for each new chip before enabling playback in an app update.
                </p>
              </div>
            </div>

            {/* Reason 03 */}
            <div class="border-t border-border-subtle py-7">
              <div>
                <h3 class="text-body-lg font-bold text-text-primary">
                  Manufacturer Firmware Locks Down 3rd-Party NPU Access (e.g. Motorola)
                </h3>
                <p class="mt-2 text-body-sm text-pretty text-text-secondary leading-relaxed">
                  Some manufacturers, notably <strong>Motorola</strong> on select Edge and Razr phones, include NPU silicon but block third-party apps from accessing the neural runtime in firmware. System camera apps can use the NPU, while user-space audio apps are restricted.
                </p>
                <p class="mt-3 text-body-sm text-pretty text-text-secondary leading-relaxed">
                  Affected Motorola users can request standard Android NNAPI access for third-party audio apps on the official Lenovo support thread:
                </p>
                <a
                  href="https://forums.lenovo.com/topic/view/16436/10046553"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-3 inline-flex items-center gap-1.5 rounded text-small font-semibold text-gold transition-colors duration-[var(--d-ui)] hover:text-gold-light hover:underline focus-visible:focus-ring"
                >
                  <span>Lenovo / Motorola Forum Thread: Request NPU Access</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>

        {/* Section 3: USB DAC Setup & Troubleshooting — Clean 2x2 Architectural Hairline Grid */}
        <div id="usb-dac-setup" class="border-t border-border-subtle pt-12">
          <h2 class="text-title-lg font-bold text-text-primary text-balance">
            USB DAC Setup & Hardware Guide
          </h2>
          <p class="mt-3 text-body text-pretty text-text-secondary leading-relaxed">
            Connecting an external USB DAC to an Android phone requires meeting four straightforward physical and software prerequisites:
          </p>

          <div class="mt-8 grid grid-cols-1 gap-x-10 gap-y-8 sm:grid-cols-2">
            <div class="border-t border-border-subtle pt-5">
              <span class="mono-spec text-caption font-semibold text-gold uppercase tracking-wider">
                Hardware Requirement
              </span>
              <h3 class="mt-2 text-body-lg font-bold text-text-primary">OTG Host Cable</h3>
              <p class="mt-2 text-small text-pretty text-text-secondary leading-relaxed">
                Always use an OTG-certified USB-C or Micro-USB cable. A standard charging cable lacks the ID pin wiring required for the phone to switch from USB Device mode into USB Host mode.
              </p>
            </div>

            <div class="border-t border-border-subtle pt-5">
              <span class="mono-spec text-caption font-semibold text-gold uppercase tracking-wider">
                Android Dialog
              </span>
              <h3 class="mt-2 text-body-lg font-bold text-text-primary">USB Permission Prompt</h3>
              <p class="mt-2 text-small text-pretty text-text-secondary leading-relaxed">
                When the DAC is plugged in, tap "Always allow" on the Android system prompt. This grants Bitperfect Player exclusive control over the raw USB endpoint.
              </p>
            </div>

            <div class="border-t border-border-subtle pt-5">
              <span class="mono-spec text-caption font-semibold text-gold uppercase tracking-wider">
                Signal Control
              </span>
              <h3 class="mt-2 text-body-lg font-bold text-text-primary">Hardware Volume vs Software</h3>
              <p class="mt-2 text-small text-pretty text-text-secondary leading-relaxed">
                Bitperfect Player supports direct UAC2 hardware volume commands. If your DAC has internal hardware attenuation, Bitperfect Player drives it directly, preserving full digital bit depth.
              </p>
            </div>

            <div class="border-t border-border-subtle pt-5">
              <span class="mono-spec text-caption font-semibold text-gold uppercase tracking-wider">
                Telemetry Check
              </span>
              <h3 class="mt-2 text-body-lg font-bold text-text-primary">Bit-Perfect Status</h3>
              <p class="mt-2 text-small text-pretty text-text-secondary leading-relaxed">
                Check the real-time status indicator on the Now Playing screen. When connected directly to your DAC, the indicator confirms bit-perfect playback at the exact source sample rate (e.g. 96 kHz or DSD128).
              </p>
            </div>
          </div>
        </div>

        {/* Section 4: Bitperfect Lock & Direct Bypass */}
        <div id="bitperfect-lock-bypass" class="border-t border-border-subtle pt-12">
          <h2 class="text-title-lg font-bold text-text-primary text-balance">
            Bitperfect Lock & Direct Hardware Bypass
          </h2>
          <div class="mt-4 space-y-4 text-body text-pretty text-text-secondary leading-relaxed">
            <p>
              <strong>Why direct hardware bypass matters:</strong> Standard Android audio routes every sound stream through <code>AudioFlinger</code>. <code>AudioFlinger</code> enforces a mandatory 48 kHz resampling filter, applies software digital dither, and compresses dynamic peaks to prevent speaker clipping.
            </p>
            <p>
              Bitperfect Player writes directly to the USB Audio Class isochronous endpoints using its own custom Rust driver stack. Samples travel untouched from the decoder buffer to the DAC hardware converter.
            </p>
            <p>
              <strong>What Bitperfect Lock does:</strong> For critical listening sessions, Bitperfect Lock locks all software volume sliders, disables the 32-band Parametric EQ, disengages crossfeed, and shuts off all software DSP. In this mode, no accidental touch can alter a single bit of your audio stream.
            </p>
          </div>
        </div>

        {/* Section 5: Battery Optimization */}
        <div id="battery-optimization" class="border-t border-border-subtle pt-12">
          <h2 class="text-title-lg font-bold text-text-primary text-balance">
            Battery Consumption & Background Playback
          </h2>
          <div class="mt-4 space-y-4 text-body text-pretty text-text-secondary leading-relaxed">
            <p>
              External USB DAC dongles are bus-powered devices. They draw operating current (often 150 mA to 400 mA) straight from your phone's battery to power their DAC chips and headphone amplifier stages.
            </p>
            <h3 class="text-body-lg font-bold text-text-primary pt-2">
              Preventing Background Playback Termination
            </h3>
            <p>
              Modern Android versions employ aggressive battery management daemons that terminate foreground media services when the screen turns off. To ensure uninterrupted high-resolution streaming:
            </p>
            <ol class="list-decimal list-inside space-y-2 text-small pl-2">
              <li>Navigate to Android <strong>Settings &gt; Apps &gt; Bitperfect Player &gt; Battery</strong>.</li>
              <li>Change the setting from <em>Optimized</em> to <strong>Unrestricted</strong>.</li>
              <li>In your phone's app switcher, long-press the Bitperfect Player card and select <strong>Lock App</strong>.</li>
              <li>Enable <strong>Full RAM Playback</strong> in Bitperfect Player settings to load tracks into RAM and minimize flash memory power draw.</li>
            </ol>
          </div>
        </div>
      </article>
    </Container>
  </section>

  <ClosingBanner
    maxWidth="760px"
    eyebrow="Still Have Questions?"
    title="Contact Audio Engineering Support"
    description="Our engineering team answers DAC compatibility, NPU hardware, and technical audio questions directly."
    primaryHref="mailto:support@bit-perfect.com"
    primaryLabel="Email Engineering Support"
    secondaryHref={withBase('/faq')}
    secondaryLabel="Read All FAQs"
  />
</ContentLayout>
