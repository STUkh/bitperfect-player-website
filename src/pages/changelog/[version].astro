---
import ContentLayout from '../../layouts/ContentLayout.astro';
import Container from '../../components/common/Container';
import PageHeader from '../../components/common/PageHeader.astro';
import ClosingBanner from '../../components/common/ClosingBanner.astro';
import { releases, type Release } from '../../data/changelog';
import { site } from '../../data/site';
import { withBase } from '../../utils/nav';

export function getStaticPaths() {
  return releases.map((release) => ({
    params: { version: release.version },
    props: { release },
  }));
}

interface Props {
  release: Release;
}

const { release } = Astro.props;

const title = `Bitperfect Player v${release.version} Release Notes | ${release.title}`;
const description = `Detailed changelog and architectural documentation for Bitperfect Player version ${release.version}: ${release.summary}`;
---

<ContentLayout title={title} description={description}>
  <PageHeader
    maxWidth="760px"
    title={release.title}
    description={release.summary}
  >
    <div slot="meta">
      {/* Breadcrumb Trail */}
      <nav class="flex items-center gap-2 text-caption text-text-tertiary" aria-label="Breadcrumb">
        <a href={withBase('/changelog')} class="inline-flex items-center min-h-[44px] rounded hover:text-gold transition-colors focus-visible:focus-ring">
          Changelog
        </a>
        <span>/</span>
        <span class="text-text-secondary font-medium">Version {release.version}</span>
      </nav>

      <div class="mt-4 flex flex-wrap items-center gap-3">
        <span class="mono-spec text-headline-sm-m font-extrabold text-gold sm:text-section-sm">
          v{release.version}
        </span>
        <span class="mono-spec text-caption text-text-tertiary">
          Released {release.releaseDate}
        </span>
        {release.badge && (
          <span class="mono-spec text-micro font-semibold uppercase tracking-wider text-gold">
            · {release.badge}
          </span>
        )}
        <span class="mono-spec text-caption text-text-tertiary">
          · Android 8.0 to 15+
        </span>
      </div>
    </div>
  </PageHeader>

  {/* Main Centered Single-Column Content — Zero Nested Boxes */}
  <section class="py-12 lg:py-20">
    <Container>
      <article class="mx-auto max-w-[760px]">
        {/* Categorized Changes */}
        <div class="space-y-12">
          {release.categories.map((cat) => (
            <div class="border-t border-border-subtle pt-8 first:border-t-0 first:pt-0">
              <h2 class="text-title-lg font-bold text-text-primary">
                {cat.label}
              </h2>
              <div class="mt-4 divide-y divide-border-subtle/50">
                {cat.items.map((item) => (
                  <div class="py-4 first:pt-2 last:pb-0">
                    <h3 class="text-body font-semibold text-text-primary">
                      {item.title}
                    </h3>
                    {item.description && (
                      <p class="mt-1 text-small text-pretty text-text-secondary leading-relaxed">
                        {item.description}
                      </p>
                    )}
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </article>
    </Container>
  </section>

  <ClosingBanner
    maxWidth="760px"
    eyebrow="Deep Architecture"
    title={`Update to v${release.version} on Google Play`}
    description="Experience our custom Rust Symphonia engine, UAC1/UAC2 hardware drivers, and 64-bit dyadic volume control."
    primaryHref={site.playUrl}
    primaryLabel="Update on Google Play"
    primaryExternal={true}
    secondaryHref={withBase('/features/catalog')}
    secondaryLabel="Explore 27 Features"
  />
</ContentLayout>
