---
/**
 * Every path that is not `/`, `/privacy`, `/terms` or `/policy` lands here while
 * the site is parked, which is most of the site: the six feature routes and the
 * features index no longer build. So the 404 is not a dead end with a joke on it
 * any more, it is the holding page with an extra sentence, and its three exits
 * are the three destinations that still exist.
 *
 * The page it replaces is kept at `src/pages/_404.astro` and comes back with the
 * rest of the site.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HoldingPage from '../components/HoldingPage.astro';
---

<BaseLayout
  title="Page not found"
  description="This page is not here while the Bitperfect Player site is being rebuilt. The player, the privacy policy and the terms of use are."
  noindex
>
  <HoldingPage
    eyebrow="Under construction"
    headline="Nothing on this path."
    lede="This page is parked while the site is rebuilt. The player, the privacy policy and the terms of use are still here."
  />
</BaseLayout>
