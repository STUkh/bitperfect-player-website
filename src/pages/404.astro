---
import ContentLayout from '../layouts/ContentLayout.astro';
import Icon from '../components/Icon';
import Button from '../components/common/Button';
import { withBase } from '../utils/nav';
import { useTranslations } from '../i18n/utils';

const t = useTranslations(Astro.currentLocale);
---

<ContentLayout
  title={t('notfound.title')}
  description={t('notfound.description')}
  noindex
>
  <section class="lost">
    <div class="inner">
      <p class="text-xs text-text-tertiary uppercase tracking-widest font-mono">{t('notfound.code')}</p>
      <h1 class="heading-section">{t('notfound.heading')}</h1>
      <p class="text-text-secondary max-w-96">
        {t('notfound.body')}
      </p>
      <div class="actions">
        <Button href={withBase('/')} variant="primary" className="gap-2 btn-back">
          <Icon name="arrow" size={20} />
          <span>{t('notfound.back')}</span>
        </Button>
        <Button href={withBase('/features')} variant="secondary">
          <span>{t('notfound.all_features')}</span>
        </Button>
      </div>
    </div>
  </section>
</ContentLayout>

<style>
  .lost {
    min-height: 70vh;
    display: grid;
    place-items: center;
    text-align: center;
    padding-block: 6rem;
  }

  .inner {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 1rem;
  }

  :global(.btn-back .icon) {
    transform: rotate(180deg);
  }
</style>
