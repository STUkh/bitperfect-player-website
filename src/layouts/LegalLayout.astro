---
interface Props {
  title: string;
  description: string;
  lastUpdated?: string;
  noindex?: boolean;
  containerClass?: string;
}

import BaseLayout from './BaseLayout.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import Container from '../components/common/Container.astro';

const { title, description, lastUpdated, noindex, containerClass = 'max-w-6xl lg:max-w-7xl' } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <Header />
  <main id="main-content" class="relative min-h-screen pt-28 pb-20">
    <div id="grid-bg" aria-hidden="true">
      <div class="grid-cell-glow glow-1"></div>
      <div class="grid-cell-glow glow-2"></div>
      <div class="grid-cell-glow glow-3"></div>
    </div>
    <Container class={containerClass}>
      <article class="prose-legal">
        <header class="mb-10">
          <h1>{title}</h1>
          {
            lastUpdated && (
              <p class="mt-2 text-sm text-text-tertiary">Last updated: {lastUpdated}</p>
            )
          }
        </header>
        <slot />
      </article>
    </Container>
  </main>
  <Footer />
</BaseLayout>
