---
interface Props {
  title: string;
  description: string;
  lastUpdated?: string;
  noindex?: boolean;
  containerClass?: string;
}

import BaseLayout from './BaseLayout.astro';
import Header from '../components/chrome/Header.astro';
import Footer from '../components/chrome/Footer';
import Container from '../components/primitives/Container';

const { title, description, lastUpdated, noindex, containerClass = 'max-w-6xl lg:max-w-7xl' } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <Header />
  <main id="main-content" class="relative min-h-screen pt-28 pb-20">
    <Container className={containerClass}>
      <article class="prose-legal">
        <header class="mb-10">
          <h1>{title}</h1>
          {
            lastUpdated && (
              <p class="mt-2 text-sm text-text-tertiary">Last updated: {lastUpdated}</p>
            )
          }
        </header>
        <slot />
      </article>
    </Container>
  </main>
  <Footer pathname={Astro.url.pathname} locale={Astro.currentLocale} />
</BaseLayout>

<style>
  /* Links inside the rendered markdown are generated, so they cannot carry a
     utility class. Their colour hover lives in global.css; this is the focus
     ring and the pressed state that go with it, matching the site's one
     `focus-ring` treatment rather than inventing a second. */
  :global(.prose-legal a) {
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: color var(--d-ui) var(--ease-ui);
  }
  :global(.prose-legal a:active) {
    color: var(--color-gold-deep);
  }
  :global(.prose-legal a:focus-visible) {
    /* Reads the same override hook every other ring on the site reads, rather
       than hardcoding gold and going invisible if this prose ever lands on a
       light ground. */
    outline: 2px solid var(--focus-ring-color, var(--color-gold));
    outline-offset: 2px;
  }
</style>
