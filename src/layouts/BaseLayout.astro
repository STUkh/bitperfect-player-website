---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}

import SEOHead from '../components/common/SEOHead.astro';
import { withBase } from '../utils/nav';
import '../styles/global.css';
import '../styles/animations.css';

const { title, description, canonical, ogImage, noindex } = Astro.props;

/* Chromium prerenders an internal page once the pointer rests on its link
   (`moderate`: ~200ms hover, or pointerdown on touch), so the click lands on a
   page that has already loaded, laid out and painted. Static pages, no state to go
   stale. The two meta-refresh aliases are skipped: prerendering a redirect spends
   the budget (two at a time) on a page nobody sees. Other browsers ignore the
   block and get Astro's hover prefetch instead (astro.config.mjs). */
const speculation = {
  prerender: [
    {
      where: {
        and: [
          { href_matches: withBase('*') },
          { not: { href_matches: withBase('policy') } },
          { not: { href_matches: withBase('faq/npu-ai-enhancer') } },
          { not: { selector_matches: '[download], [target=_blank], [rel~=external]' } },
        ],
      },
      eagerness: 'moderate',
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#191919" />
    <link rel="icon" type="image/png" href={withBase('favicon-96x96.png')} sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('site.webmanifest')} />
    <link
      rel="preload"
      href={withBase('fonts/Manrope-Variable.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <SEOHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      noindex={noindex}
    />
    <script type="speculationrules" is:inline set:html={JSON.stringify(speculation)} />
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main-content"
      style="--focus-ring-color: var(--color-on-gold)"
      class="sr-only cursor-pointer transition-colors duration-[var(--d-ui)] ease-ui hover:bg-gold-light active:bg-gold-deep focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[200] focus:rounded-chip focus:bg-gold focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-on-gold focus-visible:focus-ring-inset"
    >
      Skip to main content
    </a>
    <slot />
  </body>
</html>
