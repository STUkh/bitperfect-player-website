---
interface Props {
  title: string;
  description: string;
}

import ContentLayout from './ContentLayout.astro';
import { site, pro } from '../data/site';
import { withBase } from '../utils/nav';

const { title, description } = Astro.props;

/* Astro.site (astro.config.mjs) + the base path is the site's real deployed
 * origin: site.ts has no `url` field, it only holds product constants. */
const siteUrl = new URL(withBase(''), Astro.site).href;
const logoUrl = new URL(withBase('brand/logo.png'), Astro.site).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: siteUrl,
  logo: logoUrl,
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: siteUrl,
};

/* ONE offer, because there is one plan: an auto-renewing annual subscription at
 * USD 35 (src/TERMS_OF_USE.md §4.1 and §4.3). The three-period map this built
 * from is kept as a map so a restored second term needs no edit here, and the
 * word `Pro` is gone from the description with the tier it named.
 *
 * The 7-day trial is deliberately NOT modelled here. Eligibility is the store's
 * decision, one trial per store account (Terms §4.2), so a rich result promising
 * it to every searcher would be a claim the store refuses to honour for
 * returning customers. No aggregateRating / ratingValue either: inventing a
 * rating is a structured-data policy violation (BRIEF.md §4.1). */
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  description,
  url: siteUrl,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Android 8.0+',
  offers: pro.periods.map((period) => ({
    '@type': 'Offer',
    name: `${pro.name} - ${period.label}`,
    price: period.price,
    priceCurrency: pro.currency,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: period.price,
      priceCurrency: pro.currency,
      billingDuration: period.months,
      unitCode: 'MON',
    },
  })),
};
---

<ContentLayout title={title} description={description}>
  <script
    type="application/ld+json"
    is:inline
    slot="head-extra"
    set:html={JSON.stringify(orgSchema)}
  />
  <script
    type="application/ld+json"
    is:inline
    slot="head-extra"
    set:html={JSON.stringify(websiteSchema)}
  />
  <script
    type="application/ld+json"
    is:inline
    slot="head-extra"
    set:html={JSON.stringify(softwareSchema)}
  />
  <slot />
</ContentLayout>
