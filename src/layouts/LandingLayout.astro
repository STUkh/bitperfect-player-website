---
interface Props {
  title: string;
  description: string;
}

import ContentLayout from './ContentLayout.astro';
import { site, pro } from '../data/site';
import { withBase } from '../utils/nav';

const { title, description } = Astro.props;

/* Astro.site (astro.config.mjs) + the base path is the site's real deployed
 * origin: site.ts has no `url` field, it only holds product constants. */
const siteUrl = new URL(withBase(''), Astro.site).href;
const logoUrl = new URL(withBase('brand/logo.png'), Astro.site).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: siteUrl,
  logo: logoUrl,
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: siteUrl,
};

/* ONE plan, ONE term: annual subscription. Founder offer at $19.95 USD / year
 * until May 31, 2027; standard price $29.95 USD / year from June 1, 2027.
 *
 * The 14-day trial is deliberately NOT modelled here. Eligibility is the store's
 * decision, roughly one trial per store account, so a rich result promising
 * it to every searcher would be a claim the store refuses to honour for
 * returning customers. No aggregateRating / ratingValue either: inventing a
 * rating is a structured-data policy violation. */
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'AudioApplication, SoftwareApplication',
  name: site.name,
  description,
  url: siteUrl,
  installUrl: site.playUrl,
  applicationCategory: 'AudioApplication',
  operatingSystem: 'Android 8.0 and up',
  featureList: [
    'Direct bit-perfect USB Audio Class 1 and 2 output bypassing Android\'s system mixer',
    'PCM playback up to 768 kHz and 32-bit, DAC permitting',
    'DSD playback up to DSD512 via DoP or Native DSD, DAC permitting',
    'Five honest real-time signal states (Bit-perfect, Enhanced, Resampled, Lossy, Unknown)',
    '32-band parametric equaliser with 7 filter shapes',
    'DSP rack with crossfeed, loudness correction and true-peak limiter',
    'Local lossless library indexing internal storage, MicroSD and network shares',
    'Two-way streaming: DLNA casting and network receiver mode',
    'Optional on-device AI Enhancer for 44.1 and 48 kHz tracks (off by default)',
    'On-device Sonic Scan and Similar Tracks running offline',
    'Private audio playback: no account needed, no ads, no tracking',
  ],
  offers: [
    {
      '@type': 'Offer',
      name: `${pro.name} - Founder offer`,
      price: pro.founderPrice,
      priceCurrency: pro.currency,
      priceValidUntil: pro.founderEndDateIso,
      url: site.playUrl,
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: pro.founderPrice,
        priceCurrency: pro.currency,
        billingDuration: 12,
        unitCode: 'MON',
      },
    },
    {
      '@type': 'Offer',
      name: `${pro.name} - Standard annual plan`,
      price: pro.standardPrice,
      priceCurrency: pro.currency,
      url: site.playUrl,
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: pro.standardPrice,
        priceCurrency: pro.currency,
        billingDuration: 12,
        unitCode: 'MON',
      },
    },
  ],
};
---

<ContentLayout title={title} description={description}>
  <script
    type="application/ld+json"
    is:inline
    slot="head-extra"
    set:html={JSON.stringify(orgSchema)}
  />
  <script
    type="application/ld+json"
    is:inline
    slot="head-extra"
    set:html={JSON.stringify(websiteSchema)}
  />
  <script
    type="application/ld+json"
    is:inline
    slot="head-extra"
    set:html={JSON.stringify(softwareSchema)}
  />
  <slot />
</ContentLayout>
