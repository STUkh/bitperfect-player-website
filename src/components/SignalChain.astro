---
import Icon from './Icon.astro';

export interface Props {
  id?: string;
  class?: string;
}

const { id, class: cls = '' } = Astro.props;

const nodes = [
  { icon: 'node-file', label: 'Source file', detail: 'Lossless audio stream', spec: 'FLAC 24/192' },
  { icon: 'node-engine', label: 'Bitperfect engine', detail: 'Direct audio engine', spec: 'No resampling' },
  { icon: 'node-usb', label: 'Exclusive USB', detail: 'System mixer bypassed', spec: 'UAC2 direct' },
  { icon: 'node-dac', label: 'Your DAC', detail: 'Direct hardware lock', spec: '24/192 kHz' },
];
---

<div class={`chain glass ${cls}`} id={id ?? 'signal-chain'}>
  <ol class="nodes">
    {
      nodes.map((n, i) => (
        <li class="node" style={`--i:${i}`}>
          <span class="box">
            <Icon name={n.icon as any} size={22} />
          </span>
          <div class="node-text">
            <span class="label">{n.label}</span>
            <span class="spec font-mono">{n.spec}</span>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="verdict">
    <span class="v-mark"><Icon name="sig-bitperfect" size={18} /></span>
    <span class="v-label">Bit-perfect</span>
    <span class="v-note">Output identical to source. Nothing resampled, nothing mixed, nothing scaled.</span>
  </div>
</div>

<script>
  const chain = document.querySelector('.chain');
  if (chain && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    chain.classList.add('pending');
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            chain.classList.remove('pending');
            io.disconnect();
          }
        }
      },
      { threshold: 0.25 },
    );
    io.observe(chain);
  }
</script>

<style>
  .chain {
    padding: 1.5rem 1.25rem;
    border-radius: var(--radius-card, 12px);
    background: var(--color-glass-surface);
    border: 1px solid var(--color-border-subtle);
  }

  .nodes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.25rem;
  }

  .node {
    display: grid;
    grid-template-columns: 48px 1fr;
    column-gap: 1rem;
    align-items: center;
    position: relative;
  }

  /* Vertical connector on small screens */
  .node:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 23px;
    top: 48px;
    width: 2px;
    height: calc(100% + 1.25rem - 48px);
    background: linear-gradient(180deg, var(--color-gold) 0%, rgba(229, 184, 66, 0.7) 100%);
    opacity: 0.85;
    transform-origin: top;
    transition:
      opacity 0.3s var(--ease-out-expo),
      transform 0.3s var(--ease-out-expo);
    transition-delay: calc(var(--i) * 120ms + 80ms);
  }

  .node:nth-last-child(2)::after {
    background: linear-gradient(180deg, var(--color-gold) 0%, var(--color-bitperfect) 100%);
    opacity: 0.95;
  }

  .box {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    border: 1px solid var(--color-border-subtle);
    background: rgba(255, 255, 255, 0.03);
    color: var(--color-gold);
    transition:
      border-color 0.22s var(--ease-out-expo),
      color 0.22s var(--ease-out-expo),
      background-color 0.22s var(--ease-out-expo);
    transition-delay: calc(var(--i) * 120ms);
  }

  .node:last-child .box {
    border-color: var(--color-bitperfect);
    color: var(--color-bitperfect);
    background: color-mix(in srgb, var(--color-bitperfect) 12%, transparent);
  }

  /* Dormant state */
  .chain.pending .box {
    border-color: var(--color-border-subtle);
    color: var(--color-text-tertiary);
    background: rgba(255, 255, 255, 0.02);
  }
  .chain.pending .node:last-child .box {
    border-color: var(--color-border-subtle);
    color: var(--color-text-tertiary);
    background: rgba(255, 255, 255, 0.02);
  }
  .chain.pending .node::after {
    opacity: 0;
    transform: scaleY(0);
  }
  .chain.pending .verdict {
    opacity: 0;
    transform: translateY(6px);
  }

  .node-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .label {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .spec {
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--color-text-tertiary);
    text-transform: uppercase;
  }

  .verdict {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.875rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border-subtle);
    transition:
      opacity 0.3s var(--ease-out-expo),
      transform 0.3s var(--ease-out-expo);
    transition-delay: 600ms;
  }

  .v-mark {
    display: inline-flex;
    color: var(--color-bitperfect);
  }

  .v-label {
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-bitperfect);
  }

  .v-note {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    flex: 1 1 16rem;
  }

  /* Horizontal chain for tablet/desktop */
  @media (min-width: 768px) {
    .chain {
      padding: 2rem 1.75rem;
    }
    .nodes {
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
    }
    .node {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      row-gap: 0.625rem;
    }
    .node:not(:last-child)::after {
      left: calc(50% + 26px);
      top: 24px;
      width: calc(100% - 52px);
      height: 2px;
      background: linear-gradient(90deg, var(--color-gold) 0%, rgba(229, 184, 66, 0.7) 100%);
      transform-origin: left;
      opacity: 0.85;
    }
    .node:nth-last-child(2)::after {
      background: linear-gradient(90deg, var(--color-gold) 0%, var(--color-bitperfect) 100%);
      opacity: 0.95;
    }
    .chain.pending .node::after {
      transform: scaleX(0);
    }
  }
</style>
