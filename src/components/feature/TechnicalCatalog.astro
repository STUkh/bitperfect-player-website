---
/*
  The site's entry to the React `TechnicalCatalog`: it renders the catalog and
  mounts the filter tabs' behaviour, which the static render cannot carry
  (nothing hydrates). Claude Design renders `TechnicalCatalog.tsx` directly,
  where `useBehaviour` mounts it.
*/
import TechnicalCatalog, { type TechnicalCatalogProps } from './TechnicalCatalog.tsx';

type Props = TechnicalCatalogProps;
---

<TechnicalCatalog {...Astro.props} />

<script>
  import { setupCatalogFilter } from './TechnicalCatalog.client';

  let cleanups: (() => void)[] = [];
  function setupCatalogs() {
    cleanups.forEach((cleanup) => cleanup());
    cleanups = Array.from(document.querySelectorAll<HTMLElement>('[data-technical-catalog]'), setupCatalogFilter);
  }

  // Run on initial load and support dynamic page transitions if any
  setupCatalogs();
  document.addEventListener('astro:page-load', setupCatalogs);
</script>
