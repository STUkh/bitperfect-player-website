---
import Container from '../common/Container';
import { technicalFeatures, technicalCategories } from '../../data/technical-features';

interface Props {
  id?: string;
  class?: string;
}

const { id = 'technical-catalogue', class: className } = Astro.props;
---

<section id={id} class:list={['relative scroll-mt-20 py-12 lg:py-16', className]}>
  <Container>
    {/* Filter Navigation - Editorial Tabs */}
    <div class="flex flex-wrap gap-1 sm:gap-2 border-b border-border-subtle pb-4" id="catalog-filter-bar">
      <button
        type="button"
        data-filter="all"
        class="catalog-filter-btn active-filter cursor-pointer inline-flex items-center min-h-[44px] border-b-2 border-gold px-3 sm:px-4 py-2 text-small font-medium text-gold transition-colors duration-[var(--d-ui)] focus-visible:focus-ring"
      >
        All Capabilities ({technicalFeatures.length})
      </button>
      {
        technicalCategories.map((cat) => {
          const count = technicalFeatures.filter((f) => f.category === cat.id).length;
          return (
            <button
              type="button"
              data-filter={cat.id}
              class="catalog-filter-btn cursor-pointer inline-flex items-center min-h-[44px] border-b-2 border-transparent px-3 sm:px-4 py-2 text-small font-medium text-text-secondary transition-colors duration-[var(--d-ui)] hover:text-text-primary focus-visible:focus-ring"
            >
              {cat.name} ({count})
            </button>
          );
        })
      }
    </div>

    {/* Feature Cards Grid */}
    <div
      class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-2 lg:mt-10 lg:grid-cols-3"
      id="features-catalog-grid"
    >
      {
        technicalFeatures.map((feat) => (
          <article
            data-category={feat.category}
            id={`feature-${feat.id}`}
            class="catalog-card flex flex-col justify-between rounded-card-sm border border-border-subtle bg-surface-raised/80 p-5 transition-all duration-[var(--d-ui)] hover:border-border-gold/40 hover:bg-surface-raised"
          >
            <div>
              {/* Top Category Label */}
              <span class="mono-spec text-micro font-semibold uppercase tracking-wider text-gold/90">
                {feat.categoryLabel}
              </span>

              {/* Title */}
              <h3 class="mt-2 text-body-lg font-bold text-text-primary">
                {feat.title}
              </h3>

              {/* Concise Description */}
              <p class="mt-2 text-small leading-relaxed text-text-secondary">
                {feat.description}
              </p>

              {/* Clean Benefit Line — Simple Hairline, No Clutter */}
              <div class="mt-3.5 border-t border-border-subtle/50 pt-2.5">
                <p class="text-caption text-text-tertiary">
                  <strong class="font-semibold text-text-secondary">Benefit:</strong> {feat.audiophileBenefit}
                </p>
              </div>
            </div>

            {/* Optional Public SDK Link */}
            {feat.sdkUrl && (
              <div class="mt-4 border-t border-border-subtle/50 pt-2.5">
                <a
                  href={feat.sdkUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 rounded text-caption font-medium text-gold hover:underline focus-visible:focus-ring"
                >
                  <span>View Public SDK on GitHub</span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                </a>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .catalog-filter-btn.active-filter {
    border-color: var(--color-gold);
    color: var(--color-gold);
  }
</style>

<script>
  function setupCatalogFilter() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.catalog-filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.catalog-card');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        if (!filter) return;

        // Toggle active style
        filterButtons.forEach((b) => {
          b.classList.remove('active-filter', 'border-gold', 'text-gold');
          b.classList.add('border-transparent', 'text-text-secondary');
        });
        btn.classList.add('active-filter', 'border-gold', 'text-gold');
        btn.classList.remove('border-transparent', 'text-text-secondary');
        // Filter cards
        cards.forEach((card) => {
          const cardCategory = card.getAttribute('data-category');
          if (filter === 'all' || cardCategory === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }

  // Run on initial load and support dynamic page transitions if any
  setupCatalogFilter();
  document.addEventListener('astro:page-load', setupCatalogFilter);
</script>
