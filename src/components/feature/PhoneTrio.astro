---
/**
 * A tactile 3-phone overlapping composition (inspired by flagship hardware showcases).
 *
 * Shows three coordinated app screens in authentic S24/S25 Ultra hardware frames:
 * - Center: prominent, foreground (`z-20`), scale-100, anchor of the composition.
 * - Left: angled/offset slightly behind (`z-10`, gentle tilt, scale-95, opacity-90).
 * - Right: angled/offset slightly behind (`z-10`, gentle tilt, scale-95, opacity-90).
 *
 * Engineered with:
 * - Isolated layout slots (negative margins never animate, zero layout thrashing or overflow)
 * - Agency-grade hardware hover physics (fluid depth parallax, 3% micro-scale, gold rim glow)
 * - Staged sibling coordination (non-hovered phones gracefully recede)
 * - Hardware GPU acceleration & strict prefers-reduced-motion
 */
import PhoneFrame from './PhoneFrame.astro';
import PhoneScreen from './PhoneScreen.astro';

interface Props {
  leftScreen?: string;
  centerScreen?: string;
  rightScreen?: string;
  class?: string;
  priority?: boolean;
  idPrefix?: string;
}

const {
  leftScreen = 'library',
  centerScreen = 'now-playing',
  rightScreen = 'eq',
  class: className = '',
  priority = false,
  idPrefix = 'trio',
} = Astro.props;
---

<div
  class:list={[
    'phone-trio-stage relative mx-auto flex items-center justify-center select-none',
    className,
  ]}
>
  {/* Left Phone Slot (Fixed Layout Container) */}
  <div
    class="phone-trio-slot phone-trio-slot-left relative z-10 shrink-0 -mr-[105px] min-[390px]:-mr-[115px] sm:-mr-[160px] md:-mr-[190px] lg:-mr-[220px]"
  >
    <div
      class="phone-trio-chassis phone-trio-chassis-left cursor-pointer transform-gpu"
      tabindex="0"
      role="region"
      aria-label="Library screen showcase"
    >
      <div class="w-[145px] min-[390px]:w-[160px] sm:w-[220px] md:w-[260px] lg:w-[300px]">
        <PhoneFrame fill idPrefix={`${idPrefix}-left`}>
          <PhoneScreen name={leftScreen} />
        </PhoneFrame>
      </div>
    </div>
  </div>

  {/* Center Phone Slot (Fixed Layout Container) */}
  <div
    class="phone-trio-slot phone-trio-slot-center relative z-20 shrink-0"
  >
    <div
      class="phone-trio-chassis phone-trio-chassis-center cursor-pointer transform-gpu"
      tabindex="0"
      role="region"
      aria-label="Now Playing screen showcase"
    >
      <div class="w-[160px] min-[390px]:w-[175px] sm:w-[240px] md:w-[280px] lg:w-[320px]">
        <PhoneFrame fill idPrefix={`${idPrefix}-center`}>
          <PhoneScreen name={centerScreen} priority={priority} />
        </PhoneFrame>
      </div>
    </div>
  </div>

  {/* Right Phone Slot (Fixed Layout Container) */}
  <div
    class="phone-trio-slot phone-trio-slot-right relative z-10 shrink-0 -ml-[105px] min-[390px]:-ml-[115px] sm:-ml-[160px] md:-ml-[190px] lg:-ml-[220px]"
  >
    <div
      class="phone-trio-chassis phone-trio-chassis-right cursor-pointer transform-gpu"
      tabindex="0"
      role="region"
      aria-label="Equalizer screen showcase"
    >
      <div class="w-[145px] min-[390px]:w-[160px] sm:w-[220px] md:w-[260px] lg:w-[300px]">
        <PhoneFrame fill idPrefix={`${idPrefix}-right`}>
          <PhoneScreen name={rightScreen} />
        </PhoneFrame>
      </div>
    </div>
  </div>
</div>

<style>
  .phone-trio-stage {
    perspective: 1200px;
    perspective-origin: 50% 50%;
  }

  /* ── Hardware Chassis Foundation ── */
  .phone-trio-chassis {
    position: relative;
    border-radius: 12px;
    transform-origin: 50% 50%;
    transform-style: preserve-3d;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    will-change: transform, opacity, filter, box-shadow;
    transition:
      transform 400ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 320ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 320ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (min-width: 640px) {
    .phone-trio-chassis {
      border-radius: 18px;
    }
  }

  /* ── Center Phone: Anchor of composition ── */
  .phone-trio-chassis-center {
    transform: translate3d(0, 0, 0) scale(1);
    opacity: 1;
    box-shadow:
      0 20px 48px -14px rgba(0, 0, 0, 0.75),
      0 0 0 1px rgba(255, 255, 255, 0.08);
  }
  .phone-trio-slot-center:hover,
  .phone-trio-slot-center:focus-within {
    z-index: 35;
  }
  .phone-trio-slot-center:hover .phone-trio-chassis-center,
  .phone-trio-slot-center:focus-within .phone-trio-chassis-center {
    transform: translate3d(0, -6px, 16px) scale(1.02);
    box-shadow:
      0 32px 64px -16px rgba(0, 0, 0, 0.85),
      0 0 28px -4px rgba(232, 184, 75, 0.18),
      0 0 0 1px rgba(232, 184, 75, 0.32);
  }

  /* ── Left Phone: Subtle left tilt & receded depth ── */
  .phone-trio-chassis-left {
    transform: translate3d(-6px, 6px, 0) rotateZ(-3deg) scale(0.92);
    opacity: 0.88;
    box-shadow:
      0 16px 40px -12px rgba(0, 0, 0, 0.65),
      0 0 0 1px rgba(255, 255, 255, 0.06);
  }
  @media (min-width: 640px) {
    .phone-trio-chassis-left {
      transform: translate3d(-10px, 8px, 0) rotateZ(-5deg) scale(0.95);
    }
  }
  .phone-trio-slot-left:hover,
  .phone-trio-slot-left:focus-within {
    z-index: 35;
  }
  .phone-trio-slot-left:hover .phone-trio-chassis-left,
  .phone-trio-slot-left:focus-within .phone-trio-chassis-left {
    opacity: 1;
    transform: translate3d(-10px, -6px, 16px) rotateZ(-1.5deg) scale(0.98);
    box-shadow:
      0 30px 60px -14px rgba(0, 0, 0, 0.85),
      0 0 28px -4px rgba(232, 184, 75, 0.2),
      0 0 0 1px rgba(232, 184, 75, 0.35);
  }
  @media (min-width: 640px) {
    .phone-trio-slot-left:hover .phone-trio-chassis-left,
    .phone-trio-slot-left:focus-within .phone-trio-chassis-left {
      transform: translate3d(-16px, -8px, 20px) rotateZ(-2deg) scale(1.015);
    }
  }

  /* ── Right Phone: Subtle right tilt & receded depth ── */
  .phone-trio-chassis-right {
    transform: translate3d(6px, 6px, 0) rotateZ(3deg) scale(0.92);
    opacity: 0.88;
    box-shadow:
      0 16px 40px -12px rgba(0, 0, 0, 0.65),
      0 0 0 1px rgba(255, 255, 255, 0.06);
  }
  @media (min-width: 640px) {
    .phone-trio-chassis-right {
      transform: translate3d(10px, 8px, 0) rotateZ(5deg) scale(0.95);
    }
  }
  .phone-trio-slot-right:hover,
  .phone-trio-slot-right:focus-within {
    z-index: 35;
  }
  .phone-trio-slot-right:hover .phone-trio-chassis-right,
  .phone-trio-slot-right:focus-within .phone-trio-chassis-right {
    opacity: 1;
    transform: translate3d(10px, -6px, 16px) rotateZ(1.5deg) scale(0.98);
    box-shadow:
      0 30px 60px -14px rgba(0, 0, 0, 0.85),
      0 0 28px -4px rgba(232, 184, 75, 0.2),
      0 0 0 1px rgba(232, 184, 75, 0.35);
  }
  @media (min-width: 640px) {
    .phone-trio-slot-right:hover .phone-trio-chassis-right,
    .phone-trio-slot-right:focus-within .phone-trio-chassis-right {
      transform: translate3d(16px, -8px, 20px) rotateZ(2deg) scale(1.015);
    }
  }

  /* ── Stage Coordination (Staging Principle): Non-hovered phones subtly yield ── */
  .phone-trio-stage:has(.phone-trio-slot-center:hover) .phone-trio-chassis-left,
  .phone-trio-stage:has(.phone-trio-slot-center:hover) .phone-trio-chassis-right {
    opacity: 0.74;
    filter: brightness(0.93);
  }

  .phone-trio-stage:has(.phone-trio-slot-left:hover) .phone-trio-chassis-center {
    opacity: 0.88;
    transform: translate3d(0, 3px, -8px) scale(0.985);
  }
  .phone-trio-stage:has(.phone-trio-slot-left:hover) .phone-trio-chassis-right {
    opacity: 0.68;
    filter: brightness(0.9);
  }

  .phone-trio-stage:has(.phone-trio-slot-right:hover) .phone-trio-chassis-center {
    opacity: 0.88;
    transform: translate3d(0, 3px, -8px) scale(0.985);
  }
  .phone-trio-stage:has(.phone-trio-slot-right:hover) .phone-trio-chassis-left {
    opacity: 0.68;
    filter: brightness(0.9);
  }

  /* ── Strict Accessibility / Reduced Motion ── */
  @media (prefers-reduced-motion: reduce) {
    .phone-trio-chassis,
    .phone-trio-chassis-left,
    .phone-trio-chassis-center,
    .phone-trio-chassis-right,
    .phone-trio-slot-left:hover .phone-trio-chassis-left,
    .phone-trio-slot-center:hover .phone-trio-chassis-center,
    .phone-trio-slot-right:hover .phone-trio-chassis-right,
    .phone-trio-stage:has(.phone-trio-slot-center:hover) .phone-trio-chassis-left,
    .phone-trio-stage:has(.phone-trio-slot-center:hover) .phone-trio-chassis-right,
    .phone-trio-stage:has(.phone-trio-slot-left:hover) .phone-trio-chassis-center,
    .phone-trio-stage:has(.phone-trio-slot-left:hover) .phone-trio-chassis-right,
    .phone-trio-stage:has(.phone-trio-slot-right:hover) .phone-trio-chassis-center,
    .phone-trio-stage:has(.phone-trio-slot-right:hover) .phone-trio-chassis-left {
      transform: none !important;
      transition: none !important;
      opacity: 1 !important;
      filter: none !important;
      will-change: auto !important;
    }
  }
</style>
