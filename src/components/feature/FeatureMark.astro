---
/**
 * The six feature marks, plus the handful of utility glyphs the feature routes
 * need. Lifted from the approved artboards in `design/`.
 *
 * "The Mark Carries the Identity" (DESIGN.md): one weight, one colour, drawn on
 * a 24px grid. Colour never tells the six features apart; the mark and the
 * mark does. Nothing in here is ever tinted per route.
 *
 * The six identity marks run larger than the utility glyphs — against a 34px
 * row heading a 24px mark reads as a bullet rather than a drawing. Stroke is
 * derived from the size by `iconStroke` so the weight stays optically level
 * across the range; do not pass it by hand. See `src/utils/icon.ts`.
 */
import { iconStroke } from '../../utils/icon';

interface Props {
  name:
    | 'usb-dac'
    | 'eq'
    | 'library'
    | 'casting'
    | 'dsp'
    | 'ai-enhancer'
    | 'arrow-right'
    | 'arrow-left'
    | 'chevron-right'
    | 'check'
    | 'play'
    | 'file'
    | 'chip'
    | 'dac';
  size?: number;
  /** Escape hatch. Leave unset so the size-derived weight applies. */
  stroke?: number;
  class?: string;
}

const { name, size = 20, stroke, class: className } = Astro.props;
const strokeWidth = stroke ?? iconStroke(size);
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {/*
    The six identity marks, transcribed from design/FeaturesIndex.dc.html.

    They replace six Lucide defaults that shipped here by mistake: a plug, a
    sliders-vertical, a disc, a cast arc, a zigzag, and a four-pointed sparkle.
    That set is the visual vocabulary of every generated product page on the
    internet, and the sparkle in particular has been the universal "AI" glyph
    since 2023. Six stock glyphs say nothing about this product and make it look
    like every other one.

    Each of these draws the thing the feature actually does, in a way that only
    makes sense for an audio player: the pin diagram of a USB connector, a
    response curve carrying its own control points, a library spine with index
    ticks, a fader that reads in both directions because the app both sends and
    receives, a shelf curve on an axis, and a quantised staircase beside the
    band a reconstruction puts back, drawn dashed because it is inferred rather
    than recorded.
  */}
  {
    name === 'usb-dac' && (
      <>
        <path d="M3 8v8" />
        <path d="M3 8h6" />
        <path d="M13 8h5" />
        <path d="M9.5 10.2 12.5 5.8" />
        <path d="M3 16h15" />
        <rect x="18" y="13" width="3" height="6" rx="1" />
      </>
    )
  }
  {
    name === 'eq' && (
      <>
        <path d="M2 13h20" />
        <path d="M4 13C6 3 10 3 12 13" />
        <path d="M15 13c1.5 0 1.5-4 3-4h4" />
        {/* The control points are solid: a hollow ring at this weight reads as a
            hole in the curve rather than a handle on it. */}
        <circle cx="8" cy="5.5" r="1.4" fill="currentColor" stroke="none" />
        <circle cx="16.5" cy="11" r="1.4" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'library' && (
      <>
        <path d="M7 4H4v16h3" />
        <path d="M7 7h10" />
        <path d="M7 12h8" />
        <path d="M7 17h11" />
        <path d="M20 5v2M20 9v2M20 13v2M20 17v2" />
      </>
    )
  }
  {
    name === 'casting' && (
      <>
        <path d="M7 4v16" />
        <path d="M3 6h4M3 10h4M3 14h4M3 18h4" />
        <path d="M7 12h13" />
        <path d="M12 10.5v3M15.5 10.5v3M19 10.5v3" />
        {/* Two heads, pointing opposite ways: the app is a renderer and a source. */}
        <path d="M18.5 9.8 21 12l-2.5 2.2" />
        <path d="M11 9.8 8.5 12l2.5 2.2" />
      </>
    )
  }
  {
    name === 'dsp' && (
      <>
        <path d="M2 6h20" />
        <path d="M2 18c3 0 4-10.4 7-10.4h6c3 0 4 10.4 7 10.4" />
      </>
    )
  }
  {
    name === 'ai-enhancer' && (
      <>
        <path d="M2 20h20" />
        <path d="M2 6h3v2.5h3.5V11h3v2h2.5" />
        <path d="M14 4v16" />
        <path d="M14 13h3v2h3v2h2" stroke-dasharray="2 2" />
      </>
    )
  }
  {name === 'arrow-right' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'arrow-left' && <path d="M19 12H5M11 6l-6 6 6 6" />}
  {name === 'chevron-right' && <path d="M9 6l6 6-6 6" />}
  {name === 'check' && <path d="M4 12.5 9.5 18 20 6.5" />}
  {name === 'play' && <path d="M5 3.5v17a1 1 0 0 0 1.52.86l14-8.5a1 1 0 0 0 0-1.72l-14-8.5A1 1 0 0 0 5 3.5Z" fill="currentColor" stroke="none" />}
  {
    name === 'file' && (
      <>
        <path d="M4 6.5A2.5 2.5 0 0 1 6.5 4H14l6 6v7.5a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 17.5Z" />
        <path d="M14 4v6h6" />
      </>
    )
  }
  {
    name === 'chip' && (
      <>
        <rect x="4" y="4" width="16" height="16" rx="3" />
        <rect x="9" y="9" width="6" height="6" rx="1.2" />
        <path d="M9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2" />
      </>
    )
  }
  {
    name === 'dac' && (
      <>
        <rect x="2.5" y="7" width="19" height="10" rx="2" />
        <circle cx="7.5" cy="12" r="1.6" />
        <path d="M12 10.5h6M12 13.5h6" />
      </>
    )
  }
</svg>
