---
import PhoneScreen from './feature/PhoneScreen.astro';
import { screenAspect } from '../data/screens';

/**
 * The hero device: the app's Now Playing screen, as a capture.
 *
 * This was 377 lines of hand-built DOM reproducing the Compose UI in HTML, down
 * to a pulsing bit-perfect dot and a fabricated track — "Nocturne in Amber" by
 * "Hale & the Quiet Room", a record that does not exist, sitting above a headline
 * about honesty. It is now a screenshot of the shipping app playing a real CC0
 * recording, which is both truer and a tenth of the code.
 *
 * The CHASSIS stays hand-built rather than reusing `PhoneFrame`, and that is not
 * an oversight. This one instance is lit differently from every other device on
 * the site: a gold rim (`--color-border-gold`) and `--shadow-device` rather than
 * the neutral hairline and `--shadow-device-cast` the lineup and the feature beats
 * share. It is the only phone that stands alone above the fold, and it is the only
 * one allowed to catch the light that way. Two frames, on purpose; the screen
 * inside them is the same asset pipeline.
 *
 * `priority` because this is the one screen above the fold. Every other capture on
 * the site is lazy.
 */
export interface Props {
  class?: string;
}

const { class: cls = '' } = Astro.props;
---

<div class={`phone ${cls}`}>
  <div class="screen" style={`aspect-ratio: ${screenAspect}`}>
    <PhoneScreen
      name="now-playing-hero"
      priority
      alt="The Bitperfect Player Now Playing screen, mid-track, showing the album artwork, the transport controls and the file's FLAC format and rate"
    />
  </div>
</div>

<style>
  .phone {
    width: 100%;
    /* 300, not 320, and the 20px is doing real work.

       This device bleeds off the fold on purpose — the hero caps its own height so
       the phone crops at a CHOSEN line rather than dictating the row. With the
       screen at its true 9:20 the chassis grew from 566px to 687px, and the chosen
       line stopped being chosen: the crop landed straight through the middle of the
       track title. At 300 the chassis is 642 and the same 474px of visible height
       falls in the empty band between the artist line and the progress bar, which
       is the one place across that screen where a horizontal cut meets no ink.
       It also puts the hero device on the same 300px module as the lineup. */
    max-width: 300px;
    margin-inline: auto;
    border-radius: var(--radius-phone-outer, 14px);
    padding: 10px;
    background: linear-gradient(
      160deg,
      rgba(27, 24, 36, 0.88),
      rgba(10, 10, 15, 0.96) 45%,
      rgba(27, 24, 36, 0.8)
    );
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid var(--color-border-gold);
    /* The 60px gold halo that used to sit under this is gone. A phone is an object
       lit by the room, not a lamp (DESIGN.md, "Gold Emits Nothing" and "No Floating
       Glow"), and the halo was still painting the retired #e5b842 besides. Depth is
       the surface ladder plus the top-rim specular the elevated shadow already
       carries. */
    box-shadow: var(--shadow-device);
    position: relative;
  }

  .screen {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-phone-screen, 10px);
    border: 1px solid var(--color-border-subtle);
    background: var(--color-phone-screen);
  }
</style>
