---
import Icon from './Icon.astro';
import AlbumArt from './AlbumArt.astro';

/**
 * The app's Now Playing screen, rebuilt as live DOM from the app's Compose UI tokens.
 * Live bit-perfect pulse indicator and tabular figures.
 * Demo content: Nocturne in Amber / Hale & the Quiet Room.
 */
export interface Props {
  class?: string;
}

const { class: cls = '' } = Astro.props;
---

<div
  class={`phone ${cls}`}
  role="img"
  aria-label="Bitperfect Player Now Playing interface showing a bit-perfect direct signal path at FLAC 24-bit 192 kilohertz"
>
  <div class="screen">
    {/* Status bar */}
    <div class="status">
      <span>10:08</span>
      <span class="status-right">
        <svg width="14" height="10" viewBox="0 0 14 10" aria-hidden="true" fill="currentColor">
          <path d="M1 9h1.6V6.2H1Zm3.4 0H6V4.1H4.4Zm3.4 0h1.6V2H7.8Zm3.4 0h1.6V0h-1.6Z"></path>
        </svg>
        <svg width="18" height="10" viewBox="0 0 18 10" aria-hidden="true">
          <rect x="0.5" y="1.5" width="13" height="7" rx="2" fill="none" stroke="currentColor" stroke-width="1"></rect>
          <rect x="2" y="3" width="9.5" height="4" rx="1" fill="currentColor"></rect>
          <path d="M15.5 4v2.2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
        </svg>
      </span>
    </div>

    {/* Top bar */}
    <div class="topbar">
      <Icon name="chevron" size={18} />
      <span class="topbar-title">Now Playing</span>
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    </div>

    {/* Artwork frame */}
    <div class="art">
      <AlbumArt />
    </div>

    {/* Signal path badge */}
    <div class="sig">
      <span class="sig-mark"><Icon name="sig-bitperfect" size={13} /></span>
      <span class="sig-label">BIT-PERFECT</span>
      <span class="sig-sep" aria-hidden="true"></span>
      <span class="sig-spec">FLAC 24/192</span>
    </div>

    {/* Track title & artist */}
    <div class="track">
      <div class="track-title">Nocturne in Amber</div>
      <div class="track-artist">Hale &amp; the Quiet Room</div>
    </div>

    {/* Progress scrubber */}
    <div class="prog">
      <div class="prog-rail"><span class="prog-fill"></span></div>
      <div class="prog-times">
        <span>2:14</span>
        <span>−3:48</span>
      </div>
    </div>

    {/* Transport controls */}
    <div class="transport">
      <button class="tbtn" type="button" tabindex="-1" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M7 5.5h2.2v13H7Zm10 0v13l-9-6.5Z"></path>
        </svg>
      </button>
      <button class="tbtn play" type="button" tabindex="-1" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
          <path d="M7.5 5h3.2v14H7.5Zm5.8 0h3.2v14h-3.2Z"></path>
        </svg>
      </button>
      <button class="tbtn" type="button" tabindex="-1" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17 5.5h-2.2v13H17ZM7 5.5v13l9-6.5Z"></path>
        </svg>
      </button>
    </div>

    {/* Output route indicator */}
    <div class="out">
      <Icon name="node-usb" size={14} />
      <span class="out-name">External DAC</span>
      <span class="out-spec">USB · exclusive</span>
    </div>
  </div>
</div>

<style>
  /* Glass phone frame — frosted bezel over the hero's gold ambient glow */
  .phone {
    width: 100%;
    max-width: 320px;
    margin-inline: auto;
    border-radius: var(--radius-phone-outer, 14px);
    padding: 10px;
    background: linear-gradient(
      160deg,
      rgba(27, 24, 36, 0.88),
      rgba(10, 10, 15, 0.96) 45%,
      rgba(27, 24, 36, 0.8)
    );
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(229, 184, 66, 0.24);
    box-shadow:
      var(--shadow-elevated),
      0 0 60px rgba(229, 184, 66, 0.12);
    position: relative;
  }

  .screen {
    position: relative;
    height: 100%;
    border-radius: var(--radius-phone-screen, 8px);
    background: var(--color-surface-base, #08080c);
    border: 1px solid var(--color-border-subtle);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: 10px 14px 12px;
  }

  /* Internal subtle golden ambient reflection */
  .screen::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse 120% 55% at 50% 0%,
      rgba(229, 184, 66, 0.14) 0%,
      rgba(229, 184, 66, 0.04) 40%,
      transparent 72%
    );
  }

  .screen > * {
    position: relative;
  }

  .status {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    font-feature-settings: 'tnum' 1;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-secondary);
    padding-block: 2px 6px;
  }

  .status-right {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .topbar {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-text-tertiary);
    padding-bottom: 10px;
  }

  .topbar-title {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label, 0.09em);
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-inline: auto;
  }

  .dots {
    display: inline-flex;
    flex-direction: column;
    gap: 2px;
  }

  .dots i {
    width: 2.5px;
    height: 2.5px;
    border-radius: 50%;
    background: var(--color-text-tertiary);
  }

  .art {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--color-border-subtle);
    margin-bottom: 12px;
    box-shadow: 0 10px 24px -4px rgba(0, 0, 0, 0.6);
  }

  /* Signal-path badge — bit-perfect green status pill */
  .sig {
    display: flex;
    align-items: center;
    gap: 6px;
    align-self: flex-start;
    padding: 5px 11px;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-bitperfect) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-bitperfect) 36%, transparent);
    margin-bottom: 10px;
  }

  .sig-mark {
    display: inline-flex;
    color: var(--color-bitperfect);
    animation: sigpulse 2.6s var(--ease-out-expo) infinite;
  }

  @keyframes sigpulse {
    0%,
    62%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    80% {
      opacity: 0.45;
      transform: scale(0.95);
    }
  }

  .sig-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    color: var(--color-bitperfect);
  }

  .sig-sep {
    width: 1px;
    height: 10px;
    background: var(--color-border-subtle);
  }

  .sig-spec {
    font-size: 0.75rem;
    font-feature-settings: 'tnum' 1;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-secondary);
  }

  .track {
    margin-bottom: auto;
  }

  .track-title {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25;
    color: var(--color-text-primary);
  }

  .track-artist {
    font-size: 0.8125rem;
    color: var(--color-text-tertiary);
    margin-top: 2px;
  }

  .prog {
    margin-top: 12px;
  }

  .prog-rail {
    height: 3px;
    border-radius: 9999px;
    background: var(--color-surface-overlay);
    overflow: hidden;
  }

  .prog-fill {
    display: block;
    height: 100%;
    width: 37%;
    border-radius: inherit;
    background: var(--color-gold);
  }

  .prog-times {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    font-feature-settings: 'tnum' 1;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-tertiary);
    margin-top: 5px;
  }

  .transport {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding-block: 12px 10px;
  }

  .tbtn {
    cursor: default;
    color: var(--color-text-secondary);
    display: inline-flex;
    padding: 0;
    background: none;
    border: none;
  }

  .tbtn.play {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, #fbf6e9 0%, #e5b842 50%, #c49b50 100%);
    color: var(--color-on-gold, #08080c);
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 16px rgba(229, 184, 66, 0.35);
  }

  .out {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 8px 12px;
    border-radius: 9999px;
    background: var(--color-surface-overlay);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-gold);
  }

  .out-name {
    font-size: 0.75rem;
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .out-spec {
    font-size: 0.75rem;
    font-feature-settings: 'tnum' 1;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-tertiary);
    margin-left: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .sig-mark {
      animation: none;
    }
  }
</style>
