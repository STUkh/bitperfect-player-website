---
import Icon from '../Icon.astro';

interface Props {
  question: string;
  answer: string;
  id: string;
  link?: { href: string; text: string };
  open?: boolean;
}

const { question, answer, id, link, open = false } = Astro.props;
const contentId = `accordion-${id}`;
---

<details name="faq-accordion" open={open} class="accordion-item group border-b border-border-subtle">
  <summary
    class="accordion-trigger flex w-full cursor-pointer list-none items-center justify-between gap-4 rounded py-5 pl-3 focus-visible:focus-ring"
    aria-controls={contentId}
  >
    <span
      class="pr-4 text-base font-medium text-text-primary transition-colors duration-200 group-hover:text-white group-open:text-gold"
    >
      {question}
    </span>
    <span
      class="shrink-0 text-text-tertiary transition-colors duration-200 group-hover:text-text-secondary group-open:text-gold"
    >
      <Icon name="chevron" size={20} class="transition-transform duration-300 group-open:rotate-180" />
    </span>
  </summary>
  <div id={contentId} class="accordion-content pb-5 pl-3">
    <p class="text-base leading-relaxed text-text-secondary">
      {answer}
    </p>
    {
      link && (
        <a
          href={link.href}
          class="mt-3 inline-flex items-center gap-2 rounded font-medium text-gold transition-colors duration-200 hover:text-gold-light focus-visible:focus-ring"
        >
          {link.text}
          <Icon name="arrow" size={14} />
        </a>
      )
    }
  </div>
</details>

<style>
  /* Native <details>/<summary> — expand/collapse, keyboard operation and AT
     semantics come from the browser, not from script. The <script> paired
     with this component is a pure enhancement (closes sibling panels in
     browsers that don't yet support the `name` grouping attribute); nothing
     here depends on it to be readable or operable with JS disabled. */
  .accordion-item {
    position: relative;
  }
  .accordion-item::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: var(--color-gold);
    border-radius: 1px;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .accordion-item:hover::before,
  .accordion-item[open]::before {
    opacity: 1;
  }

  summary {
    position: relative;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::marker {
    content: '';
  }

  .accordion-item[open] .accordion-content {
    animation: accordion-reveal 0.3s ease-out;
  }
  @keyframes accordion-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
