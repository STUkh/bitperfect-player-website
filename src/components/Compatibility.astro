---
/**
 * Compatibility: Human compatibility guide.
 * Nested compact block inside #ai.
 * Explains device capabilities clearly without internal silicon part numbers or chip matrices.
 */
import Icon from './Icon.astro';
---

<div id="compatibility" class="scroll-mt-24 pt-12 sm:pt-16 border-t border-border-subtle">
  <div class="mb-10 max-w-2xl" data-animate="fade-up">
    <p class="mb-3 text-eyebrow text-gold">Device Compatibility</p>
    <h3 class="text-2xl font-bold tracking-tight text-white sm:text-3xl lg:text-4xl">
      A clear, two-tier hardware model
    </h3>
    <p class="mt-3 text-base text-text-secondary sm:text-lg">
      Bitperfect separates universal native playback from hardware-accelerated neural DSP, ensuring complete predictability across all Android devices.
    </p>
  </div>

  {/* 2-Tier Composition */}
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 items-stretch" data-animate="fade-up">
    {/* Tier 1: Universal Core */}
    <div class="glass accent-glow accent-glow-hover flex flex-col justify-between rounded-2xl p-6 sm:p-8 relative overflow-hidden transition-all duration-300 hover:scale-[1.005]" style="--card-accent: var(--color-bitperfect)">
      <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-bitperfect/40 to-transparent" aria-hidden="true"></div>

      <div>
        <div class="flex items-center justify-between gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-bitperfect/30 bg-bitperfect/10 px-3 py-1 text-xs font-semibold text-bitperfect">
            <Icon name="sig-bitperfect" size={13} />
            <span>Universal Core</span>
          </span>
          <span class="font-mono text-xs text-text-secondary">Android 8.0+</span>
        </div>

        <h4 class="mt-5 text-xl font-bold text-white">Playback & Local Acoustic Intelligence</h4>
        <p class="mt-2 text-base leading-relaxed text-text-secondary">
          The entire bit-true audio engine and acoustic library intelligence run on any CPU without requiring special hardware.
        </p>

        <ul class="mt-6 space-y-3 text-sm text-text-secondary">
          <li class="flex items-center gap-3">
            <span class="h-2 w-2 shrink-0 rounded-full bg-bitperfect" aria-hidden="true"></span>
            <span>Direct exclusive USB DAC output & zero resampling</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="h-2 w-2 shrink-0 rounded-full bg-bitperfect" aria-hidden="true"></span>
            <span>32-band parametric EQ with seven filter topologies</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="h-2 w-2 shrink-0 rounded-full bg-bitperfect" aria-hidden="true"></span>
            <span>Sonic Scan & Similar Tracks local library analysis</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="h-2 w-2 shrink-0 rounded-full bg-bitperfect" aria-hidden="true"></span>
            <span>Bi-directional network streaming & 64-bit DSP effects</span>
          </li>
        </ul>
      </div>

      <div class="mt-8 pt-4 border-t border-border-subtle text-xs text-text-tertiary">
        Universal support for all 64-bit and 32-bit Android phones from Android 8.0 upward.
      </div>
    </div>

    {/* Tier 2: Real-Time AI Enhancer */}
    <div class="glass accent-glow accent-glow-hover flex flex-col justify-between rounded-2xl p-6 sm:p-8 relative overflow-hidden transition-all duration-300 hover:scale-[1.005]" style="--card-accent: var(--color-gold)">
      <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold/40 to-transparent" aria-hidden="true"></div>

      <div>
        <div class="flex items-center justify-between gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-gold/30 bg-gold/10 px-3 py-1 text-xs font-semibold text-gold">
            <Icon name="sig-enhanced" size={13} />
            <span>Neural Accelerator</span>
          </span>
          <span class="font-mono text-xs text-gold-light">Auto-Probed</span>
        </div>

        <h4 class="mt-5 text-xl font-bold text-white">Real-Time Neural Restoration</h4>
        <p class="mt-2 text-base leading-relaxed text-text-secondary">
          Dedicated on-device hardware acceleration for real-time lossy signal restoration.
        </p>

        <ul class="mt-6 space-y-3 text-sm text-text-secondary">
          <li class="flex items-center gap-3">
            <span class="h-2 w-2 shrink-0 rounded-full bg-gold" aria-hidden="true"></span>
            <span>In-band amplitude and coherent phase reconstruction</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="h-2 w-2 shrink-0 rounded-full bg-gold" aria-hidden="true"></span>
            <span>Automatic hardware probe at launch verifies throughput</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="h-2 w-2 shrink-0 rounded-full bg-gold" aria-hidden="true"></span>
            <span>Supported on flagship and premium mid-range platforms (2022+)</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="h-2 w-2 shrink-0 rounded-full bg-gold" aria-hidden="true"></span>
            <span>Safe silent fallback: core playback stays 100% unaffected</span>
          </li>
        </ul>
      </div>

      <div class="mt-8 pt-4 border-t border-border-subtle text-xs text-text-tertiary">
        You never need to look up chip specs: the app tests and manages acceleration automatically.
      </div>
    </div>
  </div>
</div>
