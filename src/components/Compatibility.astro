---
/**
 * Compatibility — three tiers as full-width glass rows (not a grid of
 * cards — the rows carry uneven content weight, especially the AI Enhancer
 * row's generation timeline). The AI Enhancer row's timeline names Qualcomm
 * and MediaTek by vendor only — a narrow, user-approved exception to the
 * site's no-brand-names rule (PRODUCT.md Brand Commitments). Years are
 * measurements — mono.
 */
import Container from './common/Container.astro';
import Icon from './Icon.astro';
import { compatibility } from '../data/site';

const levelMeta: Record<string, { icon: string; label: string; accent: string; text: string }> = {
  universal: { icon: 'sig-bitperfect', label: 'Universal', accent: 'var(--color-bitperfect)', text: 'text-bitperfect' },
  npu: { icon: 'sig-enhanced', label: 'Accelerator', accent: 'var(--color-enhanced)', text: 'text-enhanced' },
};

/* Tick positions as % along the 2022→2026 axis (4-year span, 25%/year).
   Qualcomm Hexagon: one generation each year, 2022–2026.
   MediaTek Dimensity: late-2023 flagship entry, then 2024–25 — see site.ts mapping. */
/* Qualcomm Hexagon NPU Generations with Launch Dates & Chip Models */
const hexagonPoints = [
  { name: '8 Gen 1', date: 'Dec 2021', at: 0 },
  { name: '8 Gen 2', date: 'Nov 2022', at: 25 },
  { name: '8 Gen 3', date: 'Oct 2023', at: 50 },
  { name: '8 Elite', date: 'Oct 2024', at: 75 },
  { name: '8 Elite G5', date: 'Late 2025', at: 100 },
];

/* MediaTek Dimensity NPU Generations with Launch Dates & Staggered Badge Positions */
const dimensityPoints = [
  { name: 'Dimensity 9300', date: 'Nov 2023', at: 48, pos: 'top-5' },
  { name: 'Dimensity 8300', date: 'Nov 2023', at: 56, pos: 'top-12' },
  { name: 'Dimensity 9400', date: 'Oct 2024', at: 72, pos: 'top-5' },
  { name: 'Dimensity 8400', date: 'Dec 2024', at: 80, pos: 'top-12' },
];

/* Calendar Year Ticks (2022 to 2026) */
const calendarYears = [
  { y: '2022', at: 0 },
  { y: '2023', at: 25 },
  { y: '2024', at: 50 },
  { y: '2025', at: 75 },
  { y: '2026', at: 100 },
];
---

<section id="compatibility" class="section-py relative">
  <Container>
    <div class="mb-12 max-w-2xl lg:mb-16" data-animate="fade-up">
      <p class="mb-4 text-eyebrow text-gold">Compatibility</p>
      <h2 class="heading-section">What runs where.</h2>
      <p class="mt-4 text-base text-text-secondary sm:text-lg">
        The player and the library intelligence run on any phone. Real-time
        restoration needs dedicated silicon — and the app checks yours before
        it promises anything.
      </p>
    </div>

    <!-- 3 Tier Cards: Columns on Desktop (md:grid-cols-3), Rows on Mobile -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3 items-stretch" data-animate="fade-up">
      {
        compatibility.map((tier) => {
          const meta = levelMeta[tier.level];
          return (
            <div
              class="glass accent-glow accent-glow-hover flex flex-col justify-between rounded-2xl p-6 transition-all duration-300 hover:scale-[1.01]"
              style={`--card-accent: ${meta.accent}`}
            >
              <div>
                <span class={`inline-flex items-center gap-2 text-xs font-semibold tracking-label uppercase ${meta.text}`}>
                  <Icon name={meta.icon} size={14} />
                  {meta.label}
                </span>

                <h3 class="mt-3 text-lg font-bold text-white sm:text-xl">{tier.what}</h3>

                <div class="mt-4 space-y-3">
                  <div>
                    <span class="text-[11px] font-semibold tracking-wider text-text-tertiary uppercase block">Scope</span>
                    <span class="text-sm font-medium text-text-secondary">{tier.scope}</span>
                  </div>
                  <div>
                    <span class="text-[11px] font-semibold tracking-wider text-text-tertiary uppercase block">Devices</span>
                    <span class="text-sm font-medium text-text-secondary">{tier.devices}</span>
                  </div>
                </div>
              </div>

              <div class="mt-6 pt-4 border-t border-white/[0.06] text-xs leading-relaxed text-text-tertiary">
                {tier.note}
              </div>
            </div>
          );
        })
      }
    </div>

    <!-- Verified Hardware NPU & SoC Breakdown (Full Width) -->
    <div class="mt-6 glass rounded-2xl p-6 sm:p-8 overflow-hidden" data-animate="fade-up">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6 pb-6 border-b border-white/[0.08]">
        <div>
          <h3 class="text-lg font-bold text-white">Verified Hardware NPU Acceleration</h3>
          <p class="mt-1 text-xs text-text-tertiary">
            Nine accelerator generations supported across flagship and premium mid-range platforms.
          </p>
        </div>
        <span class="inline-flex items-center gap-2 self-start lg:self-auto rounded-full border border-gold/30 bg-gold/10 px-3.5 py-1.5 text-xs font-semibold text-gold">
          Auto-probe at runtime
        </span>
      </div>

      <!-- Timeline Chart with SoC Point Labels -->
      <figure class="pt-6 pb-6" aria-label="Supported accelerator generations timeline from 2022 to 2026 with launched SoCs.">
        <div class="grid grid-cols-[9rem_1fr] items-center gap-x-4 gap-y-16 w-full">
          <!-- Qualcomm Row -->
          <span class="text-xs font-semibold text-gold">Qualcomm Snapdragon</span>
          <div class="relative h-4">
            <div class="absolute inset-x-0 top-1/2 border-t border-white/10" />
            {hexagonPoints.map((pt) => (
              <div class="absolute top-0 bottom-0" style={`left:${pt.at}%`}>
                <span class="absolute top-1/2 -translate-y-1/2 h-3 w-1 -translate-x-1/2 rounded-full bg-gold shadow-[0_0_8px_rgba(232,184,75,0.8)]" />
                <span
                  class="absolute -top-7 rounded bg-black/90 border border-gold/40 px-1.5 py-0.5 text-[10px] font-mono text-gold whitespace-nowrap shadow-lg pointer-events-none"
                  style={`transform: translateX(${pt.at === 0 ? '0' : pt.at === 100 ? '-100%' : '-50%'})`}
                >
                  {pt.name} <span class="text-[9px] text-text-tertiary">({pt.date})</span>
                </span>
              </div>
            ))}
          </div>

          <!-- MediaTek Row (Staggered Badges) -->
          <span class="text-xs font-semibold text-enhanced">MediaTek Dimensity</span>
          <div class="relative h-4">
            <div class="absolute inset-x-0 top-1/2 border-t border-white/10" />
            {dimensityPoints.map((pt) => (
              <div class="absolute top-0 bottom-0" style={`left:${pt.at}%`}>
                <span class="absolute top-1/2 -translate-y-1/2 h-3 w-1 -translate-x-1/2 rounded-full bg-enhanced shadow-[0_0_8px_rgba(0,229,255,0.8)]" />
                <span
                  class={`absolute ${pt.pos} rounded bg-black/90 border border-enhanced/40 px-1.5 py-0.5 text-[10px] font-mono text-enhanced whitespace-nowrap shadow-lg pointer-events-none`}
                  style={`transform: translateX(${pt.at === 0 ? '0' : pt.at === 100 ? '-100%' : '-50%'})`}
                >
                  {pt.name} <span class="text-[9px] text-text-tertiary">({pt.date})</span>
                </span>
              </div>
            ))}
          </div>

          <!-- Calendar Axis -->
          <span aria-hidden="true"></span>
          <div class="relative h-6 pt-3 font-mono text-xs text-text-tertiary border-t border-white/10">
            {calendarYears.map(({ y, at }) => (
              <span
                class="absolute top-2 font-bold text-text-secondary"
                style={`left:${at}%; transform:translateX(${at === 0 ? '0' : at === 100 ? '-100%' : '-50%'})`}
              >
                {y}
              </span>
            ))}
          </div>
        </div>
      </figure>

      <!-- Verified SoCs List with Launch Years -->
      <div class="mt-8 pt-6 border-t border-white/[0.06]">
        <h4 class="text-xs font-semibold tracking-wider uppercase text-text-tertiary mb-4">Supported Platforms & SoCs by Launch Year</h4>
        <div class="grid gap-8 sm:grid-cols-2">
          <div>
            <div class="text-xs font-bold text-gold uppercase tracking-wider mb-3">Qualcomm Snapdragon</div>
            <ul class="space-y-2.5 text-xs text-text-secondary">
              <li class="flex items-center justify-between gap-2 border-b border-white/[0.05] pb-1.5">
                <span class="flex items-center gap-2">
                  <span>Snapdragon 8 Elite / 8 Gen 5</span>
                  <span class="rounded bg-white/10 px-1.5 py-0.5 text-[10px] font-mono text-gold">2025/26</span>
                </span>
                <span class="font-mono text-text-tertiary">SM8750 / SM8850</span>
              </li>
              <li class="flex items-center justify-between gap-2 border-b border-white/[0.05] pb-1.5">
                <span class="flex items-center gap-2">
                  <span>Snapdragon 8 Gen 3 / 8s Gen 3</span>
                  <span class="rounded bg-white/10 px-1.5 py-0.5 text-[10px] font-mono text-gold">2024</span>
                </span>
                <span class="font-mono text-text-tertiary">SM8650 / SM8635</span>
              </li>
              <li class="flex items-center justify-between gap-2 border-b border-white/[0.05] pb-1.5">
                <span class="flex items-center gap-2">
                  <span>Snapdragon 8 Gen 2</span>
                  <span class="rounded bg-white/10 px-1.5 py-0.5 text-[10px] font-mono text-gold">2023</span>
                </span>
                <span class="font-mono text-text-tertiary">SM8550</span>
              </li>
              <li class="flex items-center justify-between gap-2">
                <span class="flex items-center gap-2">
                  <span>Snapdragon 8 Gen 1 / 8+ Gen 1</span>
                  <span class="rounded bg-white/10 px-1.5 py-0.5 text-[10px] font-mono text-gold">2022</span>
                </span>
                <span class="font-mono text-text-tertiary">SM8450 / SM8475</span>
              </li>
            </ul>
          </div>
          <div>
            <div class="text-xs font-bold text-enhanced uppercase tracking-wider mb-3">MediaTek Dimensity</div>
            <ul class="space-y-2.5 text-xs text-text-secondary">
              <li class="flex items-center justify-between gap-2 border-b border-white/[0.05] pb-1.5">
                <span class="flex items-center gap-2">
                  <span>Dimensity 9400</span>
                  <span class="rounded bg-white/10 px-1.5 py-0.5 text-[10px] font-mono text-enhanced">2024</span>
                </span>
                <span class="font-mono text-text-tertiary">MT6991</span>
              </li>
              <li class="flex items-center justify-between gap-2 border-b border-white/[0.05] pb-1.5">
                <span class="flex items-center gap-2">
                  <span>Dimensity 9300 / 9300+</span>
                  <span class="rounded bg-white/10 px-1.5 py-0.5 text-[10px] font-mono text-enhanced">2023</span>
                </span>
                <span class="font-mono text-text-tertiary">MT6989</span>
              </li>
              <li class="flex items-center justify-between gap-2 border-b border-white/[0.05] pb-1.5">
                <span class="flex items-center gap-2">
                  <span>Dimensity 8400 / 8450</span>
                  <span class="rounded bg-white/10 px-1.5 py-0.5 text-[10px] font-mono text-enhanced">2024</span>
                </span>
                <span class="font-mono text-text-tertiary">MT6899</span>
              </li>
              <li class="flex items-center justify-between gap-2">
                <span class="flex items-center gap-2">
                  <span>Dimensity 8300-Ultra / 8350</span>
                  <span class="rounded bg-white/10 px-1.5 py-0.5 text-[10px] font-mono text-enhanced">2023</span>
                </span>
                <span class="font-mono text-text-tertiary">MT6897</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <p class="mt-8 text-sm text-text-secondary" data-animate="fade-up">
      Everything except the enhancer runs on every phone on Android 8.0 or newer.
    </p>
    <p class="mt-2 text-xs text-text-tertiary">
      <span class="font-mono">arm64-v8a · armeabi-v7a · x86_64</span> — one release, all three ABIs.
    </p>
  </Container>
</section>
