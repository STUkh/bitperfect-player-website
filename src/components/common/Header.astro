---
/*
  The site's entry to the React `Header`: it supplies the current path and mounts
  the burger's behaviour, which the static render cannot carry (nothing hydrates).
  Claude Design renders `Header.tsx` directly, where `useBehaviour` mounts it.
*/
import Header from './Header.tsx';
---

<Header pathname={Astro.url.pathname} />

<script>
  import { setupMobileMenu } from './MobileMenu.client';

  document.querySelectorAll<HTMLElement>('[data-mobile-menu-toggle]').forEach((el) => setupMobileMenu(el));
</script>
