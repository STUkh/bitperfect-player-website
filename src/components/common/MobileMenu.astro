---
import { navLinks } from '../../data/navigation';
import { site } from '../../data/site';
import Button from './Button';
import { isActive, resolveHref } from '../../utils/nav';

interface Props {
  pathname?: string;
}

const { pathname = '/' } = Astro.props;
---

<div
  id="mobile-menu"
  class="pointer-events-none invisible fixed inset-0 z-40 flex flex-col bg-surface-base/98 backdrop-blur-xl opacity-0 transition-opacity duration-200 lg:hidden"
  aria-hidden="true"
  inert
>
  <div class="relative flex min-w-0 flex-1 flex-col overflow-y-auto px-6 pt-24 pb-8">
    {/*
      There is no close button in this panel, and that is the fix rather than the
      omission.

      One lived here at `top-6 right-6` — 326,24 40x40 — under the header's burger
      toggle at 326,10 44x44. The header is `z-50` and this panel is `z-40`, so the
      burger sat ON TOP of it and swallowed every pointer event aimed at the ✕; the
      control could not be clicked, only tabbed to. The burger is already the close
      control: it animates into an ✕ when the panel opens, it is the thing a user
      actually hits, and it is painted over the spot where the duplicate stood. What
      was left underneath was a second focusable "Close menu" that a screen reader
      announced twice and a mouse could never reach.

      It also carried `href="#"`, and the script's close handler is bound to every
      `<a>` in this panel without calling `preventDefault`, so on the one input
      method that did reach it — the keyboard — dismissing the menu pushed a history
      entry and threw the reader back to the top of the page.

      Dismissal is: the burger, or Escape. Both are bound below.
    */}

    {/* Main nav links */}
    <nav class="flex flex-col gap-6" aria-label="Mobile Navigation">
      {
        navLinks.map((link) => {
          const active = isActive(pathname, link.href);
          return (
            <a
              href={resolveHref(link.href, pathname)}
              class:list={[
                'mobile-nav-link cursor-pointer rounded-chip text-2xl font-semibold focus-visible:focus-ring',
                active
                  ? 'mobile-nav-link-active text-text-primary'
                  : 'text-text-secondary hover:text-text-primary active:text-gold',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    {/* CTA */}
    <div class="mt-10 border-t border-border-subtle pt-8">
      {/* `size="lg"` brings px-9. A full-width button needs none of it, and at
          320px the 72px of horizontal padding pushed the panel 7px past the
          viewport, giving the whole page a horizontal scrollbar. */}
      <Button
        href={site.playUrl}
        rel="noopener noreferrer"
        variant="primary"
        size="lg"
        className="w-full gap-2 px-5 text-center"
      >
        <svg class="h-[22px] w-[22px] shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M7.5 4.75 19 12 7.5 19.25Z" />
        </svg>
        Get it on Google Play
      </Button>
    </div>
  </div>
</div>

<style>
  #mobile-menu:target {
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
  }
  .mobile-nav-link {
    position: relative;
    transition: color var(--d-ui) var(--ease-ui);
  }

  /* A hairline grows in under the hovered link, the same gesture the desktop
     nav uses. The active link keeps its own fixed 36px rule below. */
  .mobile-nav-link:not(.mobile-nav-link-active)::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 36px;
    height: 2px;
    background: var(--color-gold);
    border-radius: 1px;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--d-ui) var(--ease-ui);
  }
  .mobile-nav-link:not(.mobile-nav-link-active):hover::after,
  .mobile-nav-link:not(.mobile-nav-link-active):focus-visible::after {
    transform: scaleX(1);
  }
  .mobile-nav-link-active {
    color: var(--color-text-primary);
  }
  .mobile-nav-link-active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 36px;
    height: 2px;
    background: var(--color-gold);
    border-radius: 1px;
  }
</style>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const burgerTop = document.getElementById('burger-top');
  const burgerMid = document.getElementById('burger-mid');
  const burgerBot = document.getElementById('burger-bot');
  const menuLinks = menu?.querySelectorAll<HTMLAnchorElement>('a');
  let isOpen = false;

  function openMenu() {
    isOpen = true;
    menu?.classList.remove('opacity-0', 'pointer-events-none', 'invisible');
    menu?.classList.add('opacity-100', 'pointer-events-auto');
    menu?.removeAttribute('aria-hidden');
    menu?.removeAttribute('inert');
    toggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';

    burgerTop?.classList.add('rotate-45', 'translate-y-[8px]');
    burgerMid?.classList.add('opacity-0');
    burgerBot?.classList.add('-rotate-45', '-translate-y-[8px]', 'w-6');

    // Move focus into the menu so keyboard users land somewhere useful.
    menuLinks?.[0]?.focus();
  }

  function closeMenu(returnFocus = false) {
    isOpen = false;
    menu?.classList.remove('opacity-100', 'pointer-events-auto');
    menu?.classList.add('opacity-0', 'pointer-events-none', 'invisible');
    menu?.setAttribute('aria-hidden', 'true');
    menu?.setAttribute('inert', '');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';

    burgerTop?.classList.remove('rotate-45', 'translate-y-[8px]');
    burgerMid?.classList.remove('opacity-0');
    burgerBot?.classList.remove('-rotate-45', '-translate-y-[8px]', 'w-6');

    if (returnFocus) toggle?.focus();
  }

  toggle?.addEventListener('click', () => {
    isOpen ? closeMenu() : openMenu();
  });

  menuLinks?.forEach((link) => {
    link.addEventListener('click', () => closeMenu());
  });


  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) closeMenu(true);
  });
</script>
