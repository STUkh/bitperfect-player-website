---
import Container from './common/Container.astro';
import Icon from './Icon.astro';
import SpectrumPlot from './SpectrumPlot.astro';
import Compatibility from './Compatibility.astro';

const constellationTracks = [
  {
    role: 'Root Seed Track',
    title: 'Slow Water',
    artist: 'Ilse Vane',
    format: 'FLAC 24/96',
    acousticTraits: 'Warm acoustic resonance, open hall reverberation, fingerstyle guitar',
  },
  {
    role: 'Acoustic Neighbour 1',
    title: 'Glass Harbour',
    artist: 'Petra Lindt',
    format: 'FLAC 16/44.1',
    acousticTraits: 'Shared modal harmony, quiet piano timbre, gentle tempo alignment',
  },
  {
    role: 'Acoustic Neighbour 2',
    title: 'Vespers',
    artist: 'The Anders Field',
    format: 'ALAC 24/48',
    acousticTraits: 'Coherent dynamic envelope, subtle percussion, close vocal presence',
  },
];
---

<section id="ai" class="section-py relative overflow-hidden">
  {/* Ambient warm lighting glows */}
  <div
    class="pointer-events-none absolute -top-40 right-0 h-[600px] w-[600px] rounded-full bg-enhanced/10 blur-[130px]"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute bottom-1/4 -left-40 h-[500px] w-[500px] rounded-full bg-gold/10 blur-[120px]"
    aria-hidden="true"
  >
  </div>

  <Container class="relative z-10 space-y-16 sm:space-y-24">
    {/* Section Header */}
    <div class="max-w-2xl" data-animate="fade-up">
      <p class="mb-4 text-eyebrow text-gold">On-Device AI</p>
      <h2 class="heading-section">
        The models live <span class="text-gold">on the phone</span>
      </h2>
      <p class="mt-4 text-base text-text-secondary sm:text-lg">
        An enhancer that reconstructs what lossy encoding discarded, and local acoustic analysis that maps your library. Both models execute entirely on your device — nothing is uploaded. No audio, no fingerprints, no listening telemetry.
      </p>
    </div>

    {/* Primary Block: AI Enhancer */}
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div data-animate="slide-left">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-enhanced/30 bg-enhanced/10 px-3.5 py-1 text-xs font-semibold text-enhanced">
          <Icon name="sparkle" size={14} />
          <span>Real-time neural restoration</span>
        </div>
        <h3 class="mb-4 text-2xl font-bold text-white sm:text-3xl lg:text-4xl">AI Enhancer</h3>
        <p class="mb-4 max-w-prose text-base leading-relaxed text-text-secondary">
          Lossy encoding discards high-frequency detail and introduces quantization noise.
          During playback, the enhancer reconstructs a plausible estimate of missing
          content in-band, predicting coherent phase alongside amplitude without artificial harshness.
        </p>
        <p class="mb-4 max-w-prose text-base leading-relaxed text-text-secondary">
          The original container sample rate is strictly preserved with zero resampling.
          When active, the signal indicator updates honestly to <strong class="font-semibold text-enhanced">Enhanced</strong>.
          The player never claims a bit-perfect purity that active DSP has modified.
        </p>
        <p class="max-w-prose text-sm leading-relaxed text-text-tertiary">
          Neural restoration executes locally on your device accelerator and only activates after measuring throughput to verify real-time operation.
        </p>

        <a href="#compatibility" class="ai-link mt-6 inline-flex items-center gap-2 text-sm font-semibold text-gold">
          <span>Check accelerator compatibility</span>
          <Icon name="arrow" size={15} />
        </a>
      </div>

      <div data-animate="slide-right">
        <SpectrumPlot />
      </div>
    </div>

    {/* Secondary Block: Sonic Scan & Similar Tracks */}
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="lg:order-2" data-animate="slide-right">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-gold/30 bg-gold/10 px-3.5 py-1 text-xs font-semibold text-gold">
          <Icon name="waveform" size={14} />
          <span>Local library intelligence</span>
        </div>
        <h3 class="mb-4 text-2xl font-bold text-white sm:text-3xl lg:text-4xl">Sonic Scan &amp; Similar Tracks</h3>
        <p class="mb-4 max-w-prose text-base leading-relaxed text-text-secondary">
          Sonic Scan analyzes your local audio files to map acoustic profiles
          directly on your phone, evaluating harmonic density, rhythm signatures, and spectral
          balance across your collection.
        </p>
        <p class="mb-4 max-w-prose text-base leading-relaxed text-text-secondary">
          Similar Tracks uses local acoustic matching to find natural neighbours.
          Select any song in your library to start a seamless queue of acoustically coherent
          tracks from your own music files.
        </p>
        <p class="max-w-prose text-sm leading-relaxed text-text-tertiary">
          The analysis runs efficiently on any modern processor without dedicated neural hardware. Your library index stays local: zero data is ever transmitted over the network.
        </p>
      </div>

      <div class="lg:order-1" data-animate="slide-left">
        <figure
          class="glass accent-glow overflow-hidden rounded-2xl relative"
          style="--card-accent: var(--color-gold)"
          aria-label="Demonstration of Similar Tracks local acoustic matching"
        >
          <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold/40 to-transparent" aria-hidden="true"></div>

          <div
            class="flex items-center justify-between border-b border-border-subtle bg-white/[0.02] px-5 py-4"
          >
            <div class="flex items-center gap-2 text-xs font-semibold text-gold uppercase tracking-wider">
              <Icon name="sparkle" size={15} />
              <span>Acoustic Constellation</span>
            </div>
            <span class="text-xs text-text-tertiary font-medium">
              Local acoustic matching
            </span>
          </div>

          <div class="p-4 sm:p-5 space-y-3">
            {
              constellationTracks.map((item) => (
                <div class="rounded-xl border border-border-subtle bg-surface-base p-3.5 transition-colors hover:border-gold/30">
                  <div class="flex items-center gap-3.5">
                    <div class="flex-center h-10 w-10 shrink-0 rounded-lg bg-surface-raised border border-border-subtle text-gold" aria-hidden="true">
                      <Icon name="waveform" size={18} />
                    </div>

                    <div class="flex-1 min-w-0">
                      <div class="flex items-baseline justify-between gap-2">
                        <div class="truncate">
                          <span class="text-sm font-bold text-white">{item.title}</span>
                          <span class="text-xs text-text-tertiary ml-1.5">{item.artist}</span>
                        </div>
                        <span class="shrink-0 font-mono text-xs text-gold font-medium">{item.format}</span>
                      </div>
                      <p class="mt-0.5 text-xs text-text-secondary truncate">
                        {item.acousticTraits}
                      </p>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>

          <figcaption class="border-t border-border-subtle bg-black/20 px-5 py-3.5 text-xs leading-relaxed text-text-tertiary">
            Natural acoustic sequencing. Queues are generated entirely on-device from your indexed library files with zero network communication.
          </figcaption>
        </figure>
      </div>
    </div>

    {/* Nested Compact Compatibility Block */}
    <Compatibility />

    {/* Pro Callout Banner */}
    <div
      class="glass accent-glow rounded-2xl p-6 sm:p-8 flex flex-col sm:flex-row sm:items-center justify-between gap-6 relative overflow-hidden"
      style="--card-accent: var(--color-gold)"
      data-animate="fade-up"
    >
      <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold/40 to-transparent" aria-hidden="true"></div>

      <div>
        <h4 class="text-lg sm:text-xl font-bold text-white">AI features are included with Pro</h4>
        <p class="mt-1 text-sm sm:text-base text-text-secondary">
          All AI models run on-device. Core playback, bit-perfect USB output, and the 32-band parametric EQ are free forever.
        </p>
      </div>
      <a
        href="#pricing"
        class="btn-primary-gradient shrink-0 inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-semibold text-on-gold transition-transform hover:scale-[1.02]"
      >
        <span>View Pro pricing</span>
        <Icon name="arrow" size={15} />
      </a>
    </div>
  </Container>
</section>

<style>
  .ai-link {
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: border-color 0.2s var(--ease-out-expo);
  }
  .ai-link:hover {
    border-bottom-color: var(--color-gold);
  }
</style>
