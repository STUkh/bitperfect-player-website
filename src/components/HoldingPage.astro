---
/**
 * The holding page. One screen, one picture, one action.
 *
 * The whole site is parked behind this while it is rebuilt: `/` and everything a
 * dead link can reach render this component, and only `/privacy`, `/terms` and
 * their `/policy` alias still serve their own content. The full pages are parked,
 * not deleted, under `src/pages/_index.astro` and `src/pages/_features/` — Astro
 * does not route a path with a leading underscore, so bringing the site back is a
 * rename rather than a restore.
 *
 * WHY IT IS NOT `ContentLayout`. That layout brings the fixed header, the mobile
 * menu and the seven-column footer, all of which name routes that no longer
 * build. A holding page whose navigation is a list of 404s is worse than one with
 * no navigation, so this carries its own bar and its own footer, and the only
 * links on it are the three destinations that still exist.
 *
 * THE PICTURE. `public/img/holding/needle.webp`: a cartridge suspended above the
 * groove, not touching it. It is the argument the page is making, which is why
 * there is no second graphic and no progress bar. The site's house style is
 * cinematic macro photography of hardware in graphite with one warm gold rake
 * (DESIGN.md, "Imagery"), and this was generated to it and floored to
 * `surface-base` by `design/holding.mjs` so its darks and the page's ground are
 * the same value.
 *
 * There is no percentage anywhere on this page. A number would have to be
 * invented, and CONTENT.md does not allow an invented number on a marketing
 * surface however small it is. The hairline under the copy carries the same
 * "something is still running" idea honestly: a signal sweeping a line, not a
 * bar filling toward a date nobody has committed to.
 *
 * MOTION. DESIGN.md's Still Fold Rule: copy on the first screen paints on load
 * rather than waiting for an observer, so nothing here carries a reveal class and
 * this component ships no script. The sweep is the page's only movement and it
 * has a real resting state under `prefers-reduced-motion`.
 */
import Container from './common/Container.astro';
import Logo from './common/Logo.astro';
import { site } from '../data/site';
import { withBase } from '../utils/nav';

interface Props {
  /** The plain-language line above the headline. Never a pill: DESIGN.md, "No Badge Above the Headline". */
  eyebrow: string;
  headline: string;
  lede: string;
}

const { eyebrow, headline, lede } = Astro.props;
---

<div class="holding">
  {/*
    ONE picture element, two layouts. A phone gets the 3:4 crop and a desktop the
    full landscape negative, and `<source media>` means only one of the two is
    ever fetched — `hidden` on a duplicate <img> would download both.

    `aria-hidden` and an empty alt: it is the section's ground, not information.
    Everything it says, the headline says in words.
  */}
  <picture class="plate" aria-hidden="true">
    <source media="(max-width: 1023px)" srcset={withBase('img/holding/needle-portrait.webp')} />
    <img
      src={withBase('img/holding/needle.webp')}
      alt=""
      width="1536"
      height="1024"
      loading="eager"
      decoding="async"
    />
  </picture>
  <div class="scrim" aria-hidden="true"></div>

  <header class="bar">
    <Container>
      <div class="flex h-16 items-center lg:h-20">
        <a href={withBase('/')} class="wordmark focus-visible:focus-ring">
          <Logo size="md" />
          <span class="text-body-sm font-bold whitespace-nowrap text-text-primary sm:text-body-lg">
            Bitperfect<span class="hidden sm:inline"> Player</span>
          </span>
        </a>
      </div>
    </Container>
  </header>

  <main id="main-content" class="stage">
    <Container class="lg:px-20">
      <div class="column">
        <span class="mono-spec block text-micro tracking-[1.9px] text-gold uppercase">
          {eyebrow}
        </span>

        <h1 class="mt-4 text-display-m text-balance text-text-primary md:text-headline lg:mt-5 lg:text-headline-xl">
          {headline}
        </h1>

        <p class="mt-5 max-w-[42ch] text-body-sm text-pretty text-text-secondary lg:mt-7 lg:text-lede">
          {lede}
        </p>

        {/* The one moving thing on the page. See the note at the top of this file. */}
        <div class="signal" role="presentation"></div>

        <div class="actions">
          <a
            href={site.playUrl}
            rel="noopener noreferrer"
            class="btn-primary-gradient focus-visible:focus-ring inline-flex h-[52px] cursor-pointer items-center justify-center gap-2.5 rounded-full px-7 text-body-sm font-semibold text-on-gold lg:h-[54px] lg:px-[30px]"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M5 3.5v17a1 1 0 0 0 1.52.86l14-8.5a1 1 0 0 0 0-1.72l-14-8.5A1 1 0 0 0 5 3.5Z"></path>
            </svg>
            <span>Get it on Google Play</span>
          </a>

          {/*
            The two documents that are still live, stated as the two documents they
            are. `nav` rather than a pair of loose links: on a page with no header
            navigation, this IS the navigation.
          */}
          <nav class="quiet" aria-label="Legal">
            <a class="quiet-link focus-visible:focus-ring" href={withBase('privacy')}>Privacy policy</a>
            <span class="quiet-sep" aria-hidden="true"></span>
            <a class="quiet-link focus-visible:focus-ring" href={withBase('terms')}>Terms of Use</a>
          </nav>
        </div>
      </div>
    </Container>
  </main>

  <footer class="foot">
    <Container>
      <div class="foot-row">
        <p class="text-caption text-text-tertiary">
          &copy; {new Date().getFullYear()} {site.name}
        </p>
        <div class="foot-right">
          <a class="foot-link focus-visible:focus-ring" href={`mailto:${site.contactEmail}`}>
            {site.contactEmail}
          </a>
          {/* The package id, once, as an identifier. DESIGN.md: never as a flourish. */}
          <span class="mono-spec text-caption text-text-tertiary">{site.packageId}</span>
        </div>
      </div>
    </Container>
  </footer>
</div>

<style>
  /*
    `100svh`, not `100vh`. On a phone the large viewport unit puts the footer
    behind the browser's own chrome on first paint, and this page is exactly one
    screen tall by design, so the one place it must not overflow is the one place
    `vh` overflows.
  */
  .holding {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 100svh;
    overflow: hidden;
    background-color: var(--color-surface-base);
  }

  /*
    The plate. On a phone it is a band along the foot and the copy sits above it;
    from `lg` it becomes the whole ground and the copy moves into the empty left
    third the photograph was composed to leave.
  */
  .plate {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 46svh;
    z-index: 0;
  }
  /*
    52%, not centre. The 3:4 crop is mostly the empty air above the cartridge, so
    a centred cover in a half-height band shows air and cuts the stylus off under
    the footer. Pulling the window down seats the cartridge in the middle of the
    band with the groove field under it and the tip clear of the footer rule.
  */
  .plate img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 52%;
  }

  .scrim {
    position: absolute;
    inset: 0;
    z-index: 0;
    /*
      Phone: the band is sat into the page ground from above, so the copy never
      lands on picture. Solid past the band's top edge and off by 80%, which
      covers the plate's empty air and nothing else: the cartridge starts at
      about 72% of the screen and is clear of the wash by the time it does.
    */
    background:
      linear-gradient(
        180deg,
        var(--color-surface-base) 0%,
        var(--color-surface-base) 58%,
        rgba(25, 25, 25, 0.82) 66%,
        rgba(25, 25, 25, 0.34) 72%,
        rgba(25, 25, 25, 0.08) 76%,
        transparent 81%
      );
  }

  @media (min-width: 1024px) {
    .plate {
      inset: 0;
      height: auto;
    }
    .plate img {
      object-position: 62% 50%;
    }
    /*
      Desktop: the wash runs left to right instead, because the photograph put its
      subject on the right and its emptiness on the left. The two vertical stops
      at the end seat the bar and the footer rules against the picture; without
      them a hairline rule crosses a lit groove and stops looking like a rule.
    */
    .scrim {
      background:
        linear-gradient(
          90deg,
          var(--color-surface-base) 0%,
          rgba(25, 25, 25, 0.94) 30%,
          rgba(25, 25, 25, 0.62) 48%,
          rgba(25, 25, 25, 0.16) 68%,
          transparent 84%
        ),
        linear-gradient(
          180deg,
          rgba(25, 25, 25, 0.66) 0%,
          transparent 16%,
          transparent 78%,
          rgba(25, 25, 25, 0.78) 100%
        );
    }
  }

  .bar {
    position: relative;
    z-index: 1;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  /* The -mx/-my pair cancels the padding, so the hover wash has room without
     moving the wordmark by a pixel. Same treatment as the site header. */
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin: -0.25rem -0.5rem;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background-color var(--d-ui) var(--ease-ui);
  }
  .wordmark:hover {
    background-color: rgba(255, 255, 255, 0.045);
  }
  .wordmark:active {
    background-color: rgba(255, 255, 255, 0.07);
  }

  /*
    THREE vertical arrangements, because the picture is in a different place in
    each of them and the copy has to answer for that.

    PHONE. The copy sits at the top and reserves NO room for the plate. It cannot
    afford to: one screen at 740px holds a bar, a footer, five elements of copy
    and a 46svh band, and reserving the band as padding pushes the total past the
    fold and puts the stylus behind the browser chrome. The copy finishes at about
    56% of the screen and the cartridge starts at about 72%, so the two never meet;
    what lies between them is the plate's own empty air with the wash still on it.

    TABLET. There is height to spare, so the band IS reserved and the copy centres
    in what is left. Top-aligned at 834x1112 it left a 300px void in the middle of
    the page with all the weight at the two ends.

    DESKTOP. The plate becomes the whole ground and the copy moves into the empty
    left third the photograph was composed to leave.
  */
  .stage {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .stage {
      align-items: center;
      padding-bottom: 46svh;
    }
    /*
      A tablet is wide enough that the 3:4 crop has to be scaled to its WIDTH,
      which throws most of the picture's height away. At the phone's 52% the
      window lands above the subject and the stylus tip is cut off by the bottom
      of the screen; 72% pulls the window down onto the cartridge, which also
      closes most of the void between the copy and the picture.
    */
    .plate img {
      object-position: center 72%;
    }
  }

  @media (min-width: 1024px) {
    .stage {
      align-items: center;
      padding-top: 0;
      padding-bottom: 0;
    }
  }

  .column {
    max-width: 40rem;
  }

  /*
    A signal crossing a line, not a bar filling toward a date. It reads as
    "something is still running here" without stating a number this page has no
    right to state.
  */
  .signal {
    position: relative;
    width: 100%;
    max-width: 22rem;
    height: 1px;
    margin-top: 1.75rem;
    overflow: hidden;
    background-color: var(--color-border-subtle);
    border-radius: var(--radius-hairline);
  }
  .signal::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 30%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-gold-deep) 34%,
      var(--color-gold) 50%,
      var(--color-gold-deep) 66%,
      transparent 100%
    );
    transform: translateX(-100%);
    animation: signal-sweep 5.4s var(--ease-ui) infinite;
  }

  @keyframes signal-sweep {
    0% {
      transform: translateX(-100%);
    }
    /* 30% of the track per step of 100%, so 333% carries the far edge off the
       right end. The pause lives at the end of the timeline rather than in a
       delay, which keeps every repeat identical. */
    62%,
    100% {
      transform: translateX(340%);
    }
  }

  /*
    The Reduced Motion Rule. The global reset drops every animation to 0.01ms,
    which would leave this element parked at the END of its timeline and
    therefore invisible. A resting state has to be stated, not inherited: the
    line simply reads as a quiet gold rule.
  */
  @media (prefers-reduced-motion: reduce) {
    .signal::after {
      animation: none;
      width: 100%;
      transform: none;
      background: linear-gradient(
        90deg,
        var(--color-gold-deep) 0%,
        rgba(179, 129, 47, 0) 100%
      );
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-top: 1.75rem;
  }

  /* The phone's rhythm is compressed because its budget is a single screen. From
     the tablet up there is height to spend and the copy breathes. */
  @media (min-width: 640px) {
    .signal,
    .actions {
      margin-top: 2.75rem;
    }
  }

  .quiet {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /*
    Matched to the primary's height rather than set as a 14px caption beside it.
    A pill and a bare word on one baseline read as a button with a stray label;
    matched heights read as two choices. Same reasoning as the 404 page's second
    exit, which this replaces.
  */
  .quiet-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.125rem;
    color: var(--color-text-secondary);
    font-size: var(--text-small);
    cursor: pointer;
    transition:
      color var(--d-ui) var(--ease-ui),
      box-shadow var(--d-ui) var(--ease-ui);
  }
  .quiet-link:hover {
    color: var(--color-gold);
    box-shadow: inset 0 -1px 0 var(--color-gold);
  }
  .quiet-link:active {
    color: var(--color-gold-deep);
    box-shadow: inset 0 -1px 0 var(--color-gold-deep);
  }

  .quiet-sep {
    width: 1px;
    height: 14px;
    background-color: var(--color-border-subtle);
  }

  .foot {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--color-border-subtle);
    /* Notched phones. `footer-safe-bottom` in global.css does this for the site
       footer; this one is not that component, so it states it itself. */
    padding-block: 1.25rem;
    padding-bottom: max(1.25rem, env(safe-area-inset-bottom));
  }

  /*
    The footer stands ON the picture, so it brings its own ground with it.

    Without this the copyright line and the package id sit over the stylus and
    the lit grooves, which is where the plate is brightest, and on a 360px phone
    the mono identifier was set in white over gold. The wash starts above the
    rule so the rule itself lands on an even value rather than crossing a groove:
    a hairline over a lit edge stops reading as a hairline.
  */
  .foot::before {
    content: '';
    position: absolute;
    inset: -2.75rem 0 0 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(25, 25, 25, 0.5) 42%,
      rgba(25, 25, 25, 0.9) 100%
    );
  }
  .foot-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .foot-right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
  }
  @media (min-width: 640px) {
    .foot-row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .foot-link {
    color: var(--color-text-tertiary);
    font-size: var(--text-caption);
    cursor: pointer;
    border-radius: var(--radius-chip);
    transition: color var(--d-ui) var(--ease-ui);
  }
  .foot-link:hover {
    color: var(--color-text-secondary);
  }
  .foot-link:active {
    color: var(--color-gold);
  }
</style>
