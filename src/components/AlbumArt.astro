---
/**
 * Authored cover art for the demo track — synthetic content.
 * Drawn with warm obsidian tones, subtle golden anisotropic sheen,
 * and precision concentric micro-grooves matching the black/gold glass system.
 */
export interface Props {
  class?: string;
  variant?: 1 | 2;
}

const { class: cls = '', variant = 1 } = Astro.props;
const uid = `art-${variant}`;
---

<svg
  class={`album-art-disc ${cls}`}
  viewBox="0 0 300 300"
  role="img"
  aria-label="Spun golden grooves artwork"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    {/* Warm obsidian vinyl disc gradient */}
    <radialGradient id={`${uid}-vinyl`} cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color={variant === 1 ? '#241a0e' : '#181424'} />
      <stop offset="35%" stop-color={variant === 1 ? '#16110a' : '#110e1a'} />
      <stop offset="70%" stop-color="#0c0906" />
      <stop offset="100%" stop-color="#040302" />
    </radialGradient>

    {/* Warm golden sheen / specular light across grooves */}
    <radialGradient id={`${uid}-sheen`} cx="32%" cy="24%" r="76%">
      <stop offset="0%" stop-color="#ffd36b" stop-opacity="0.32" />
      <stop offset="30%" stop-color="#e5b842" stop-opacity="0.14" />
      <stop offset="60%" stop-color="#b3861b" stop-opacity="0.04" />
      <stop offset="100%" stop-color="#000000" stop-opacity="0" />
    </radialGradient>

    {/* Center label gold rim gradient */}
    <linearGradient id={`${uid}-gold-rim`} x1="15%" y1="15%" x2="85%" y2="85%">
      <stop offset="0%" stop-color="#fbf6e9" />
      <stop offset="30%" stop-color="#f5d47a" />
      <stop offset="70%" stop-color="#e5b842" />
      <stop offset="100%" stop-color="#b3861b" />
    </linearGradient>

    {/* Tonearm curve stroke gradient */}
    <linearGradient id={`${uid}-arc`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#fbf6e9" stop-opacity="0.9" />
      <stop offset="50%" stop-color="#e5b842" stop-opacity="0.6" />
      <stop offset="100%" stop-color="#b3861b" stop-opacity="0.25" />
    </linearGradient>
  </defs>

  {/* Outer disc surface */}
  <rect width="300" height="300" fill={`url(#${uid}-vinyl)`} rx="16" />
  <rect width="300" height="300" fill={`url(#${uid}-sheen)`} rx="16" />

  {/* Outer rim border */}
  <rect width="298" height="298" x="1" y="1" fill="none" stroke="rgba(229, 184, 66, 0.18)" stroke-width="1" rx="15" />

  {/* Precision concentric micro-grooves */}
  <g fill="none" stroke={`url(#${uid}-arc)`} stroke-width="0.75">
    {
      Array.from({ length: 22 }, (_, i) => (
        <circle cx="150" cy="150" r={32 + i * 5.2} opacity={0.48 - i * 0.016} />
      ))
    }
  </g>

  {/* Run-out groove */}
  <circle cx="150" cy="150" r="48" fill="none" stroke="rgba(229, 184, 66, 0.35)" stroke-width="0.75" />

  {/* Center label (warm obsidian + gold bezel) */}
  <circle cx="150" cy="150" r="32" fill="#0c0906" stroke={`url(#${uid}-gold-rim)`} stroke-width="1.2" />
  <circle cx="150" cy="150" r="28" fill="#070605" stroke="rgba(229, 184, 66, 0.25)" stroke-width="0.5" />

  {/* Center spindle core */}
  <circle cx="150" cy="150" r="4" fill="#040302" stroke="rgba(229, 184, 66, 0.85)" stroke-width="1" />
  <circle cx="150" cy="150" r="1.8" fill="#e5b842" />

  {/* Harmonic accent curve */}
  {
    variant === 1 && (
      <path
        d="M150 38a112 112 0 0 1 102 66"
        fill="none"
        stroke="var(--color-gold)"
        stroke-width="1.5"
        stroke-linecap="round"
        opacity="0.7"
      />
    )
  }
  {
    variant === 2 && (
      <path
        d="M48 150a102 102 0 0 0 92 101"
        fill="none"
        stroke="var(--color-enhanced)"
        stroke-width="1.5"
        stroke-linecap="round"
        opacity="0.65"
      />
    )
  }
</svg>

<style>
  .album-art-disc {
    width: 100%;
    height: auto;
    display: block;
    border-radius: inherit;
  }
</style>
