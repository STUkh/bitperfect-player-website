---
/**
 * FAQ section: Native, accessible, and clear.
 * Anchored at #faq with Schema.org structured data.
 */
import Container from '../common/Container.astro';
import Accordion from '../faq/Accordion.astro';
import { faqItems } from '../../data/faq';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<section id="faq" class="section-py relative overflow-hidden">
  {/* Ambient warm glow */}
  <div
    class="pointer-events-none absolute top-1/2 left-0 h-[500px] w-[500px] rounded-full bg-gold/10 blur-[130px]"
    aria-hidden="true"
  >
  </div>

  <Container class="relative z-10">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      {/* Left: Sticky Header */}
      <div class="lg:sticky lg:top-32 lg:col-span-5 lg:self-start" data-animate="fade-up">
        <p class="mb-4 text-eyebrow text-gold">FAQ</p>
        <h2 class="mb-4 text-3xl leading-heading font-bold text-white sm:text-4xl lg:text-5xl">
          Questions worth asking
        </h2>
        <p class="text-base sm:text-lg text-text-secondary leading-relaxed">
          Direct answers about bit-perfect USB output, on-device AI models, device compatibility, and pricing.
        </p>
      </div>

      {/* Right: Clean Accordion Stack */}
      <div class="lg:col-span-7 divide-y divide-border-subtle border-t border-b border-border-subtle" data-animate="fade-up">
        {
          faqItems.map((item, i) => (
            <Accordion
              question={item.q}
              answer={item.a}
              id={`faq-${i}`}
              link={item.link}
              open={i === 0}
            />
          ))
        }
      </div>
    </div>
  </Container>
</section>

<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

<script>
  import '../../scripts/accordion.ts';
</script>
