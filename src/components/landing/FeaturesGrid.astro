---
import Container from '../common/Container.astro';
import SectionHeader from '../common/SectionHeader.astro';
import FeatureCard from './FeatureCard.astro';
import { features } from '../../data/features';
import { accentColors } from '../../data/colors';

/* Icon selection is a presentation concern, not content — kept here rather
   than in data/features.ts. Keyed by the feature `id`. */
const iconByFeatureId: Record<string, string> = {
  engine: 'node-engine',
  usb: 'node-usb',
  eq: 'eq',
  plugins: 'plug',
  casting: 'cast',
  library: 'library',
};
---

<section id="features" class="section-py relative">
  <Container>
    <SectionHeader eyebrow="Core Capabilities" eyebrowColor="text-gold" title="Everything in the signal path" />

    <!-- 1col phone → 2col tablet → 3col desktop -->
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3 lg:gap-5">
      {
        features.map((feature, i) => (
          <FeatureCard
            title={feature.title}
            description={feature.description}
            icon={iconByFeatureId[feature.id] ?? 'waveform'}
            accentToken={accentColors[feature.accent].token}
            glowPosition={
              (['top-left', 'bottom-right', 'top-right', 'bottom-left'] as const)[i % 4]
            }
          />
        ))
      }
    </div>
  </Container>
</section>
