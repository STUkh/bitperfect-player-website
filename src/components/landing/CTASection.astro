---
/**
 * Final CTA Section: Confident closing invitation.
 * Rebuilt in the warm black/gold glass system with clean ambient depth.
 */
import Container from '../common/Container.astro';
import StoreBadges from '../common/StoreBadges.astro';
import { site } from '../../data/site';
---

<section id="cta" class="py-20 sm:py-24 md:py-28 lg:py-36 relative overflow-hidden">
  {/* Ambient warm golden glow */}
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-[480px] bg-gradient-to-t from-gold/10 via-amber-500/5 to-transparent"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute bottom-0 left-1/2 -translate-x-1/2 h-[360px] w-[900px] rounded-full bg-gold/10 blur-[130px]"
    aria-hidden="true"
  >
  </div>

  <Container class="relative z-10">
    <div
      class="glass glass-elevated relative overflow-hidden rounded-3xl p-8 sm:p-14 md:p-18 text-center max-w-4xl mx-auto border border-border-subtle"
      data-animate="scale-in"
    >
      {/* Top rim specular highlight */}
      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold/40 to-transparent"
        aria-hidden="true"
      >
      </div>

      <div class="relative z-10 mx-auto max-w-2xl">
        <p class="mb-4 text-eyebrow text-gold">Begin Listening</p>
        <h2 class="mb-5 text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.08]">
          Put it on the phone and listen for <span class="text-gold">yourself</span>
        </h2>
        <p class="mx-auto mb-10 max-w-xl text-base sm:text-lg leading-relaxed text-text-secondary">
          Free to install, no account, nothing to sign up for. Plug in a DAC and watch the badge
          go bit-perfect.
        </p>

        {/* Download action: StoreBadges */}
        <div class="flex justify-center items-center">
          <StoreBadges variant="light" size="lg" class="justify-center items-center mx-auto" />
        </div>

        <p class="mt-8 text-xs font-semibold tracking-wider text-text-tertiary uppercase">
          Android {site.minAndroid}+ <span aria-hidden="true" class="mx-1.5 opacity-40">·</span> {site.packageId}
        </p>
      </div>
    </div>
  </Container>
</section>
