---
/**
 * The held moment: three phones that arrive as one.
 *
 * The section is one viewport plus a 200vh track, and the stage inside it is
 * sticky, so the track length IS the pin duration. Writing the height as
 * `calc(100vh + var(--track))` avoids the usual off-by-one-screen mistake.
 *
 * The resting state is the finished lineup, declared in plain CSS: the centre
 * phone carries no transform at rest and the siblings sit one width plus the
 * gap out to either side. Scroll animates AWAY from that, so a crawler, a
 * blocked bundle and a reduced-motion visitor all get a real composition
 * rather than a broken one. Every frame writes transform only.
 *
 * The heading does not move (DESIGN.md, "The Still Fold Rule"): the phones are
 * the gesture, and a second one competing with them reads as a slideshow.
 */
import Container from '../common/Container.astro';
import PhoneFrame from '../feature/PhoneFrame.astro';
import PhoneScreen from '../feature/PhoneScreen.astro';
---

{/* Half a step up from the hero above it. Two graphite sections at the same
    value read as one long block, which is exactly the complaint the white
    close and this half-step are both answering. */}
<section class="showcase relative bg-surface-raised" data-showcase>
  <div
    class="stage bg-[radial-gradient(ellipse_120%_62%_at_50%_-6%,rgba(255,255,255,0.035)_0%,rgba(255,255,255,0.012)_42%,transparent_72%)]"
  >
    <Container class="lg:px-20">
      {/*
        No eyebrow. `The app itself` sat above `Every screen runs on the same
        engine.` and captioned a picture that captions itself, on a page that had
        eight of them. DESIGN.md, "The Eyebrow Budget Rule".
      */}
      <div class="text-center">
        <h2 class="text-section-sm text-balance text-text-primary lg:text-headline-sm">
          Every screen runs on the same engine.
        </h2>
      </div>
    </Container>

    <div class="riser" data-riser>
      <div class="fitbox">
        {/*
          Below 1024px this becomes a snapping strip rather than a lineup, and
          `data-strip` is what the script attaches a tab stop to there. The three
          screens are captures of the app carrying empty alt text, because this
          label already names all three; it is what carries them to anyone who is
          not looking at the picture.
        */}
        <div
          class="fit"
          data-strip
          role="group"
          aria-label="Three app screens: Now Playing, the 32-band EQ, and the library"
        >
          <div class="phone phone-side phone-left" data-phone="left">
            <PhoneFrame fill>
              <PhoneScreen name="eq" />
            </PhoneFrame>
          </div>
          <div class="phone phone-centre" data-phone="centre">
            <PhoneFrame fill>
              <PhoneScreen name="now-playing" />
            </PhoneFrame>
          </div>
          <div class="phone phone-side phone-right" data-phone="right">
            <PhoneFrame fill>
              <PhoneScreen name="library" />
            </PhoneFrame>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Track and pin ──
     The track length is the pin duration. Nothing below 1024px pins at all:
     a 100vh pin on a phone, against a resizing URL bar and touch momentum,
     cannot be made to work. */
  .showcase {
    /* A longer track reads as deliberate rather than eager — but only for as long
       as the track is CARRYING something. At 280vh it was not. Measured against the
       shipped build, the sequence finished at 75% of the track and the last 630px of
       pin held a frozen picture, while the first 630px held one phone shrinking by
       five per cent: two thirds of a metre of scroll where the page had stopped and
       nothing was happening. The pin cannot outlast the gesture. 200vh is what the
       retuned ranges below actually fill. */
    --track: 200vh;
    /* The centre phone's starting scale. Declared here because the LAYOUT has to
       reserve it; the script reads it back rather than keeping its own copy. */
    --peak: 1.2;

    /* ── Sizing the phone to the room, exactly ──
       The lineup is authored at the phone's REAL proportions now that the screens
       are captures: 300x640 of chassis around a 278x618 screen at 9:20. It was
       344x566, which is 1:1.65 and is not a shape any phone has had since 2016.

       What the stage spends before the phones get any of it: the FIXED SITE HEADER,
       the heading, the 56px gap under it, and a little air.

       The header is the part that is easy to forget and it is 81px of it. The stage
       centres its content, so a reserve that only counted the heading put the
       content's top offset at 26px — under a header that owns the top 81px and
       paints over it — and the section headline came out sliced through the middle
       by the nav. The stage now PADS by the header height so the centring happens in
       the room that is actually free, and the reserve counts that padding.

       The heading is one line on a wide viewport and two once the container narrows,
       which is the rest of the difference between the two values. */
    --header-h: 81px;
    --reserve: 300px;

    /* The phone takes the room the stage actually has, capped at its authored
       size — rather than being authored at one size and scaled down by a ladder of
       hand-tuned height breakpoints. The ladder was five guesses; this is the
       arithmetic, and it cannot be wrong at a viewport nobody tested. It has to be
       a SIZE and not a scale because `calc()` divides a length by a NUMBER and
       refuses to divide a length by a length. */
    --phone-h: min(640px, calc((100dvh - var(--reserve)) / var(--peak)));
    --phone-w: calc(var(--phone-h) * 0.46875);
    --gap: calc(var(--phone-w) * 0.08);
    height: calc(100vh + var(--track));
  }

  @media (min-width: 1280px) {
    .showcase {
      /* One line of heading rather than two. */
      --reserve: 240px;
    }
  }

  .stage {
    position: sticky;
    top: 0;
    display: flex;
    height: 100dvh;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    /* The site header is `position: fixed` and paints over anything under it.
       Centring inside the full viewport put the section headline behind the nav;
       centring inside the viewport MINUS the header puts it where it belongs. */
    padding-top: var(--header-h);
    /* The phone starts at its peak directly under this heading, so the gap is
       clearance, not decoration: at 40px the enlarged frame grazed the descenders. */
    gap: 56px;
    overflow: hidden;
  }

  /* ── Fitting the lineup to the viewport ──
     The composition is authored at one size and scaled to fit, so the phones
     keep their real proportions on a short or narrow viewport instead of
     having their screens cropped. Two independent limits, whichever bites. */
  .fitbox {
    /* Only WIDTH is left to fit. Height is handled above, by sizing the phone to
       the stage instead of scaling it afterwards, which is why the five
       `max-height` steps that used to live at the bottom of this file are gone. */
    --fit-w: 1;
    --fit: var(--fit-w);
    position: relative;
    width: calc((var(--phone-w) * 3 + var(--gap) * 2) * var(--fit));
    /* The box reserves the phone at its PEAK, not at rest.
       Scale is a transform, so it changes nothing about layout: reserving the
       resting height let a phone at 1.4x grow straight up through the heading,
       which is exactly what it did. The slack this leaves at rest is not waste,
       it is the room the phone descends through. */
    height: calc(var(--phone-h) * var(--peak) * var(--fit));
  }

  .fit {
    position: absolute;
    /* Biased low inside the reserved box. The phone starts ABOVE its resting
       position and descends to it, so centring the box exactly would spend that
       whole head start on the heading's descenders. The slack all sits below the
       lineup anyway, which is where a lineup wants its air. */
    top: calc(50% + 3vh);
    left: 0;
    width: calc(var(--phone-w) * 3 + var(--gap) * 2);
    height: var(--phone-h);
    transform: translateY(-50%) scale(var(--fit));
    transform-origin: 0 50%;
  }

  .phone {
    position: absolute;
    top: 0;
    left: calc(var(--phone-w) + var(--gap));
    width: var(--phone-w);
    height: var(--phone-h);
    /* Promote once, up front. Promoting on first frame causes a visible hitch
       exactly when the eye is on the element. */
    will-change: transform;
    backface-visibility: hidden;
  }

  /* Siblings sit behind the centre and share its box, so the spread is a
     translate of their own width and the gap stays constant at every size. */
  .phone-side {
    z-index: 1;
  }
  .phone-centre {
    z-index: 2;
    /* The shared phone chassis is a translucent glass gradient, so the sibling
       passing behind it during the sweep shows straight through the device. An
       opaque ground at the chassis radius makes the centre phone a solid object
       and the pass genuinely a pass. */
    background: var(--color-surface-raised);
    /* Matches `--radius-phone-outer`. A literal here, because this is a backdrop
       shaped to the chassis rather than a chassis; if that token moves, this moves
       with it or the opaque ground shows past the corners. */
    border-radius: 37px;
  }
  .phone-left {
    transform: translate3d(calc(-100% - var(--gap)), 0, 0);
  }
  .phone-right {
    transform: translate3d(calc(100% + var(--gap)), 0, 0);
  }

  /* Between 1024 and 1279 the container is narrower than three full-size phones
     plus their gaps (948px against 864px of content box at 1024). A tall viewport
     at that width is the only case where width, not height, is what bites. */
  @media (max-width: 1279px) {
    .fitbox {
      --fit-w: 0.9;
    }
  }

  /* ── Below 1024px: no pin, no lineup ──
     One phone, the one the section is about, at its own size. */
  @media (max-width: 1023px) {
    .showcase {
      height: auto;
    }
    .stage {
      position: static;
      height: auto;
      gap: 34px;
      padding-block: 56px;
    }
    .fitbox,
    .fit {
      position: static;
      width: auto;
      height: auto;
      transform: none;
    }
    .riser,
    .fitbox {
      width: 100%;
    }
    /*
      A SNAPPING STRIP, not one screenshot.

      The siblings used to be `display: none` here, which left the heading
      "Every screen runs on the same engine." sitting directly above a single
      screen. The mobile page did not argue its own headline.

      They cannot be a lineup at this width: three 296px phones need 928px. So
      they run edge to edge and snap, with the padding centring whichever one is
      current and leaving the next one peeking, which is the affordance. The
      centre phone is ordered first, so the strip opens on Now Playing.
    */
    .fit {
      display: flex;
      justify-content: flex-start;
      gap: 20px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding-inline: max(20px, calc((100% - 296px) / 2));
      padding-block: 4px;
    }
    .fit::-webkit-scrollbar {
      display: none;
    }
    .phone {
      position: static;
      /* An explicit width, not `auto`. The frame takes the parent's width in the
         lineup, so a strip item sized by its content would ask the frame how wide
         it is and the frame would ask back. 296px is the frame's own phone step. */
      width: 296px;
      height: auto;
      flex: 0 0 auto;
      transform: none;
      scroll-snap-align: center;
      will-change: auto;
    }
    .phone-side {
      display: block;
      opacity: 1;
    }
    .phone-centre {
      order: -1;
    }
  }

  /* ── Reduced motion ──
     No observer and no rAF loop: the finished lineup, at rest, with the track
     given back to the page. */
  @media (prefers-reduced-motion: reduce) {
    .showcase {
      height: auto;
    }
    .stage {
      position: static;
      height: auto;
      padding-block: 72px;
    }
  }
</style>

<script>
  /**
   * One scalar drives the whole composition: how far the section top has
   * scrolled past the viewport top, over the track length.
   *
   * The scalar is smoothed rather than the scroll (`pos += (raw - pos) * 0.15`,
   * a time constant near 110ms), so the page still scrolls natively. The loop
   * runs only while the section is on screen and stops as soon as the smoothed
   * value has caught up and no scroll is pending.
   */
  const section = document.querySelector<HTMLElement>('[data-showcase]');
  const strip = section?.querySelector<HTMLElement>('[data-strip]');
  const riser = section?.querySelector<HTMLElement>('[data-riser]');
  const centre = section?.querySelector<HTMLElement>('[data-phone="centre"]');
  const left = section?.querySelector<HTMLElement>('[data-phone="left"]');
  const right = section?.querySelector<HTMLElement>('[data-phone="right"]');

  if (section && riser && centre && left && right) {
    const GAP = 28;

    /* ── The choreography ──
     *
     * The centre phone arrives large and high, then DESCENDS and shrinks into the
     * row, so it reads as travelling on toward the next section rather than simply
     * getting smaller in place.
     *
     * Both siblings start stacked off to the RIGHT, behind the centre, and sweep
     * LEFT. The right one has a short journey and stops beside the centre. The left
     * one starts later, travels twice as far, and passes BEHIND the centre phone on
     * the way, disappearing under it and emerging on the far side. That pass is the
     * whole trick: they genuinely come out from behind it.
     *
     * Every range overlaps its neighbour. Sequential ranges read as a slideshow;
     * overlapping ones read as one gesture.
     */
    /* Read from CSS: the fitbox reserves this much height, so a second copy here
       would silently desynchronise the moment either one changed. */
    const PEAK =
      Number.parseFloat(getComputedStyle(section).getPropertyValue('--peak')) || 1.2;
    const DESCEND_VH = 0.06;
    const ENTER_X = 190;

    /** Where each part of the composition starts and stops, as a fraction of track.
     *
     * Retuned against a measurement of the shipped build rather than by eye. The
     * old ranges opened the sweeps at 0.26 and 0.34, so a quarter of the pin passed
     * before the second phone existed, and closed them under an easing that had spent
     * 99% of its travel by 0.75, so the last quarter was a still photograph. The
     * gesture ran from 0.26 to 0.72 — 46% of the track doing all of the work.
     *
     * Now the right phone leaves within the first tenth, the left one closes ON the
     * end of the track, and the two sweeps overlap the centre's settle rather than
     * queueing behind it. Every point of the track carries motion. */
    const R = {
      descend: [0.0, 0.62],
      grow: [0.0, 0.7],
      rightX: [0.08, 0.82],
      rightIn: [0.08, 0.32],
      leftX: [0.2, 1.0],
      leftIn: [0.2, 0.46],
    } as const;

    const desktop = window.matchMedia('(min-width: 1024px)');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    let enabled = false;
    let running = false;
    let pending = false;
    let pos = 1;
    let raw = 1;
    let vh = window.innerHeight;

    const clamp01 = (n: number) => (n < 0 ? 0 : n > 1 ? 1 : n);
    /** Normalise p into one sub-range. */
    const span = (p: number, [a, b]: readonly [number, number]) => clamp01((p - a) / (b - a));

    /* Deceleration is what reads as expensive. Expo for the sweeps, because a phone
       crossing 300% of its own width has to shed speed hard or it looks thrown.
       That still holds; the EXPONENT was the problem. At -10 the curve is 87% done
       by a third of its range and 99% done by two thirds, so the phone arrived long
       before its range did and the rest of the pin was a still. At -5, normalised so
       it still lands exactly on 1, the hard stop survives — 82% by half — and the
       last tenth of the range is worth 33px of visible travel instead of 1px.
       DESIGN.md, "The Tail Has To Be Worth Scrolling".

       The centre is the only thing moving through the opening, and it starts from a
       standstill: an ease-OUT there is at its fastest on the first frame, which is
       why the old opening spent its whole scale change in the first quarter and then
       crept. In-out cubic accelerates first, so the descent fills the opening. */
    const outExpo = (t: number) =>
      t >= 1 ? 1 : (1 - Math.pow(2, -5 * t)) / (1 - Math.pow(2, -5));
    const inOutCubic = (t: number) =>
      t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

    const read = () => {
      const rect = section.getBoundingClientRect();
      const track = rect.height - vh;
      raw = track > 0 ? clamp01(-rect.top / track) : 1;
    };

    const paint = (p: number) => {
      /* The centre: down and smaller, together, on one curve. */
      const settle = inOutCubic(span(p, R.descend));
      const grow = inOutCubic(span(p, R.grow));
      const y = (settle - 1) * DESCEND_VH * vh;
      centre.style.transform =
        `translate3d(0, ${y.toFixed(2)}px, 0) scale(${(PEAK - (PEAK - 1) * grow).toFixed(4)})`;

      /* The siblings: both sweep leftward off one shared start. */
      const rx = outExpo(span(p, R.rightX));
      const lx = outExpo(span(p, R.leftX));

      const rightX = ENTER_X - (ENTER_X - 100) * rx;
      const leftX = ENTER_X - (ENTER_X + 100) * lx;
      const rightGap = GAP * rx;
      const leftGap = -GAP * lx;

      right.style.transform =
        `translate3d(calc(${rightX.toFixed(3)}% + ${rightGap.toFixed(2)}px), 0, 0) ` +
        `scale(${(1.1 - 0.1 * rx).toFixed(4)})`;
      left.style.transform =
        `translate3d(calc(${leftX.toFixed(3)}% + ${leftGap.toFixed(2)}px), 0, 0) ` +
        `scale(${(1.1 - 0.1 * lx).toFixed(4)})`;

      /* They fade up over the first third of their own travel, so they emerge
         rather than slide in already finished. */
      right.style.opacity = span(p, R.rightIn).toFixed(3);
      left.style.opacity = span(p, R.leftIn).toFixed(3);

      /* The riser no longer moves the group: the descent belongs to the centre
         phone alone now, and two vertical motions at once read as drift. */
      riser.style.transform = 'translate3d(0, 0, 0)';
    };

    const frame = () => {
      if (!enabled) {
        running = false;
        return;
      }
      pending = false;
      read();
      /* A ~180ms time constant. 0.15 tracked the scroll almost exactly, which is
         accurate and reads as cheap; this trails it just enough to feel weighted. */
      pos += (raw - pos) * 0.1;
      if (Math.abs(raw - pos) < 0.0005 && !pending) {
        pos = raw;
        paint(pos);
        running = false;
        return;
      }
      paint(pos);
      requestAnimationFrame(frame);
    };

    const start = () => {
      if (running || !enabled) return;
      running = true;
      requestAnimationFrame(frame);
    };

    const onScroll = () => {
      pending = true;
      start();
    };

    const onResize = () => {
      vh = window.innerHeight;
      pending = true;
      start();
    };

    /* The listeners live only while the section is on screen. */
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            window.addEventListener('scroll', onScroll, { passive: true });
            pending = true;
            start();
          } else {
            window.removeEventListener('scroll', onScroll);
            read();
            pos = raw;
            paint(pos);
          }
        }
      },
      { threshold: 0 }
    );

    const enable = () => {
      if (enabled) return;
      enabled = true;
      vh = window.innerHeight;
      read();
      pos = raw;
      paint(pos);
      window.addEventListener('resize', onResize);
      observer.observe(section);
    };

    const disable = () => {
      if (!enabled) return;
      enabled = false;
      running = false;
      observer.unobserve(section);
      window.removeEventListener('resize', onResize);
      window.removeEventListener('scroll', onScroll);
      /* Hand the lineup back to the CSS resting state, opacity included. */
      for (const el of [riser, centre, left, right]) {
        el.style.transform = '';
        el.style.opacity = '';
      }
    };

    const sync = () => {
      if (desktop.matches && !reduced.matches) enable();
      else disable();
      /* SC 2.1.1: a scrollable region has to be reachable from the keyboard.
         It only scrolls below 1024px, so the tab stop only exists there. */
      if (strip) {
        if (desktop.matches) strip.removeAttribute('tabindex');
        else strip.setAttribute('tabindex', '0');
      }
    };

    desktop.addEventListener('change', sync);
    reduced.addEventListener('change', sync);
    sync();
  }
</script>
