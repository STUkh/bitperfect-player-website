---
/*
  The site's entry to the React `PhoneShowcase`: it mounts the scroll-driven
  choreography, which the static render cannot carry (nothing hydrates).
  Claude Design renders `PhoneShowcase.tsx` directly, where `useBehaviour`
  mounts it.
*/
import PhoneShowcase from './PhoneShowcase.tsx';
---

<PhoneShowcase />

<script>
  import { setupPhoneShowcase } from './PhoneShowcase.client';

  const section = document.querySelector<HTMLElement>('[data-showcase]');
  if (section) setupPhoneShowcase(section);
</script>
