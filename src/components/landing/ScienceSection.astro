---
import Container from '../common/Container.astro';
import SignalChain from '../SignalChain.astro';

const callouts = [
  'Native Rust engine — not a wrapper around the platform’s playback stack',
  'Exclusive USB Audio Class 2 output, claimed outright',
  'The file’s own bits reach the DAC unmodified',
];
---

<section id="engine" class="section-py relative">
  <Container>
    <div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Left: Text Content -->
      <div data-animate="slide-left" class="lg:sticky lg:top-24 lg:self-start">
        <p class="mb-4 text-eyebrow text-gold">The Engine</p>
        <h2 class="mb-6 heading-section">
          The engine takes the <span class="text-gold">output</span>, not a turn in the queue.
        </h2>
        <p class="mb-8 leading-relaxed text-text-secondary">
          Most Android players hand audio to the system mixer, which resamples whatever it likes
          to whatever the device happens to be running. Bitperfect claims the USB device node
          directly — exclusive access, no mixer in the path — and drives it at the file's own
          rate.
        </p>

        <!-- Annotated callouts -->
        <div class="space-y-3">
          {
            callouts.map((line) => (
              <div class="flex items-center gap-3">
                <div class="flex-center h-5 w-5 shrink-0 rounded-full bg-gold/15">
                  <svg
                    class="h-3 w-3 text-gold"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="3"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <span class="text-sm text-text-secondary">{line}</span>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Right: Signal chain diagram -->
      <div data-animate="slide-right">
        <p class="mb-4 text-xs font-medium tracking-label text-text-tertiary uppercase">
          One file, one path to the DAC
        </p>
        <SignalChain />
      </div>
    </div>
  </Container>
</section>
