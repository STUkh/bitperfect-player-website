---
import Container from '../common/Container.astro';
import SignalChain from '../SignalChain.astro';

const proofs = [
  {
    code: '01',
    title: 'Exclusive USB routing',
    body: 'The player opens compatible USB audio devices directly in exclusive mode, completely bypassing the shared Android system mixer and fixed 48 kHz resampling.',
    tag: 'HARDWARE DIRECT',
  },
  {
    code: '02',
    title: 'Truthful signal telemetry',
    body: 'Bit-perfect status is displayed only when source and DAC parameters match sample for sample. Turning on EQ or audio enhancement immediately updates the status indicator.',
    tag: 'HONEST TELEMETRY',
  },
  {
    code: '03',
    title: 'Precision DSP when desired',
    body: 'When you choose equalization, the engine delivers up to 32 parametric bands with seven filter types. Every stage is explicit, predictable, and never forced into the default path.',
    tag: '32-BAND EQ',
  },
];
---

<section id="engine" class="section-py relative scroll-mt-20">
  <Container>
    <div class="grid items-start gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16 xl:gap-20">
      <div class="lg:sticky lg:top-28" data-animate="slide-left">
        <div class="mb-4 inline-flex items-center gap-2 rounded-[3px] border border-border-subtle bg-surface-raised px-2.5 py-1">
          <span class="h-1.5 w-1.5 rounded-full bg-bitperfect" aria-hidden="true"></span>
          <span class="font-mono text-xs font-medium tracking-wider text-text-secondary uppercase">Engine Verification</span>
        </div>

        <h2 class="heading-section max-w-[12ch]">
          Bit-perfect is a result, not a mode name.
        </h2>

        <p class="mt-6 max-w-[36rem] text-base leading-relaxed text-text-secondary sm:text-lg">
          The route earns bit-perfect status only by preserving the file's exact bit depth and sample rate all the way to the DAC clock. The engine displays live verification while audio is streaming.
        </p>

        <div class="mt-10 border-t border-border-subtle">
          {
            proofs.map((proof) => (
              <article class="grid gap-3 border-b border-border-subtle py-5 sm:grid-cols-[10rem_1fr] sm:gap-6">
                <div>
                  <div class="flex items-center gap-2">
                    <span class="font-mono text-xs font-semibold text-gold">{proof.code}</span>
                    <span class="font-mono text-[0.625rem] tracking-wider text-text-tertiary uppercase">{proof.tag}</span>
                  </div>
                  <h3 class="mt-1 text-base font-semibold text-text-primary">{proof.title}</h3>
                </div>
                <p class="text-sm leading-relaxed text-text-secondary">{proof.body}</p>
              </article>
            ))
          }
        </div>
      </div>

      <div data-animate="slide-right">
        <SignalChain />
        <p class="mt-4 max-w-[54ch] font-mono text-xs leading-relaxed text-text-tertiary">
          Direct route shown at 24-bit / 192 kHz. The live telemetry reflects the exact stream parameters negotiated with your connected hardware DAC.
        </p>
      </div>
    </div>
  </Container>
</section>
