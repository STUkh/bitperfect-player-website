---
/**
 * Statement band, ivory. The first of the page's two full-bleed light bands.
 *
 * A 7/5 split: the claim on the left, three supporting facts on a hairline
 * stack to the right. No cards, no glass and no shadows in here: separation
 * is hairlines and space (DESIGN.md, "The Ivory Band Has No Shadows").
 *
 * No icons either. Each fact used to carry a Lucide default (a file, a
 * microphone, a shield-check) inside a tinted rounded square. An icon in a
 * soft-cornered tinted tile is the single most recognisable component of a
 * generated product page, and a shield does not mean "it stays on the phone",
 * it means a stock illustrator once drew a shield for "security".
 */
import Container from '../common/Container.astro';
import ImageSlot from '../common/ImageSlot.astro';

const facts = [
  {
    title: 'Your own files',
    desc: 'FLAC to DSD, read off your own storage.',
  },
  {
    title: 'Straight to your DAC',
    desc: 'Taken over exclusively. Nothing else touches the sound.',
  },
  {
    title: 'It stays on the phone',
    desc: 'No account, no analytics, no ads.',
  },
];
---

<section class="bg-band-ivory pt-14 pb-15 lg:pt-29 lg:pb-30">
  <Container class="lg:px-20">
    <div class="grid items-start gap-8 lg:grid-cols-12 lg:gap-16">
      {/* 8/4, not 7/5. At 7 columns this headline set five lines of 46px type in
          a 633px track while the fact list beside it ran out 120px early: one
          column too dense, the other stranded. Eight columns takes the headline to
          four lines and gives the facts a measure that wraps to two, so the pair
          finishes level. */}
      <div class="lg:col-span-8">
        <span
          class="r-fade block text-[11px] font-bold tracking-[2.5px] text-band-gold-ink uppercase lg:tracking-[3px]"
        >
          What it is
        </span>
        <h2
          class="r-rise text-headline-m mt-4 text-balance text-band-ink lg:mt-[22px] lg:text-headline"
          style="--i: 1"
        >
          Most phones quietly rewrite your music on the way out.
          <span class="text-band-gold-ink">This one leaves it alone.</span>
        </h2>
      </div>

      <div class="flex flex-col lg:col-span-4">
        {
          facts.map((fact, i) => (
            <div
              class:list={[
                'r-rise border-t border-band-rule py-5 lg:py-[26px]',
                i === facts.length - 1 && 'border-b border-band-rule',
              ]}
              style={`--i: ${i}`}
            >
              <div>
                <div class="text-base font-semibold tracking-[-0.01em] text-band-ink lg:text-[17px]">
                  {fact.title}
                </div>
                <p class="mt-1.5 text-sm leading-[1.6] text-pretty text-band-ink-muted lg:text-[15px]">
                  {fact.desc}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <ImageSlot
      name="home-statement"
      variant="ivory"
      ratio="3 / 1"
      ships="2560x853"
      class="r-rise mt-10 lg:mt-18"
    />
  </Container>
</section>
