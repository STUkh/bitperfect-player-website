---
/**
 * Pricing: Clear, honest patronage model.
 * Three billing periods with exact user-confirmed prices and
 * the free core player guarantee.
 */
import Container from '../common/Container.astro';
import SectionHeader from '../common/SectionHeader.astro';
import StoreBadges from '../common/StoreBadges.astro';
import Icon from '../Icon.astro';
import { pro } from '../../data/site';
---

<section id="pricing" class="section-py relative overflow-hidden">
  {/* Ambient warm glow */}
  <div
    class="pointer-events-none absolute top-1/3 left-1/2 -translate-x-1/2 h-[600px] w-[800px] rounded-full bg-gold/10 blur-[140px]"
    aria-hidden="true"
  >
  </div>

  <Container class="relative z-10">
    <SectionHeader
      eyebrow="Pricing &amp; Patronage"
      eyebrowColor="text-gold"
      title="One simple subscription. Only for AI"
      subtitle="Pro unlocks the AI Enhancer, Sonic Scan, and Similar Tracks. Your membership directly supports independent development and future DSP engineering without ads or tracking."
    />

    <div class="mx-auto max-w-5xl space-y-8 mt-10 sm:mt-14">
      {/* Free Forever Guarantee Banner */}
      <div
        class="glass accent-glow rounded-2xl px-6 py-5 flex items-center gap-4 text-base leading-relaxed text-text-primary"
        style="--card-accent: var(--color-bitperfect)"
        data-animate="fade-up"
      >
        <div class="flex-center h-10 w-10 shrink-0 rounded-xl bg-bitperfect/10 text-bitperfect border border-bitperfect/30">
          <Icon name="sig-bitperfect" size={22} />
        </div>
        <p class="text-sm sm:text-base leading-relaxed text-text-secondary">
          <strong class="text-white font-semibold">Free player guarantee:</strong> {pro.freeForever}
        </p>
      </div>

      {/* 3 Billing Period Cards */}
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch" data-animate="fade-up">
        {
          pro.periods.map((p) => (
            <div
              class:list={[
                'glass accent-glow accent-glow-hover flex flex-col justify-between rounded-2xl p-6 sm:p-7 transition-all duration-300 hover:scale-[1.02] relative',
                p.best ? 'border-gold bg-gold/[0.04]' : 'hover:bg-white/[0.02]',
                p.borderHover,
              ]}
              style={`--card-accent: ${p.accent}`}
            >
              {p.best && (
                <div class="absolute -top-3.5 left-1/2 -translate-x-1/2">
                  <span class="badge border border-gold bg-surface-base px-3.5 py-1 text-xs font-bold tracking-wider text-gold uppercase shadow-lg">
                    Best Value
                  </span>
                </div>
              )}

              <div>
                <span class:list={['text-xs font-semibold uppercase tracking-wider', p.best ? 'text-gold' : 'text-text-tertiary']}>
                  {p.label}
                </span>
                <div class="mt-3 flex items-baseline gap-1">
                  <span class="text-3xl sm:text-4xl font-extrabold text-white">${p.price}</span>
                  <span class="text-sm text-text-tertiary">/ {p.per}</span>
                </div>
                <p class:list={['mt-1 text-xs sm:text-sm font-medium', p.best ? 'text-gold' : 'text-text-tertiary']}>
                  Equal to ${(p.price / p.months).toFixed(2)} / month
                </p>
              </div>

              <div class="mt-6 pt-4 border-t border-white/[0.06] text-xs text-text-secondary flex items-center justify-between">
                <span>Google Play billing</span>
                <span>Cancel anytime</span>
              </div>
            </div>
          ))
        }
      </div>

      {/* What Pro Unlocks Card */}
      <div class="glass accent-glow rounded-2xl p-6 sm:p-8" style="--card-accent: var(--color-gold)" data-animate="fade-up">
        <div class="flex items-center gap-2.5 mb-6 pb-4 border-b border-white/[0.08]">
          <Icon name="sparkle" size={20} class="text-gold" />
          <h3 class="text-base sm:text-lg font-bold uppercase tracking-wider text-white">What Pro Unlocks</h3>
        </div>

        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            pro.unlocks.map((u) => (
              <li class="flex items-start gap-3">
                <span class="flex-center mt-1 h-5 w-5 shrink-0 rounded-full bg-gold/10 text-gold">
                  <Icon name="bullet" size={12} />
                </span>
                <div>
                  <h4 class="font-bold text-base text-white">{u.name}</h4>
                  <p class="mt-1 text-sm leading-relaxed text-text-secondary">{u.desc}</p>
                  {u.name === 'AI Enhancer' && (
                    <p class="mt-2 text-xs text-text-tertiary">
                      Requires neural hardware:{' '}
                      <a
                        href="#compatibility"
                        class="text-gold underline underline-offset-2 hover:text-gold-light font-medium"
                      >
                        view compatibility tiers
                      </a>
                    </p>
                  )}
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Disclosures & Store Badges */}
      <div class="flex flex-col items-center gap-6 pt-2" data-animate="fade-up">
        <ul class="flex flex-wrap justify-center gap-x-4 gap-y-1.5 text-xs text-text-tertiary text-center">
          {
            pro.disclosures.map((d, i) => (
              <li class="flex items-center gap-2">
                {i > 0 && <span aria-hidden="true" class="opacity-40">·</span>}
                <span>{d}</span>
              </li>
            ))
          }
        </ul>

        <StoreBadges variant="dark" class="justify-center mx-auto" />
      </div>
    </div>
  </Container>
</section>
