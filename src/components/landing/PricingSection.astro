---
import Container from '../common/Container.astro';
import SectionHeader from '../common/SectionHeader.astro';
import StoreBadges from '../common/StoreBadges.astro';
import Icon from '../Icon.astro';
import { pro } from '../../data/site';
---

<section id="pricing" class="section-py relative scroll-mt-28">
  <Container>
    <div class="pt-24">
      <SectionHeader
        eyebrow="Pricing"
        eyebrowColor="text-gold"
        title="One annual subscription. The whole app."
        subtitle={`Eligible new customers can try Bitperfect Player free for ${pro.trialDays} days. Google Play confirms eligibility and shows the exact regional price before purchase.`}
      />
    </div>

    <div class="mx-auto max-w-5xl space-y-8">
      <div
        class="glass accent-glow rounded-2xl px-6 py-5 flex items-center gap-4 text-base leading-relaxed text-text-primary"
        style="--card-accent: var(--color-bitperfect)"
        data-animate="fade-up"
      >
        <Icon name="sig-bitperfect" size={20} class="text-bitperfect shrink-0" />
        <p class="text-sm text-center sm:text-base">{pro.accessRequirement}</p>
      </div>

      <div class="mx-auto grid max-w-md grid-cols-1 gap-6 items-stretch" data-animate="fade-up">
        {
          pro.periods.map((p) => (
            <div
              class:list={[
                'glass accent-glow accent-glow-hover flex flex-col justify-between rounded-2xl p-6 transition-all duration-300 hover:scale-[1.02] relative',
                p.best ? 'border-gold bg-gold/[0.04]' : 'hover:bg-white/[0.02]',
                p.borderHover,
              ]}
              style={`--card-accent: ${p.accent}`}
            >
              {p.best && (
                <div class="absolute -top-3.5 left-1/2 -translate-x-1/2">
                  <span class="badge border border-gold bg-black px-3 py-1 text-[10px] font-bold tracking-wider text-gold uppercase shadow-lg">
                    Best Value
                  </span>
                </div>
              )}

              <div>
                <span class:list={['text-xs font-semibold uppercase tracking-wider', p.best ? 'text-gold' : 'text-text-tertiary']}>
                  {p.label}
                </span>
                <div class="mt-3 flex items-baseline gap-1">
                  <span class="text-3xl font-extrabold text-white sm:text-4xl">${p.price}</span>
                  <span class="text-xs text-text-tertiary">/ {p.per}</span>
                </div>
                <p class:list={['mt-1 text-xs font-medium', p.best ? 'text-gold' : 'text-text-tertiary']}>
                  Equal to ${(p.price / p.months).toFixed(2)} / month
                </p>
              </div>

              <div class="mt-6 pt-4 border-t border-white/[0.06] text-xs text-text-secondary">
                Billed yearly via Google Play · Cancel anytime
              </div>
            </div>
          ))
        }
      </div>

      <div class="glass accent-glow rounded-2xl p-6 sm:p-8" style="--card-accent: var(--color-gold)" data-animate="fade-up">
        <div class="flex items-center gap-2 mb-6 pb-4 border-b border-white/[0.08]">
          <Icon name="sparkle" size={18} class="text-gold" />
          <h3 class="text-base font-bold uppercase tracking-wider text-white">Everything included</h3>
        </div>

        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            pro.unlocks.map((u) => (
              <li class="flex items-start gap-3">
                <Icon name="bullet" size={16} class="mt-1 shrink-0 text-gold" />
                <div>
                  <p class="font-bold text-sm text-white">{u.name}</p>
                  <p class="mt-1 text-xs leading-relaxed text-text-secondary">{u.desc}</p>
                  {u.name === 'AI Enhancer' && (
                    <p class="mt-1.5 text-[11px] text-text-tertiary">
                      Needs hardware NPU —{' '}
                      <a
                        href="#compatibility"
                        class="text-gold underline underline-offset-2 hover:text-gold-light"
                      >
                        see compatibility map
                      </a>
                    </p>
                  )}
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="flex flex-col items-center gap-6" data-animate="fade-up">
        <ul class="flex flex-wrap justify-center gap-x-3 gap-y-1 text-xs text-text-tertiary">
          {
            pro.disclosures.map((d, i) => (
              <li class="flex items-center gap-2">
                {i > 0 && <span aria-hidden="true" class="opacity-40">·</span>}
                {d}
              </li>
            ))
          }
        </ul>

        <StoreBadges variant="dark" class="justify-center mx-auto" />
      </div>
    </div>
  </Container>
</section>
