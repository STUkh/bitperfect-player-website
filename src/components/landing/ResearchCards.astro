---
/**
 * Privacy & Trust section.
 * Rebuilt using the warmer black/gold glass system and multicolored semantic accents.
 * Highlights four factual commitments and the verified zero-telemetry guarantee.
 */
import Container from '../common/Container.astro';
import Icon from '../Icon.astro';
import { withBase } from '../../utils/nav';

const facts = [
  {
    title: 'No account',
    body: 'No sign-in, no profile, no cloud sync. Nothing to create, nothing to lose.',
    pill: 'None',
    color: 'var(--color-bitperfect)',
    textClass: 'text-bitperfect',
    bgClass: 'bg-bitperfect/10',
    borderClass: 'border-bitperfect/40',
  },
  {
    title: 'No analytics',
    body: 'No usage tracking, no behavioural telemetry, no third party watching how you listen.',
    pill: 'Not present',
    color: 'var(--color-lossless)',
    textClass: 'text-lossless',
    bgClass: 'bg-lossless/10',
    borderClass: 'border-lossless/40',
  },
  {
    title: 'No advertising',
    body: 'No ad SDK, no ad network — nothing on the phone built to monetize your attention.',
    pill: 'Not present',
    color: 'var(--color-gold)',
    textClass: 'text-gold',
    bgClass: 'bg-gold/10',
    borderClass: 'border-gold/40',
  },
  {
    title: 'On-device AI',
    body: "The AI Enhancer and Sonic Scan analysis run on the phone's own processor. The models download once; nothing about your library goes back out.",
    pill: 'On device',
    color: 'var(--color-enhanced)',
    textClass: 'text-enhanced',
    bgClass: 'bg-enhanced/10',
    borderClass: 'border-enhanced/40',
  },
];

const never = [
  'Your listening history',
  'Your music library contents',
  'Your name, email, or account — there is no account',
  'Advertising or tracking identifiers',
  'Location',
  'Contacts',
];
---

<section id="privacy" class="section-py relative overflow-hidden">
  {/* Ambient warm glow */}
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute left-1/2 top-0 h-80 w-80 -translate-x-1/2 rounded-full bg-gold/10 opacity-60 blur-orb-xl sm:h-96 sm:w-96"
    >
    </div>
  </div>

  <Container class="relative z-10">
    <div class="mb-12 max-w-2xl lg:mb-16" data-animate="fade-up">
      <p class="mb-4 text-eyebrow text-gold">Privacy</p>
      <h2 class="heading-section">There is no server to send anything to</h2>
      <p class="mt-4 text-base text-text-secondary sm:text-lg">
        No analytics, no advertising SDK, no tracking identifier, no account.
        All that ever leaves the phone: crash reports and artwork lookups,
        each behind its own switch, and the one-time AI model download. Your
        library, your listening history, your audio — never.
      </p>
    </div>

    {/* 4 Semantic Privacy Cards */}
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
      {
        facts.map((f, i) => (
          <div
            class="glass accent-glow accent-glow-hover flex flex-col justify-between rounded-2xl p-6 sm:p-7 transition-all duration-300 hover:scale-[1.01]"
            style={`--card-accent: ${f.color}`}
            data-animate="fade-up"
          >
            <div>
              <div class={`mb-5 flex-center h-11 w-11 rounded-xl border ${f.borderClass} ${f.bgClass} ${f.textClass}`}>
                {i === 0 && (
                  <svg
                    viewBox="0 0 24 24"
                    width="20"
                    height="20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="8.25" r="3.25" />
                    <path d="M5.25 19.25c.9-3.6 3.6-5.5 6.75-5.5s5.85 1.9 6.75 5.5" />
                    <path d="M3 21 21 3" />
                  </svg>
                )}
                {i === 1 && (
                  <svg
                    viewBox="0 0 24 24"
                    width="20"
                    height="20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M4.75 19.25V13M12 19.25V8M19.25 19.25V4.75" />
                    <path d="M3 21 21 3" />
                  </svg>
                )}
                {i === 2 && (
                  <svg
                    viewBox="0 0 24 24"
                    width="20"
                    height="20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M3.75 9.5v5a1 1 0 0 0 1 1h1.5l7 4V4.5l-7 4H4.75a1 1 0 0 0-1 1Z" />
                    <path d="M17.5 9.25a4 4 0 0 1 0 5.5" />
                    <path d="M3 21 21 3" />
                  </svg>
                )}
                {i === 3 && <Icon name="sparkle" size={20} />}
              </div>

              <h3 class="mb-2 text-lg font-bold text-white sm:text-xl">{f.title}</h3>
              <p class="text-sm leading-relaxed text-text-secondary sm:text-base">{f.body}</p>
            </div>

            <div class="mt-6 pt-4 border-t border-border-subtle">
              <span class={`inline-block rounded-full border ${f.borderClass} ${f.textClass} ${f.bgClass} px-3 py-1 text-xs font-semibold uppercase tracking-wider`}>
                {f.pill}
              </span>
            </div>
          </div>
        ))
      }
    </div>

    {/* Never leaves your phone section */}
    <div class="mt-12 sm:mt-16 glass rounded-2xl p-6 sm:p-10 border border-border-subtle" data-animate="fade-up">
      <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center lg:gap-16">
        <div>
          <h4 class="text-base sm:text-lg font-bold text-white mb-4">What never leaves your device:</h4>
          <ul class="grid gap-3 sm:grid-cols-2">
            {
              never.map((n) => (
                <li class="flex items-center gap-3 text-sm sm:text-base text-text-secondary">
                  <Icon name="bullet" size={14} class="text-gold shrink-0" />
                  <span>{n}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <a
          href={withBase('privacy')}
          class="privacy-link inline-flex items-center gap-2 text-sm sm:text-base font-semibold whitespace-nowrap text-gold hover:text-gold-light"
        >
          <span>Read the full privacy policy</span>
          <Icon name="arrow" size={16} />
        </a>
      </div>
    </div>
  </Container>
</section>

<style>
  .privacy-link {
    width: fit-content;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: border-color 0.2s var(--ease-out-expo);
  }
  .privacy-link:hover {
    border-bottom-color: var(--color-gold);
  }
  .privacy-link :global(.icon) {
    transition: transform 0.24s var(--ease-out-expo);
  }
  .privacy-link:hover :global(.icon) {
    transform: translateX(3px);
  }
</style>
