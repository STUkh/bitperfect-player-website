---
import Icon from '../Icon.astro';
import PhoneNowPlaying from '../PhoneNowPlaying.astro';
import { site, formats } from '../../data/site';

const stats = [
  { value: `${formats.length}`, label: 'Formats decoded', detail: 'FLAC to DSD128 and WavPack' },
  { value: '32', label: 'EQ bands', detail: 'Seven filter types' },
  { value: 'On-device', label: 'AI', detail: 'Enhancer, Sonic Scan and Similar Tracks' },
];
---

<section id="hero" class="relative overflow-hidden pt-24 pb-16 sm:pt-36 sm:pb-24 lg:pt-44 lg:pb-28">
  {/* Subtle ambient lighting — gold, cyan, and green glows */}
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute -top-24 left-1/2 h-[36rem] w-[36rem] -translate-x-1/2 rounded-full bg-gold/10 blur-[120px]">
    </div>
    <div class="absolute top-1/3 -left-24 h-72 w-72 rounded-full bg-lossless/10 blur-[100px]"></div>
    <div class="absolute -right-16 bottom-0 h-64 w-64 rounded-full bg-bitperfect/10 blur-[100px]"></div>
  </div>

  <div class="relative mx-auto w-full max-w-7xl px-5 sm:px-8">
    <div class="grid items-center gap-10 sm:gap-14 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
      {/* Content Column */}
      <div class="text-center lg:text-left" data-animate="slide-left">
        <p
          class="badge max-w-full mx-auto mb-5 sm:mb-6 gap-2 border border-border-subtle bg-glass-surface px-4 py-1.5 text-eyebrow text-gold lg:mx-0 whitespace-normal sm:whitespace-nowrap text-center shadow-sm"
        >
          <span class="inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-gold shadow-[0_0_8px_var(--color-gold)]" aria-hidden="true"></span>
          <span>Bit-perfect playback for Android</span>
        </p>

        <h1
          class="text-balance text-[2.625rem] sm:text-6xl lg:text-7xl leading-[1.06] font-extrabold tracking-tight text-text-primary"
        >
          Pure sound.
          <span class="text-gold">In its original light.</span>
        </h1>

        <p class="mx-auto mt-4 sm:mt-6 max-w-[48ch] text-pretty text-base sm:text-lg leading-relaxed text-text-secondary lg:mx-0">
          Bitperfect Player bypasses the Android system mixer and delivers every sample directly to your
          external USB DAC. Uncompressed, unmodified, bit for bit.
        </p>

        {/* CTA Row — Visible in first mobile viewport */}
        <div class="mt-6 sm:mt-8 flex flex-col sm:flex-row flex-wrap justify-center gap-3.5 sm:gap-4 lg:justify-start">
          <a
            href={site.playUrl}
            rel="noopener noreferrer"
            class="btn-primary-gradient focus-visible:focus-ring inline-flex items-center justify-center gap-2.5 rounded-full px-7 py-3.5 text-base font-semibold text-on-gold"
          >
            <Icon name="play" size={16} />
            <span>Get it on Google Play</span>
          </a>
          <a
            href="#engine"
            class="btn-secondary-glow glass glass-hover focus-visible:focus-ring inline-flex items-center justify-center gap-2 rounded-full border border-border-subtle px-6 py-3.5 text-sm font-medium text-text-secondary transition-colors duration-200 hover:text-text-primary"
          >
            <span>Explore signal route</span>
            <Icon name="arrow" size={15} />
          </a>
        </div>

        {/* Trust Badges */}
        <ul class="mt-7 sm:mt-8 flex flex-wrap justify-center gap-2 sm:gap-2.5 lg:justify-start" role="list">
          <li
            class="badge gap-1.5 border border-border-subtle bg-white/[0.02] px-3 py-1.5 text-xs font-semibold tracking-wide text-text-secondary"
          >
            <Icon name="android" size={14} class="text-text-tertiary" />
            <span>Android 8.0+</span>
          </li>
          <li
            class="badge gap-1.5 border border-border-subtle bg-white/[0.02] px-3 py-1.5 text-xs font-semibold tracking-wide text-text-secondary"
          >
            <Icon name="node-usb" size={14} class="text-text-tertiary" />
            <span>Exclusive USB DAC</span>
          </li>
          <li
            class="badge gap-1.5 border border-border-subtle bg-white/[0.02] px-3 py-1.5 text-xs font-semibold tracking-wide text-text-secondary"
          >
            <Icon name="shield" size={14} class="text-text-tertiary" />
            <span>No resampling</span>
          </li>
          <li
            class="badge gap-1.5 border border-border-subtle bg-white/[0.02] px-3 py-1.5 text-xs font-semibold tracking-wide text-text-secondary"
          >
            <Icon name="sparkle" size={14} class="text-text-tertiary" />
            <span>On-device AI</span>
          </li>
        </ul>
      </div>

      {/* Phone Mockup Column */}
      <div class="relative flex justify-center" data-animate="slide-right">
        <div class="pointer-events-none absolute inset-0 flex items-center justify-center" aria-hidden="true">
          <div
            class="h-72 w-72 rounded-full bg-gold/15 blur-[90px] sm:h-80 sm:w-80 lg:h-96 lg:w-96"
          >
          </div>
        </div>
        <div class="relative w-full max-w-[320px]">
          <PhoneNowPlaying />
        </div>
      </div>
    </div>

    {/* Hero stat tiles — Factual specs */}
    <div
      class="glass glass-elevated relative mt-14 sm:mt-20 rounded-2xl px-4 py-6 sm:px-10 sm:py-8"
      data-animate="fade-up"
    >
      <div class="grid grid-cols-1 divide-y divide-border-subtle sm:grid-cols-3 sm:divide-x sm:divide-y-0">
        {
          stats.map((s) => (
            <div class="flex flex-col items-center gap-1.5 py-4 text-center sm:px-6 sm:py-0">
              <span class="text-3xl sm:text-4xl font-bold tracking-tight text-text-primary">{s.value}</span>
              <span class="text-xs font-semibold uppercase tracking-wider text-gold">{s.label}</span>
              <span class="text-xs sm:text-sm text-text-tertiary">{s.detail}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
