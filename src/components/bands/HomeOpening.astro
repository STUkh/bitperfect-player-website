---
/*
  The site's entry to the React `HomeOpening`: it mounts the scroll-driven
  choreography, which the static render cannot carry (nothing hydrates).
  Claude Design renders `HomeOpening.tsx` directly, where `useBehaviour`
  mounts it.
*/
import HomeOpening from './HomeOpening.tsx';
---

<HomeOpening />

<script>
  import { setupHomeOpening } from './HomeOpening.client';

  document.querySelectorAll<HTMLElement>('[data-home-opening]').forEach((el) => setupHomeOpening(el));
</script>
