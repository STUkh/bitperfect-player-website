---
/*
  The site's entry to the React `LegalDocument`: it renders the shell around the
  page's markdown and mounts the index's behaviour, which the static render
  cannot carry (nothing hydrates). Claude Design renders `LegalDocument.tsx`
  directly, where `useBehaviour` mounts both behaviours.
*/
import LegalDocument, { type LegalDocumentProps } from './LegalDocument.tsx';

type Props = Omit<LegalDocumentProps, 'children'>;
---

<LegalDocument {...Astro.props}><slot /></LegalDocument>

{/*
  Collapse on phones, before first paint.

  `open` is a boolean attribute, so no media query can override it: it has to be
  removed. This runs inline, immediately after the element it touches has been
  parsed, so the panel is never painted expanded and then snapped shut. The
  listener keeps the two states honest across a rotation or a resize, and it
  cannot fight the user on desktop, where `.legal-toc-summary` is `pointer-events:
  none` and there is nothing to toggle.

  It is `setupTocDisclosure` from `LegalDocument.client.ts`, written out: an
  inline script cannot import it, and a module script runs too late. Keep the
  two in step.
*/}
<script is:inline>
  (() => {
    const details = document.currentScript.previousElementSibling?.querySelector?.('.legal-toc-details')
      ?? document.querySelector('.legal-toc-details');
    if (!details) return;
    const desktop = window.matchMedia('(min-width: 1024px)');
    const sync = () => {
      details.open = desktop.matches;
    };
    sync();
    desktop.addEventListener('change', sync);
  })();
</script>

<script>
  import { setupTocHighlighting } from './LegalDocument.client';

  function setupAll() {
    document.querySelectorAll<HTMLElement>('.legal-grid').forEach((root) => setupTocHighlighting(root));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAll);
  } else {
    setupAll();
  }
</script>
